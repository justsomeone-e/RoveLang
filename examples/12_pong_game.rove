#target cpp

import "std/terminal"

// =======================================================
// Rove Arcade: BALANCED FLICKER-FREE Pong Game
// Uses standard library `std/terminal` (Zero #native raw!)
// Controls: 'W' = Up, 'S' = Down, 'Q' = Quit
// First to 3 points wins!
// =======================================================

fn main() {
    clear_screen()
    set_cursor_visible(false)

    let width: int = 36
    let height: int = 14
    let paddle_height: int = 4

    var ball_x: int = 18
    var ball_y: int = 7
    var dx: int = -1
    var dy: int = 1

    var p1_y: int = 5
    var p2_y: int = 5

    var score_p1: int = 0
    var score_p2: int = 0
    let winning_score: int = 3

    var playing: bool = true
    var status_msg: string = "Match started! Defend your goal!"

    print("==========================================")
    print("      ROVE ARCADE PONG (SERVE TO YOU)      ")
    print("==========================================")
    print("Controls: 'W' = UP, 'S' = DOWN, 'Q' = QUIT")
    print("Starting match in 1 second...")
    delay_ms(1200)

    while playing {
        // 1. Instant non-blocking keyboard input via std/terminal
        if key_available() {
            let key: int = read_key()
            // 'w' or 'W'
            if (key == 119 or key == 87) and p1_y > 1 {
                p1_y = p1_y - 1
            }
            // 's' or 'S'
            elif (key == 115 or key == 83) and p1_y < height - paddle_height - 1 {
                p1_y = p1_y + 1
            }
            // 'q' or 'Q'
            elif key == 113 or key == 81 {
                playing = false
                status_msg = "Game exited by player."
            }
        }

        if playing {
            // 2. Move ball
            ball_x = ball_x + dx
            ball_y = ball_y + dy

            // Top / Bottom wall bounce
            if ball_y <= 1 {
                ball_y = 1
                dy = 1
            }
            if ball_y >= height - 2 {
                ball_y = height - 2
                dy = -1
            }

            // 3. CPU AI (Moves when ball enters its half)
            if dx > 0 and ball_x > 14 {
                let cpu_center: int = p2_y + 1
                if ball_y > cpu_center and p2_y < height - paddle_height - 1 {
                    p2_y = p2_y + 1
                } elif ball_y < cpu_center and p2_y > 1 {
                    p2_y = p2_y - 1
                }
            }

            // 4. SOLID PADDLE COLLISIONS (No passing through!)
            // Player paddle is at x = 2
            if ball_x <= 3 and dx < 0 and ball_y >= p1_y and ball_y <= p1_y + paddle_height - 1 {
                ball_x = 3
                dx = 1
                status_msg = "GREAT SAVE! Ball returned!"
            }

            // CPU paddle is at x = width - 3
            if ball_x >= width - 4 and dx > 0 and ball_y >= p2_y and ball_y <= p2_y + paddle_height - 1 {
                ball_x = width - 4
                dx = -1
                status_msg = "CPU returned your shot!"
            }

            // 5. Goal Detection
            if ball_x <= 1 {
                score_p2 = score_p2 + 1
                status_msg = "CPU SCORED! Ready for serve..."
                ball_x = 18
                ball_y = 7
                dx = -1
                p1_y = 5
                p2_y = 5
                delay_ms(700)
            }
            if ball_x >= width - 2 {
                score_p1 = score_p1 + 1
                status_msg = "YOU SCORED A GOAL! Awesome!"
                ball_x = 18
                ball_y = 7
                dx = 1
                p1_y = 5
                p2_y = 5
                delay_ms(700)
            }

            // 6. Check Match Winner
            if score_p1 >= winning_score {
                status_msg = "VICTORY! You defeated the CPU!"
                playing = false
            } elif score_p2 >= winning_score {
                status_msg = "DEFEAT! CPU won the match!"
                playing = false
            }

            // 7. IN-PLACE BUFFER DRAW via std/terminal
            cursor_reset()

            print("==========================================")
            print("        ROVE RETRO ARCADE PONG (LIVE)      ")
            print("==========================================")
            print("Score: [YOU] " + to_string(score_p1) + "   vs   " + to_string(score_p2) + " [CPU]  | W/S to move")
            print("+----------------------------------+")

            for y in 1..height-2 {
                var row: string = "|"
                for x in 1..width-2 {
                    if x == ball_x and y == ball_y {
                        row = row + "O"
                    } elif x == 2 and (y >= p1_y and y <= p1_y + paddle_height - 1) {
                        row = row + "["
                    } elif x == width - 3 and (y >= p2_y and y <= p2_y + paddle_height - 1) {
                        row = row + "]"
                    } elif x == 18 {
                        row = row + ":"
                    } else {
                        row = row + " "
                    }
                }
                row = row + "|"
                print(row)
            }

            print("+----------------------------------+")
            print("Status: " + status_msg + "                           ")

            // Perfect, playable arcade pace (70ms)
            delay_ms(70)
        }
    }

    set_cursor_visible(true)
    print("")
    print("==========================================")
    print("MATCH FINISHED: " + status_msg)
    print("==========================================")
}
