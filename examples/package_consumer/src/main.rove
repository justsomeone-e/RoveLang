// Package & Foreign Binding Consumer Example
// Demonstrates consuming both a local Rove package and native C++ filesystem bindings.

import "../packages/stats_core/src/stats.rove";
import cpp "std::filesystem" from "<filesystem>" as fs;

fn main() {
    print("=== Rove Package & Binding Consumer ===");
    
    // 1. Consume functions from stats_core package dependency
    var raw_readings = [15, -10, 85, 140, 42, 99];
    var normalized: Array<int> = [];
    for r in raw_readings {
        normalized.push(clamp(r, 0, 100));
    }
    
    var total_energy = sum_ints(normalized);
    var peak_energy = 0;
    for n in normalized {
        peak_energy = max_int(peak_energy, n);
    }
    
    print("Normalized Readings Total:", total_energy);
    print("Peak Reading Recorded:    ", peak_energy);
    
    // 2. Consume foreign C++ std::filesystem binding
    let current_dir = fs.current_path();
    let dir_name = current_dir.string();
    print("Active Working Directory: ", dir_name.len() > 0);
    print("Directory Exists On Disk: ", fs.exists(dir_name));
    
    print("[SUCCESS] Package and foreign binding consumer executed cleanly!");
}
