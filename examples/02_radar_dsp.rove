#target cpp

var base_freq: int = 5000
var target_signal: string = "Channel-A High Gain"

fn amplify(freq: int) -> int = freq * 2

print("Signal Target:", target_signal)
print("Base Frequency:", base_freq, "Hz")

// Forward pipeline transformation
let amplified = base_freq |> amplify
print("Amplified Frequency:", amplified, "Hz")
