#target cpp

struct Job {
    id: int,
    name: string,
    workload: int
}

async fn execute_job(job: Job) -> int {
    guard job.workload > 0 else {
        throw "Job workload must be positive"
    }

    defer print($"  -> [Worker] Finished task: {job.name} (ID: {job.id})")

    // Pipeline transformation: workload |> calculate
    return job.workload |> compute_metric
}

fn compute_metric(units: int) -> int = units * 10

async fn main() {
    print("=== Rove Concurrent Task Pipeline ===")
    defer print("=== All concurrent operations completed cleanly ===")

    let job_a = Job(101, "Telemetry Ingestion", 5)
    let job_b = Job(102, "HIR Verification", 12)

    // Schedule non-blocking Task<T> handles
    let task_a: Task<int> = execute_job(job_a)
    let task_b: Task<int> = execute_job(job_b)

    // Await task resolution
    let score_a: int = await task_a
    let score_b: int = await task_b

    let total: int = score_a + score_b
    print($"Aggregated Metric Score: {total}")
}
