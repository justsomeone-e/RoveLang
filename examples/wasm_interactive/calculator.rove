// Rove WASM Interactive Calculator
// High-performance arithmetic and combinatorics engine compiled directly to WebAssembly.
#target wasm

fn add(a: int, b: int) -> int {
    return a + b;
}

fn subtract(a: int, b: int) -> int {
    return a - b;
}

fn multiply(a: int, b: int) -> int {
    return a * b;
}

fn divide(a: int, b: int) -> int {
    if b == 0 {
        return 0;
    }
    return a / b;
}

fn power(base: int, exp: int) -> int {
    if exp <= 0 {
        return 1;
    }
    var res = 1;
    var i = 0;
    while i < exp {
        res = res * base;
        i = i + 1;
    }
    return res;
}

fn factorial(n: int) -> int {
    if n <= 1 {
        return 1;
    }
    var res = 1;
    var i = 2;
    while i <= n {
        res = res * i;
        i = i + 1;
    }
    return res;
}

fn describe_calc(engine_id: string) -> string {
    return "Rove WASM Engine v4.5 [" + engine_id + "]";
}
