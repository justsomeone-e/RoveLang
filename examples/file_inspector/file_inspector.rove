#target cpp
import "std/path"
import "std/process"
import "std/str"

fn inspect_file(file_path: string) -> int {
    print("=== Rove Native CLI: File & Path Inspector ===");
    print("Input path:", file_path);

    let base = basename(file_path);
    print("Basename:", base);

    let parent = dirname(file_path);
    print("Dirname:", parent);

    let ext = extname(file_path);
    print("Extension:", ext);

    let abs = is_absolute(file_path);
    print("Is absolute:", abs);

    let full = join("C:/projects", file_path);
    print("Joined path:", full);

    let clean = normalize(full);
    print("Normalized path:", clean);

    let upper_base = to_upper(base);
    print("Upper base:", upper_base);

    let is_rove = ends_with(file_path, ".rove");
    print("Is Rove source:", is_rove);

    let env_res = get_env("PATH");
    match env_res {
        Ok(value) => print("PATH length:", value.len()),
        Err(error) => print("PATH missing:", error)
    }

    let cmd_res = exec_cmd("echo CLI Subprocess OK");
    match cmd_res {
        Ok(code) => print("Exec command exit code:", code),
        Err(error) => print("Exec command error:", error)
    }

    return 0;
}

fn main() {
    let arguments = args();
    var target_file = "src/main.rove";
    if arguments.len() > 1 {
        set target_file = arguments[1];
    }
    let code = inspect_file(target_file);
    print("Inspector exited with code:", code);
}
