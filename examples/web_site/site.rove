// --- High-Performance Algorithmic Calculations in WASM ---

fn calc_fibonacci(n: int) -> int {
    if n <= 0 { return 0 }
    if n == 1 { return 1 }
    var a: int = 0
    var b: int = 1
    for i in 2..n {
        let next: int = a + b
        set a = b
        set b = next
    }
    return b
}

fn is_prime(n: int) -> bool {
    if n <= 1 { return false }
    if n <= 3 { return true }
    if n % 2 == 0 or n % 3 == 0 { return false }
    var i: int = 5
    while i * i <= n {
        if n % i == 0 or n % (i + 2) == 0 {
            return false
        }
        set i = i + 6
    }
    return true
}

fn count_primes(limit: int) -> int {
    var count: int = 0
    for n in 2..limit {
        if is_prime(n) {
            set count = count + 1
        }
    }
    return count
}

fn collatz_steps(n: int) -> int {
    if n <= 0 { return 0 }
    var current: int = n
    var steps: int = 0
    while current > 1 and steps < 100000 {
        if current % 2 == 0 {
            set current = current / 2
        } else {
            set current = current * 3 + 1
        }
        set steps = steps + 1
    }
    return steps
}

fn fast_gcd(a: int, b: int) -> int {
    var x: int = a
    var y: int = b
    while y != 0 {
        let temp: int = y
        set y = x % y
        set x = temp
    }
    return x
}

fn sum_array(values: Array<int>) -> int {
    var total: int = 0
    for val in values {
        set total = total + val
    }
    return total
}

