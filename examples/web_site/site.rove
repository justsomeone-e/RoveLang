// --- Cyber Space Dodge 2.0 Game Controls & Accessors (Mode 4) ---

fn dodge_move(delta: float) -> float {
    if dodge_game_over == 1 { return dodge_player_y }
    set dodge_player_y = dodge_player_y + delta
    if dodge_player_y < 12.0 { set dodge_player_y = 12.0 }
    if dodge_player_y > 268.0 { set dodge_player_y = 268.0 }
    return dodge_player_y
}

fn dodge_set_y(y: float) -> float {
    if dodge_game_over == 1 { return dodge_player_y }
    set dodge_player_y = y - 12.0
    if dodge_player_y < 12.0 { set dodge_player_y = 12.0 }
    if dodge_player_y > 268.0 { set dodge_player_y = 268.0 }
    return dodge_player_y
}

