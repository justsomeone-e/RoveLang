    set obs2_y = 25.0 + next_rand(180) * 1.0
    set obs3_x = 1240.0
    set obs3_y = 25.0 + next_rand(180) * 1.0
    set orb_x = 850.0
    set orb_y = 40.0 + next_rand(200) * 1.0
    set orb_active = 1
}

