// --- Pseudo-Random Generator ---

fn next_rand(max_val: int) -> int {
    set rng_state = (rng_state * 1103515245 + 12345) % 2147483647
    if rng_state < 0 {
        set rng_state = -rng_state
    }
    return if max_val > 0 { rng_state % max_val } else { 0 }
}

// --- Fast High-Accuracy Trigonometric Approximation (Bhaskara I) ---

fn fast_sin_deg(deg_in: int) -> float {
    var deg: int = deg_in % 360
    if deg < 0 { set deg = deg + 360 }
    if deg < 180 {
        let d: float = deg * 1.0
        let num: float = 4.0 * d * (180.0 - d)
        let den: float = 40500.0 - d * (180.0 - d)
        return num / den
    } else {
        let d: float = (deg - 180) * 1.0
        let num: float = 4.0 * d * (180.0 - d)
        let den: float = 40500.0 - d * (180.0 - d)
        return -(num / den)
    }
}

fn fast_cos_deg(deg_in: int) -> float {
    return fast_sin_deg(deg_in + 90)
}

// --- Sound Effects Event Bridge ---

fn get_and_clear_sfx() -> int {
    let current: int = sfx_event
    set sfx_event = 0
    return current
}

fn trigger_firework(x: float, y: float) -> void {
    trigger_firework_type(x, y, next_rand(4))
}

fn trigger_firework_type(x: float, y: float, f_type: int) -> void {
    if fw1_active == 0 {
        set fw1_active = 1
        set fw1_x = x
        set fw1_y = y
        set fw1_timer = 26
        set fw1_type = f_type % 4
    } else if fw2_active == 0 {
        set fw2_active = 1
        set fw2_x = x
        set fw2_y = y
        set fw2_timer = 26
        set fw2_type = f_type % 4
    } else if fw3_active == 0 {
        set fw3_active = 1
        set fw3_x = x
        set fw3_y = y
        set fw3_timer = 26
        set fw3_type = f_type % 4
    } else {
        set fw1_active = 1
        set fw1_x = x
        set fw1_y = y
        set fw1_timer = 26
        set fw1_type = f_type % 4
    }
    set sfx_event = 5
}

fn toggle_auto_fireworks() -> int {
    set fw_auto_show = 1 - fw_auto_show
    return fw_auto_show
}

fn is_auto_fireworks() -> int {
    return fw_auto_show
}

// --- Counter & State Management ---

fn get_counter() -> int {
    return counter
}

fn get_click_count() -> int {
    return click_count
}

fn inc_counter() -> int {
    set counter = counter + 1
    set click_count = click_count + 1
    return counter
}

fn dec_counter() -> int {
    set counter = counter - 1
    set click_count = click_count + 1
    return counter
}

fn double_counter() -> int {
    set counter = counter * 2
    set click_count = click_count + 1
    return counter
}

fn reset_counter() -> int {
    set counter = 0
    set click_count = click_count + 1
    return counter
}

fn get_anim_mode() -> int {
    return anim_mode
}

fn set_anim_mode(mode: int) -> int {
    set anim_mode = mode % 9
    return anim_mode
}

fn cycle_anim_mode() -> int {
    set anim_mode = (anim_mode + 1) % 9
    return anim_mode
}

fn toggle_anim() -> int {
    if is_running == 1 {
        set is_running = 0
    } else {
        set is_running = 1
        web_request_animation_frame(100)
    }
    return is_running
}

fn is_anim_running() -> int {
    return is_running
}

fn get_tick() -> int {
    return tick
}

// --- Procedural Chiptune & Synthwave Synthesizer in WASM (5 Tracks) ---

fn music_lead_note(track: int, step: int) -> float {
    let s: int = step % 16
    if track == 0 {
        // Track 0: Cyberpunk Synthwave (A minor driving groove)
        if s == 0 or s == 8 { return 440.0 }       // A4
        if s == 1 or s == 9 { return 523.25 }      // C5
        if s == 2 or s == 10 { return 659.25 }     // E5
        if s == 3 or s == 7 { return 783.99 }      // G5
        if s == 4 or s == 12 { return 880.0 }      // A5
        if s == 5 or s == 13 { return 659.25 }     // E5
        if s == 6 or s == 14 { return 587.33 }     // D5
        return 523.25                              // C5
    } else if track == 1 {
        // Track 1: 8-Bit Retro Arcade (Upbeat Chip)
        if s == 0 or s == 4 { return 523.25 }      // C5
        if s == 1 or s == 5 { return 587.33 }      // D5
        if s == 2 or s == 6 { return 659.25 }      // E5
        if s == 3 or s == 7 { return 783.99 }      // G5
        if s == 8 or s == 12 { return 1046.5 }     // C6
        if s == 9 or s == 13 { return 880.0 }      // A5
        if s == 10 or s == 14 { return 783.99 }    // G5
        return 659.25                              // E5
    } else if track == 2 {
        // Track 2: Neon Chillwave (Melodic progression)
        let bar: int = (step / 8) % 4
        if bar == 0 {
            if s % 2 == 0 { return 349.23 } else { return 523.25 } // F4, C5
        } else if bar == 1 {
            if s % 2 == 0 { return 392.00 } else { return 587.33 } // G4, D5
        } else if bar == 2 {
            if s % 2 == 0 { return 440.00 } else { return 659.25 } // A4, E5
        } else {
            if s % 2 == 0 { return 329.63 } else { return 493.88 } // E4, B4
        }
    } else if track == 3 {
        // Track 3: Tokyo Neon Drift (144 BPM Pentatonic Hook)
        if s == 0 or s == 4 { return 587.33 }       // D5
        if s == 1 or s == 5 { return 659.25 }       // E5
        if s == 2 or s == 8 { return 783.99 }       // G5
        if s == 3 or s == 9 { return 880.00 }       // A5
        if s == 6 or s == 12 { return 1174.66 }     // D6
        if s == 7 or s == 13 { return 1046.50 }     // C6
        if s == 10 or s == 14 { return 880.00 }     // A5
        return 659.25                               // E5
    } else {
        // Track 4: Arcade Boss Battle (152 BPM Aggressive Minor Theme)
        if s == 0 or s == 2 { return 440.00 }       // A4
        if s == 1 or s == 3 { return 466.16 }       // Bb4
        if s == 4 or s == 6 { return 523.25 }       // C5
        if s == 5 or s == 7 { return 587.33 }       // D5
        if s == 8 or s == 10 { return 698.46 }      // F5
        if s == 9 or s == 11 { return 659.25 }      // E5
        if s == 12 or s == 14 { return 880.00 }     // A5
        return 783.99                               // G5
    }
    return 440.0
}

fn music_bass_note(track: int, step: int) -> float {
    let bar: int = (step / 8) % 4
    if track == 0 {
        if bar == 0 { return 110.0 }  // A2
        if bar == 1 { return 130.81 } // C3
        if bar == 2 { return 98.0 }   // G2
        return 87.31                  // F2
    } else if track == 1 {
        if bar == 0 { return 130.81 } // C3
        if bar == 1 { return 146.83 } // D3
        if bar == 2 { return 164.81 } // E3
        return 196.00                 // G3
    } else if track == 2 {
        if bar == 0 { return 87.31 }  // F2
        if bar == 1 { return 98.00 }  // G2
        if bar == 2 { return 110.00 } // A2
        return 82.41                  // E2
    } else if track == 3 {
        if bar == 0 { return 146.83 } // D3
        if bar == 1 { return 174.61 } // F3
        if bar == 2 { return 196.00 } // G3
        return 110.00                 // A2
    } else {
        if bar == 0 { return 110.00 } // A2
        if bar == 1 { return 116.54 } // Bb2
        if bar == 2 { return 130.81 } // C3
        return 146.83                 // D3
    }
}

fn music_drum_beat(step: int) -> int {
    let s: int = step % 8
    if s == 0 or s == 4 { return 1 } // Kick
    if s == 2 or s == 6 { return 2 } // Snare
    if s % 2 == 1 { return 3 }       // Hi-Hat
    return 0
}

fn set_music_beat_pulse(pulse: float) -> void {
    set music_beat_pulse = pulse
}

fn piano_note_freq(note_idx: int) -> float {
    if note_idx == 0 { return 261.63 } // C4 (Do)
    if note_idx == 1 { return 293.66 } // D4 (Re)
    if note_idx == 2 { return 329.63 } // E4 (Mi)
    if note_idx == 3 { return 349.23 } // F4 (Fa)
    if note_idx == 4 { return 392.00 } // G4 (Sol)
    if note_idx == 5 { return 440.00 } // A4 (La)
    if note_idx == 6 { return 493.88 } // B4 (Si)
    return 523.25                      // C5 (Do)
}

fn track_name(track: int) -> string {
    return if track == 0 {
        "Cyberpunk Synthwave (128 BPM)"
    } else if track == 1 {
        "8-Bit Retro Arcade (140 BPM)"
    } else if track == 2 {
        "Neon Chillwave (110 BPM)"
    } else if track == 3 {
        "Tokyo Neon Drift (144 BPM)"
    } else {
        "Arcade Boss Battle (152 BPM)"
    }
}

// --- Pong 2.0 Game Control & Accessors (Mode 3) ---

fn pong_move_paddle(delta: float) -> float {
    set pong_paddle_y = pong_paddle_y + delta
    if pong_paddle_y < 6.0 {
        set pong_paddle_y = 6.0
    }
    if pong_paddle_y > 294.0 - pong_paddle_h {
        set pong_paddle_y = 294.0 - pong_paddle_h
    }
    return pong_paddle_y
}

fn pong_set_paddle_y(y: float) -> float {
    set pong_paddle_y = y - pong_paddle_h / 2.0
    if pong_paddle_y < 6.0 {
        set pong_paddle_y = 6.0
    }
    if pong_paddle_y > 294.0 - pong_paddle_h {
        set pong_paddle_y = 294.0 - pong_paddle_h
    }
    return pong_paddle_y
}

fn pong_move_p2(delta: float) -> float {
    set pong_cpu_y = pong_cpu_y + delta
    if pong_cpu_y < 6.0 {
        set pong_cpu_y = 6.0
    }
    if pong_cpu_y > 294.0 - pong_paddle_h {
        set pong_cpu_y = 294.0 - pong_paddle_h
    }
    return pong_cpu_y
}

fn pong_set_p2_y(y: float) -> float {
    set pong_cpu_y = y - pong_paddle_h / 2.0
    if pong_cpu_y < 6.0 {
        set pong_cpu_y = 6.0
    }
    if pong_cpu_y > 294.0 - pong_paddle_h {
        set pong_cpu_y = 294.0 - pong_paddle_h
    }
    return pong_cpu_y
}

