#target cpp
import "metrics.rove"

fn parse_sample(raw: string) -> Result<int, string> {
    if raw.len() == 0 or raw.len() > 7 { return Err("use integer milliseconds from 0 to 1000000") }
    if not is_number(raw) { return Err("sample is not a number") }
    let value = to_int(raw)
    if value < 0 or value > 1000000 or to_string(value) != raw {
        return Err("use integer milliseconds from 0 to 1000000 without leading zeros")
    }
    return Ok(value)
}

fn main() {
    let arguments = args()
    if arguments.len() < 2 {
        print("Usage: cli 42 95 380 (integer milliseconds; budget: 200 ms)")
        return
    }
    if arguments.len() > 10001 { print("Error: at most 10000 samples are allowed"); return }
    var samples: Array<float> = []
    for index in 1..arguments.len()-1 {
        let parsed = parse_sample(arguments[index])
        match parsed {
            Ok(value) => samples.push(value * 1.0),
            Err(error) => { print("Error:", arguments[index], error); return }
        }
    }
    print("samples:", sample_count(samples))
    print("average_ms:", average(samples))
    print("minimum_ms:", minimum(samples))
    print("maximum_ms:", maximum(samples))
    print("over_200_ms:", count_over(samples, 200.0))
}
