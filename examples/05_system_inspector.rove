#target cpp

import "std/system"

fn main() {
    print("=== Rove hecpp System Inspector ===")
    print("OS:", os_name())
    print("Architecture:", arch_name())
    print("Hostname:", host_name())
    print("User:", user_name())
    print("Home:", home_directory())
    print("Working directory:", working_directory())
    print("Logical CPU threads:", logical_cpu_threads())
    print("Physical memory (MiB):", total_memory_mb())
    input("Press Enter to close...")
}
