# GitHub Linguist map for the Rove toolchain
# Paths are relative to this file. Rove is not yet a built-in Linguist
# language, so .rove keeps C++ highlighting while remaining out of the C++
# language percentage.  The real implementation languages stay detectable.

# Rove source extension
*.rove linguist-detectable=true
*.rove linguist-vendored=false
repo/**/*.rove linguist-detectable=true
repo/**/*.rove linguist-vendored=false

# Compiler, tooling, and backend sources
*.py linguist-language=Python -linguist-vendored
*.cpp linguist-language=C++ -linguist-vendored
*.h linguist-language=C++ -linguist-vendored
*.js linguist-language=JavaScript -linguist-vendored
*.mjs linguist-language=JavaScript -linguist-vendored
*.tsx linguist-language=TypeScript -linguist-vendored
*.ts linguist-language=TypeScript -linguist-vendored
*.d.ts linguist-language=TypeScript -linguist-vendored
*.rs linguist-language=Rust -linguist-vendored
*.c linguist-language=C -linguist-vendored
*.wat linguist-language=WebAssembly linguist-generated
*.wasm linguist-language=WebAssembly binary linguist-generated
*.ld linguist-language=Linker-Script -linguist-vendored
*.s linguist-language=Assembly -linguist-vendored
*.S linguist-language=Assembly -linguist-vendored

# Configuration, data, and project manifests
*.json linguist-language=JSON linguist-detectable
*.toml linguist-language=TOML linguist-detectable
*.lock linguist-generated

# Native/embedded and platform scripts
*.sh linguist-language=Shell -linguist-vendored
*.ps1 linguist-language=PowerShell -linguist-vendored
*.bat linguist-language=Batchfile -linguist-vendored
*.yml linguist-language=YAML linguist-detectable
*.yaml linguist-language=YAML linguist-detectable
*.xml linguist-language=XML linguist-detectable

# Documentation and markup
*.md linguist-documentation
*.html linguist-language=HTML linguist-documentation
*.svg linguist-language=SVG linguist-documentation

# Generated artifacts and local toolchains
build/** linguist-generated
dist/** linguist-generated
target/** linguist-generated
.toolchains/** linguist-vendored
assets/** linguist-documentation
vscode-extension/images/** linguist-documentation
tests/docs/** linguist-generated linguist-documentation

# Authored source directories are explicitly not vendored.
src/** -linguist-vendored
compiler/** -linguist-vendored
tests/** -linguist-vendored
examples/** -linguist-vendored -linguist-documentation

# Enforce deterministic LF line endings for documentation assets and manifests
docs/generated/** text eol=lf
docs/examples/** text eol=lf
