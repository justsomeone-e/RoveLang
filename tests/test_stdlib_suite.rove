import "std/fs"
import "std/json"
import "std/http"
import "std/ai"

fn test_fs_module() {
    var ok = write_string("test_temp.txt", "Nyx File System Output").unwrap();
    guard ok else {
        print("Failed to write file");
        return;
    }
    print("[OK] std/fs write operation succeeded.");
}

fn test_http_module() {
    var resp = get("https://api.github.com/repos/justsomeone-e/nyx");
    guard resp.ok else {
        print("HTTP request failed");
        return;
    }
    print($"[OK] std/http status: {resp.status}");
}

fn test_ai_module() {
    var bot = client("deepseek", "deepseek-v4", "test_key");
    var res = ask(bot, "Optimize AST parser");
    print($"[OK] std/ai response: {res}");
}

fn main() {
    test_fs_module();
    test_http_module();
    test_ai_module();
}
