var wasm_counter: int = 0

fn next_counter() -> int {
    set wasm_counter = wasm_counter + 1
    return wasm_counter
}

fn add_numbers(a: int, b: int) -> int {
    return a + b;
}

fn is_positive(value: int) -> bool {
    return value > 0;
}

fn compute_power(base: int, exp: int) -> int {
    var res = 1;
    for i in 1..exp {
        res = res * base;
    }
    return res;
}

fn greet_developer(name: string) -> string {
    return $"Hello from Rove WebAssembly, {name}!";
}

fn sum_values(values: Array<int>) -> int {
    var total: int = 0
    for value in values {
        if value == 0 { continue }
        set total = total + value
    }
    return total
}

fn sum_float_values(values: Array<float>) -> float {
    var total: float = 0.0
    for value in values {
        set total = total + value
    }
    return total
}

fn array_length(values: Array<int>) -> int {
    return values.len()
}

fn int_at(values: Array<int>, index: int) -> int {
    return values[index]
}

fn float_at(values: Array<float>, index: int) -> float {
    return values[index]
}

fn set_int_at(values: Array<int>, index: int, val: int) -> void {
    set values[index] = val
}

fn set_float_at(values: Array<float>, index: int, val: float) -> void {
    set values[index] = val
}

fn char_matches(value: string, index: int, expected: string) -> bool {
    return value[index] == expected
}

fn char_slice(value: string, index: int) -> string {
    return value[index]
}

fn nested_at(values: Array<int>, indices: Array<int>) -> int {
    return values[indices[0]]
}

fn index_once(values: Array<int>) -> int {
    set wasm_counter = 0
    return values[next_counter() - 1] + wasm_counter
}

fn guarded_at(values: Array<int>, index: int) -> bool {
    return index >= 0 and index < values.len() and values[index] > 0
}

fn empty_or_positive(values: Array<int>) -> bool {
    return values.len() == 0 or values[0] > 0
}

fn string_length(value: string) -> int {
    return value.len()
}

fn choose_label(enabled: bool, name: string) -> string {
    return if enabled { "enabled: " + name } else { "disabled: " + name }
}

fn echo_inner(value: string) -> string {
    return value;
}

fn echo_via_call(value: string) -> string {
    return echo_inner(value);
}

fn literal_via_call() -> string {
    return echo_inner("internal UTF-8: İstanbul 🌙");
}

fn main() {
    print("Bundle source ready.");
}
