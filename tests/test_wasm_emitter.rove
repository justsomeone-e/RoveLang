struct WasmEmitter {
    bytes: Array<int>
}

impl WasmEmitter {
    fn emit_byte(self, b: int) {
        self.bytes = self.bytes + [b];
    }

    fn emit_magic_and_version(self) {
        self.emit_byte(0);
        self.emit_byte(97);
        self.emit_byte(115);
        self.emit_byte(109);
        self.emit_byte(1);
        self.emit_byte(0);
        self.emit_byte(0);
        self.emit_byte(0);
    }

    fn build(self) -> Array<int> {
        self.emit_magic_and_version();
        return self.bytes;
    }
}

fn main() {
    print("=== [NYX SELF-HOST WASM BYTE BUILDER TEST] ===");
    var init_bytes: Array<int> = [];
    var emitter = WasmEmitter(init_bytes);
    var bytes = emitter.build();
    print("Generated bytes count:", len(bytes));
    guard len(bytes) == 8 else {
        print("[FAIL] Expected 8 bytes header!");
        return;
    }
    print("[PASS] WASM binary header successfully produced from Nyx!");
}
main();