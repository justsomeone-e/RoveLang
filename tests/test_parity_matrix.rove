import "std/fs"
import "std/json_lite"
import "std/math"
import "std/time"
import "std/encoding"
import "std/hash"

fn main() {
    print("=== [NYX FULL MULTI-TARGET PARITY MATRIX TEST] ===");
    
    // 1. Math Functions
    var sq = sqrt(144.0);
    var pw = pow(2.0, 8);
    var sn = sin(0.0);
    var cl = clamp(50.0, 0.0, 100.0);
    print($"[MATH] sqrt(144)={sq} pow(2,8)={pw} sin(0)={sn} clamp(50)={cl}");
    guard sq == 12.0 and pw == 256.0 and sn == 0.0 and cl == 50.0 else {
        print("[FAIL] Math parity mismatch!");
        return;
    }

    // 2. Encoding (Base64)
    var msg = "Nyx Parity Verification 2026";
    var b64 = base64_encode(msg);
    var dec = base64_decode(b64).unwrap();
    print($"[ENCODING] Base64: {b64} -> Decoded: {dec}");
    guard msg == dec else {
        print("[FAIL] Base64 mismatch!");
        return;
    }

    // 3. RFC 9923 Canonical FNV-1a 64-bit Hex ASCII Vectors
    var h_empty = fnv1a_64_hex("");
    var h_a = fnv1a_64_hex("a");
    var h_foobar = fnv1a_64_hex("foobar");
    var h_msg = fnv1a_64_hex("Nyx Parity Verification 2026");
    
    guard h_empty == "cbf29ce484222325" else { print("[FAIL] FNV-1a empty vector mismatch!"); return; }
    guard h_a == "af63dc4c8601ec8c" else { print("[FAIL] FNV-1a 'a' vector mismatch!"); return; }
    guard h_foobar == "85944171f73967e8" else { print("[FAIL] FNV-1a 'foobar' vector mismatch!"); return; }
    guard h_msg == "0fc80ea1ce1cd7aa" else { print("[FAIL] FNV-1a 'msg' vector mismatch!"); return; }

    // 4. RFC 9923 UTF-8 Multi-Byte, Embedded NUL, and NFC/NFD Distinction Vectors
    var h_tr = fnv1a_64_hex("İstanbul 🌙 çığ ğüşö");
    var h_nul = fnv1a_64_hex("a\0b");
    var h_nfc = fnv1a_64_hex("é");
    var h_nfd = fnv1a_64_hex("e\u0301");

    print($"[HASH-UTF8] 'İstanbul 🌙 çığ ğüşö' -> {h_tr}");
    print($"[HASH-NUL]  'a\\0b'                -> {h_nul}");
    print($"[HASH-NFC]  'é'                   -> {h_nfc}");
    print($"[HASH-NFD]  'e\\u0301'             -> {h_nfd}");

    guard h_tr == "331b157d9d5c8685" else { print("[FAIL] UTF-8 multi-byte mismatch"); return; }
    guard h_nul == "e5d29919042666b2" else { print("[FAIL] Embedded NUL mismatch"); return; }
    guard h_nfc == "0ac21707b7181e01" else { print("[FAIL] NFC é mismatch"); return; }
    guard h_nfd == "c0c9d418ee802e1f" else { print("[FAIL] NFD e\\u0301 mismatch"); return; }
    guard h_nfc != h_nfd else { print("[FAIL] NFC and NFD should produce different hashes"); return; }

    // 5. Time
    var t0 = now_ms();
    sleep_ms(25).unwrap();
    var t1 = now_ms();
    var diff = t1 - t0;
    print($"[TIME] Elapsed: {diff}ms (Expected >= 20ms)");
    guard diff >= 20 else { print("[FAIL] Time elapsed below requested sleep!"); return; }

    // 6. JSON Lite
    var json_doc = "{\"name\":\"nyx_polyglot\",\"version\":3,\"build\":2026}";
    var j_name = get_string(json_doc, "name").unwrap();
    var j_ver = get_int(json_doc, "version").unwrap();
    print($"[JSON_LITE] Extracted name={j_name}, version={j_ver}");
    guard j_name == "nyx_polyglot" and j_ver == 3 else { print("[FAIL] JSON Lite mismatch!"); return; }

    // 7. Filesystem
    var temp_f = "parity_temp.txt";
    var w_ok = write_string(temp_f, "Parity Data Content").unwrap();
    var f_exists = exists(temp_f);
    var f_content = read_to_string(temp_f).unwrap();
    var r_ok = remove_file(temp_f).unwrap();
    print($"[FS] Write={w_ok}, Exists={f_exists}, Content='{f_content}', Remove={r_ok}");
    guard w_ok and f_exists and f_content == "Parity Data Content" and r_ok else {
        print("[FAIL] Filesystem parity mismatch!");
        return;
    }

    print("[SUCCESS] All 6 Stdlib Modules & UTF-8 / NUL / NFC-NFD Vectors Verified (cpp == js == python)!");
}
