{
  "name": "rove-language-support",
  "displayName": "Rove Language Toolchain",
  "description": "Native compiler tooling, IntelliSense, and one-click multi-target workflows for Rove.",
  "version": "5.0.3",
  "publisher": "rove",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/justsomeone-e/RoveLang.git"
  },
  "homepage": "https://github.com/justsomeone-e/RoveLang#readme",
  "bugs": {
    "url": "https://github.com/justsomeone-e/RoveLang/issues"
  },
  "galleryBanner": {
    "color": "#171A35",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "main": "./extension.js",
  "icon": "images/rove-icon.png",
  "scripts": {
    "test": "node test_contract.js",
    "package": "vsce package"
  },
  "activationEvents": [
    "onLanguage:rovelang",
    "onCommand:rove.runCurrentFile",
    "onCommand:rove.buildCurrentFile",
    "onCommand:rove.checkCurrentFile",
    "onCommand:rove.toolchainDoctor",
    "onCommand:rove.openRepository",
    "onCommand:rove.openDocumentation",
    "onCommand:rove.openReleases",
    "onCommand:rove.openRoadmap",
    "onCommand:rove.reportIssue"
  ],
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "rove",
    "compiler",
    "language",
    "systems programming",
    "webassembly",
    "intellisense"
  ],
  "contributes": {
    "configuration": {
      "title": "Rove",
      "properties": {
        "rove.server.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable diagnostics, hover, completion, and definition support from rove lsp."
        },
        "rove.server.path": {
          "type": "string",
          "default": "rove",
          "description": "Path to the Rove CLI used for the language server and commands. The default prefers ~/.rove/bin/rove before PATH."
        },
        "rove.run.target": {
          "type": "string",
          "enum": [
            "source",
            "cpp",
            "js",
            "python"
          ],
          "enumDescriptions": [
            "Use the #target directive in the active source file (cpp when omitted).",
            "Compile and run as a native C++20 executable.",
            "Run through the Node.js ES2022 backend.",
            "Run through the Python 3 backend."
          ],
          "default": "source",
          "description": "Target override used by the VS Code Run and Build commands."
        }
      }
    },
    "commands": [
      {
        "command": "rove.runCurrentFile",
        "title": "Rove: Run Current File",
        "icon": "$(play)"
      },
      {
        "command": "rove.buildCurrentFile",
        "title": "Rove: Build Current File",
        "icon": "$(tools)"
      },
      {
        "command": "rove.checkCurrentFile",
        "title": "Rove: Check Current File",
        "icon": "$(check)"
      },
      {
        "command": "rove.toolchainDoctor",
        "title": "Rove: Toolchain Doctor"
      },
      {
        "command": "rove.openRepository",
        "title": "Rove: Open GitHub Repository",
        "icon": "$(github-inverted)"
      },
      {
        "command": "rove.openDocumentation",
        "title": "Rove: Open Documentation",
        "icon": "$(book)"
      },
      {
        "command": "rove.openReleases",
        "title": "Rove: Open Releases",
        "icon": "$(versions)"
      },
      {
        "command": "rove.openRoadmap",
        "title": "Rove: Open Compiler Roadmap",
        "icon": "$(map)"
      },
      {
        "command": "rove.reportIssue",
        "title": "Rove: Report an Issue",
        "icon": "$(bug)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "rove.runCurrentFile",
          "when": "resourceLangId == rovelang",
          "group": "navigation@1"
        },
        {
          "command": "rove.buildCurrentFile",
          "when": "resourceLangId == rovelang",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "rove.runCurrentFile",
          "when": "resourceLangId == rovelang",
          "group": "navigation@1"
        },
        {
          "command": "rove.checkCurrentFile",
          "when": "resourceLangId == rovelang",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "rove.buildCurrentFile",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorTextFocus && resourceLangId == rovelang"
      },
      {
        "command": "rove.runCurrentFile",
        "key": "f5",
        "when": "editorTextFocus && resourceLangId == rovelang"
      }
    ],
    "languages": [
      {
        "id": "rovelang",
        "aliases": [
          "rove",
          "Rove",
          "rovelang"
        ],
        "extensions": [
          ".rove",
          ".nyx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/rove-file-icon.png",
          "dark": "./images/rove-file-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "rovelang",
        "scopeName": "source.rove",
        "path": "./syntaxes/rove.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rovelang",
        "path": "./snippets/rove.snippets.json"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "10.1.1"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2"
  }
}
