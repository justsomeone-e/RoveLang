{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "nyx",
  "scopeName": "source.nyx",
  "patterns": [
    {
      "name": "comment.line.double-slash.nyx",
      "match": "//.*$"
    },
    {
      "name": "meta.preprocessor.target.nyx",
      "match": "(#target)\\s+([a-zA-Z0-9_]+)",
      "captures": {
        "1": { "name": "keyword.control.directive.nyx" },
        "2": { "name": "entity.name.type.target.nyx" }
      }
    },
    {
      "name": "meta.preprocessor.native.include.nyx",
      "match": "(#native)\\s+(include)\\s+(<[^>]+>|\"[^\"]+\")",
      "captures": {
        "1": { "name": "keyword.control.directive.nyx" },
        "2": { "name": "keyword.other.directive.nyx" },
        "3": { "name": "string.quoted.other.header.nyx" }
      }
    },
    {
      "name": "meta.preprocessor.native.link.nyx",
      "match": "(#native)\\s+(link|use)\\s+(\"[^\"]+\")",
      "captures": {
        "1": { "name": "keyword.control.directive.nyx" },
        "2": { "name": "keyword.other.directive.nyx" },
        "3": { "name": "string.quoted.double.nyx" }
      }
    },
    {
      "name": "meta.preprocessor.native.cpp.block.nyx",
      "begin": "(#native)\\s+(raw|cpp)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.directive.nyx" },
        "2": { "name": "entity.name.type.target.nyx" },
        "3": { "name": "punctuation.section.block.begin.nyx" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.nyx" }
      },
      "patterns": [
        { "include": "source.cpp" }
      ]
    },
    {
      "name": "meta.preprocessor.native.js.block.nyx",
      "begin": "(#native)\\s+(js)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.directive.nyx" },
        "2": { "name": "entity.name.type.target.nyx" },
        "3": { "name": "punctuation.section.block.begin.nyx" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.nyx" }
      },
      "patterns": [
        { "include": "source.js" }
      ]
    },
    {
      "name": "meta.preprocessor.native.rust.block.nyx",
      "begin": "(#native)\\s+(rust)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.directive.nyx" },
        "2": { "name": "entity.name.type.target.nyx" },
        "3": { "name": "punctuation.section.block.begin.nyx" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.nyx" }
      },
      "patterns": [
        { "include": "source.rust" }
      ]
    },
    {
      "name": "meta.preprocessor.native.raw.nyx",
      "match": "(#native)\\s+(raw|cpp|js|rust)",
      "captures": {
        "1": { "name": "keyword.control.directive.nyx" },
        "2": { "name": "entity.name.type.target.nyx" }
      }
    },
    {
      "name": "keyword.declaration.nyx",
      "match": "\\b(var|let|set|const|type|struct|impl|trait|enum|fn|extern|async|test)\\b"
    },
    {
      "name": "keyword.control.nyx",
      "match": "\\b(if|else|elif|for|in|while|loop|match|return|throw|yield|continue|break|await|defer|guard|try|catch|unsafe|import|use|from|as|assert|spawn)\\b"
    },
    {
      "name": "keyword.operator.logical.nyx",
      "match": "\\b(and|or|not)\\b"
    },
    {
      "name": "storage.type.nyx",
      "match": "\\b(int|i8|i16|i32|i64|u8|u16|u32|u64|float|f32|f64|bool|string|char|uintptr|void|any|Array|Iterator|Option|Result|Channel|Task)\\b"
    },
    {
      "name": "support.function.builtin.nyx",
      "match": "\\b(print|println|input|len|length|addr|peek|memdump|delay_ms|contains|is_number|to_string|to_int|args|map|filter|fold|channel|Ok|Err|useState|useEffect|useRef|useMemo|useCallback)\\b"
    },
    {
      "name": "constant.language.boolean.nyx",
      "match": "\\b(true|false|null)\\b"
    },
    {
      "name": "string.quoted.other.angle.nyx",
      "match": "<[a-zA-Z0-9_\\./\\+]+>"
    },
    {
      "name": "string.interpolated.nyx",
      "begin": "\\$\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.nyx",
          "match": "\\\\."
        },
        {
          "name": "meta.interpolation.nyx",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    {
      "name": "string.quoted.double.nyx",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.nyx",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.nyx",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.nyx",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.nyx",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    {
      "name": "keyword.operator.nyx",
      "match": "(->|\\|>|\\.\\.|==|!=|>=|<=|>|<|\\+|-|\\*|/|=|&&|\\|\\||!|=>|\\?\\?|\\?\\.)"
    },
    {
      "name": "entity.name.function.nyx",
      "match": "fn\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "entity.name.function.nyx" }
      }
    },
    {
      "name": "entity.name.type.struct.nyx",
      "match": "(?:struct|impl|trait|enum)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "entity.name.type.struct.nyx" }
      }
    }
  ]
}
