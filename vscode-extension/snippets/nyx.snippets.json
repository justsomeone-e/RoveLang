{
  "Target Directive": {
    "prefix": "#target",
    "body": [
      "#target ${1|cpp,c,llvm,asm,react,js,rust,python,wasm|}"
    ],
    "description": "Specify compilation backend target"
  },
  "Native Include Directive": {
    "prefix": "#native include",
    "body": [
      "#native include <${1:windows.h}>"
    ],
    "description": "Include C/C++ native header"
  },
  "Native Raw Block": {
    "prefix": "#native raw",
    "body": [
      "#native raw {",
      "\t${0:// raw C++ code}",
      "}"
    ],
    "description": "Direct native C++ code injection"
  },
  "Native Link Directive": {
    "prefix": "#native link",
    "body": [
      "#native link \"${1:ws2_32}\""
    ],
    "description": "Link system static or dynamic library"
  },
  "Defer Statement": {
    "prefix": "defer",
    "body": [
      "defer ${1:cleanup_func()};"
    ],
    "description": "Executes cleanup action automatically upon scope exit (LIFO order)"
  },
  "Guard Statement": {
    "prefix": "guard",
    "body": [
      "guard ${1:condition} else {",
      "\t${0:return;}",
      "}"
    ],
    "description": "Early-exit safety guard block"
  },
  "Pipeline Operator": {
    "prefix": "|>",
    "body": [
      "|> ${1:func_name}"
    ],
    "description": "Pipes value forward as the first argument of the target function"
  },
  "String Interpolation": {
    "prefix": "$\"",
    "body": [
      "$\"${1:Hello} {${2:name}}\""
    ],
    "description": "Interpolated string expression"
  },
  "Function Definition": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}) -> ${3:type} {",
      "\t${4:// body}",
      "\treturn ${0:result};",
      "}"
    ],
    "description": "Strongly typed function definition"
  },
  "Expression-Bodied Function": {
    "prefix": "fn=",
    "body": [
      "fn ${1:name}(${2:params}) -> ${3:type} = ${0:expression}"
    ],
    "description": "Function whose expression is returned implicitly"
  },
  "Struct Definition": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:type}",
      "}"
    ],
    "description": "Custom data structure definition"
  },
  "Impl Block": {
    "prefix": "impl",
    "body": [
      "impl ${1:StructName} {",
      "\tfn ${2:method_name}(self${3:, params}) -> ${4:type} {",
      "\t\t${0:// body}",
      "\t}",
      "}"
    ],
    "description": "Struct method implementation block"
  },
  "Variable Declaration": {
    "prefix": "var",
    "body": [
      "var ${1:name} = ${2:value};"
    ],
    "description": "Mutable variable declaration"
  },
  "Constant Declaration": {
    "prefix": "const",
    "body": [
      "const ${1:NAME} = ${2:value};"
    ],
    "description": "Immutable constant declaration"
  },
  "If Statement": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t${0:// body}",
      "}"
    ],
    "description": "Conditional if branch"
  },
  "If Expression": {
    "prefix": "if=",
    "body": [
      "if ${1:condition} { ${2:value} } else { ${0:fallback} }"
    ],
    "description": "Exhaustive conditional value expression"
  },
  "For Range Loop": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:0}..${3:count}-1 {",
      "\t${0:// body}",
      "}"
    ],
    "description": "Contiguous range for loop"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t${0:// body}",
      "}"
    ],
    "description": "Conditional while loop"
  },
  "Pattern Matching Statement": {
    "prefix": "match",
    "body": [
      "match ${1:expr} {",
      "\t${2:pattern} => ${3:action},",
      "\t_ => ${0:fallback}",
      "}"
    ],
    "description": "Pattern-matching statement with binding arms"
  },
  "Value Match Expression": {
    "prefix": "match=",
    "body": [
      "match ${1:value} {",
      "\t${2:literal} => ${3:result},",
      "\t_ => ${0:fallback}",
      "}"
    ],
    "description": "Exhaustive literal match that produces a value"
  },
  "Print to Console": {
    "prefix": "print",
    "body": [
      "print(${1:expr});"
    ],
    "description": "Output expression to standard output"
  },
  "Unsafe Memory Block": {
    "prefix": "unsafe",
    "body": [
      "unsafe {",
      "\tvar ptr = addr(${1:variable});",
      "\tvar val = peek(ptr);",
      "\t${0}",
      "}"
    ],
    "description": "Hardware and raw pointer unsafe execution block"
  },
  "Unit Test Block": {
    "prefix": "test",
    "body": [
      "test \"${1:test title}\" {",
      "\tassert(${2:condition}, \"${3:failure message}\");",
      "}"
    ],
    "description": "In-file automated unit test block"
  },
  "Trait Definition": {
    "prefix": "trait",
    "body": [
      "trait ${1:Name} {",
      "\tfn ${2:method}(self${3:, params}) -> ${4:type}",
      "}"
    ],
    "description": "Trait interface definition"
  },
  "Trait Implementation": {
    "prefix": "impl for",
    "body": [
      "impl ${1:TraitName} for ${2:StructName} {",
      "\tfn ${3:method}(self${4:, params}) -> ${5:type} {",
      "\t\t${0:// body}",
      "\t}",
      "}"
    ],
    "description": "Trait implementation block"
  },
  "Async Function": {
    "prefix": "async fn",
    "body": [
      "async fn ${1:name}(${2:params}) -> ${3:type} {",
      "\t${0:// body}",
      "}"
    ],
    "description": "Asynchronous function returning a Task<T>"
  },
  "Enum Definition": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t${2:Variant1},",
      "\t${3:Variant2}",
      "}"
    ],
    "description": "Enumeration definition with variants"
  },
  "Type Alias": {
    "prefix": "type",
    "body": [
      "type ${1:Alias} = ${2:ExistingType};"
    ],
    "description": "Type alias definition"
  },
  "Result Ok": {
    "prefix": "ok",
    "body": [
      "return Ok(${1:value});"
    ],
    "description": "Return successful Result::Ok"
  },
  "Result Err": {
    "prefix": "err",
    "body": [
      "return Err(\"${1:error message}\");"
    ],
    "description": "Return error Result::Err"
  },
  "Array Map": {
    "prefix": "map",
    "body": [
      "map(${1:collection}, fn(x) = ${2:x})"
    ],
    "description": "Functional collection map transform"
  },
  "Array Filter": {
    "prefix": "filter",
    "body": [
      "filter(${1:collection}, fn(x) = ${2:x > 0})"
    ],
    "description": "Functional collection filter predicate"
  }
}
