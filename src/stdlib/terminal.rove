// nyx Standard Library: std/terminal
// Terminal, cursor control, screen clearing, and non-blocking keyboard input.
#target cpp

#native include <cstdint>
#native include <cstdlib>
#native include <iostream>

#native raw {
#if defined(_WIN32)
#include <windows.h>
#include <conio.h>
#else
#include <unistd.h>
#include <termios.h>
#include <sys/select.h>
#include <cstdio>
#endif

inline void _nyx_term_clear_screen() {
#if defined(_WIN32)
    system("cls");
#else
    std::cout << "\033[2J\033[H" << std::flush;
#endif
}

inline void _nyx_term_cursor_reset() {
#if defined(_WIN32)
    HANDLE hOut = GetStdHandle(STD_OUTPUT_HANDLE);
    COORD coord = {0, 0};
    SetConsoleCursorPosition(hOut, coord);
#else
    std::cout << "\033[H" << std::flush;
#endif
}

inline void _nyx_term_cursor_move(int64_t col, int64_t row) {
#if defined(_WIN32)
    HANDLE hOut = GetStdHandle(STD_OUTPUT_HANDLE);
    COORD coord = {static_cast<SHORT>(col), static_cast<SHORT>(row)};
    SetConsoleCursorPosition(hOut, coord);
#else
    std::cout << "\033[" << (row + 1) << ";" << (col + 1) << "H" << std::flush;
#endif
}

inline void _nyx_term_set_cursor_visible(bool visible) {
#if defined(_WIN32)
    HANDLE hOut = GetStdHandle(STD_OUTPUT_HANDLE);
    CONSOLE_CURSOR_INFO cursorInfo;
    if (GetConsoleCursorInfo(hOut, &cursorInfo)) {
        cursorInfo.bVisible = visible ? TRUE : FALSE;
        SetConsoleCursorInfo(hOut, &cursorInfo);
    }
#else
    if (visible) {
        std::cout << "\033[?25h" << std::flush;
    } else {
        std::cout << "\033[?25l" << std::flush;
    }
#endif
}

inline bool _nyx_term_key_available() {
#if defined(_WIN32)
    return _kbhit() != 0;
#else
    struct timeval tv = {0L, 0L};
    fd_set fds;
    FD_ZERO(&fds);
    FD_SET(STDIN_FILENO, &fds);
    return select(STDIN_FILENO + 1, &fds, NULL, NULL, &tv) > 0;
#endif
}

inline int64_t _nyx_term_read_key() {
#if defined(_WIN32)
    return static_cast<int64_t>(_getch());
#else
    struct termios oldt, newt;
    tcgetattr(STDIN_FILENO, &oldt);
    newt = oldt;
    newt.c_lflag &= ~(ICANON | ECHO);
    tcsetattr(STDIN_FILENO, TCSANOW, &newt);
    int ch = getchar();
    tcsetattr(STDIN_FILENO, TCSANOW, &oldt);
    return static_cast<int64_t>(ch);
#endif
}
}

extern "C++" fn _nyx_term_clear_screen() -> void
extern "C++" fn _nyx_term_cursor_reset() -> void
extern "C++" fn _nyx_term_cursor_move(col: int, row: int) -> void
extern "C++" fn _nyx_term_set_cursor_visible(visible: bool) -> void
extern "C++" fn _nyx_term_key_available() -> bool
extern "C++" fn _nyx_term_read_key() -> int

// Public standard library API:
fn clear_screen() {
    _nyx_term_clear_screen()
}

fn cursor_reset() {
    _nyx_term_cursor_reset()
}

fn cursor_move(col: int, row: int) {
    _nyx_term_cursor_move(col, row)
}

fn set_cursor_visible(visible: bool) {
    _nyx_term_set_cursor_visible(visible)
}

fn key_available() -> bool {
    return _nyx_term_key_available()
}

fn read_key() -> int {
    return _nyx_term_read_key()
}
