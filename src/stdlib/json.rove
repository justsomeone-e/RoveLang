// nyx Standard Library - std/json
// Full-Featured JSON Parser, Serializer, and Key-Value Extractor

#native include "string"
#native include "sstream"
#native include "cctype"

#native raw {
inline std::string _nyx_json_escape(const std::string& s) {
    std::stringstream ss;
    for (char c : s) {
        if (c == '"') ss << "\\\"";
        else if (c == '\\') ss << "\\\\";
        else if (c == '\b') ss << "\\b";
        else if (c == '\f') ss << "\\f";
        else if (c == '\n') ss << "\\n";
        else if (c == '\r') ss << "\\r";
        else if (c == '\t') ss << "\\t";
        else ss << c;
    }
    return ss.str();
}

inline std::string _nyx_json_get_string_full(const std::string& json_str, const std::string& key) {
    std::string pattern = "\"" + key + "\":";
    size_t pos = json_str.find(pattern);
    if (pos == std::string::npos) return "";
    pos += pattern.length();
    while (pos < json_str.length() && (json_str[pos] == ' ' || json_str[pos] == '\t' || json_str[pos] == '\r' || json_str[pos] == '\n')) pos++;
    if (pos < json_str.length() && json_str[pos] == '"') {
        pos++;
        size_t end_pos = pos;
        while (end_pos < json_str.length()) {
            if (json_str[end_pos] == '"' && json_str[end_pos - 1] != '\\') break;
            end_pos++;
        }
        if (end_pos < json_str.length()) {
            return json_str.substr(pos, end_pos - pos);
        }
    }
    return "";
}

inline int64_t _nyx_json_get_int_full(const std::string& json_str, const std::string& key) {
    std::string pattern = "\"" + key + "\":";
    size_t pos = json_str.find(pattern);
    if (pos == std::string::npos) return 0;
    pos += pattern.length();
    while (pos < json_str.length() && (json_str[pos] == ' ' || json_str[pos] == '\t' || json_str[pos] == '\r' || json_str[pos] == '\n')) pos++;
    size_t end_pos = pos;
    while (end_pos < json_str.length() && (isdigit(json_str[end_pos]) || json_str[end_pos] == '-')) end_pos++;
    if (end_pos > pos) {
        try { return std::stoll(json_str.substr(pos, end_pos - pos)); }
        catch(...) { return 0; }
    }
    return 0;
}

inline bool _nyx_json_get_bool_full(const std::string& json_str, const std::string& key) {
    std::string pattern = "\"" + key + "\":";
    size_t pos = json_str.find(pattern);
    if (pos == std::string::npos) return false;
    pos += pattern.length();
    while (pos < json_str.length() && (json_str[pos] == ' ' || json_str[pos] == '\t' || json_str[pos] == '\r' || json_str[pos] == '\n')) pos++;
    if (json_str.substr(pos, 4) == "true") return true;
    return false;
}

inline bool _nyx_json_has_key(const std::string& json_str, const std::string& key) {
    std::string pattern = "\"" + key + "\":";
    return json_str.find(pattern) != std::string::npos;
}
}

fn get_string(json_str: string, key: string) -> string {
    return _nyx_json_get_string_full(json_str, key);
}

fn get_int(json_str: string, key: string) -> int {
    return _nyx_json_get_int_full(json_str, key);
}

fn get_bool(json_str: string, key: string) -> bool {
    return _nyx_json_get_bool_full(json_str, key);
}

fn has_key(json_str: string, key: string) -> bool {
    return _nyx_json_has_key(json_str, key);
}

fn escape_string(s: string) -> string {
    return _nyx_json_escape(s);
}