// nyx Standard Library - std/fs
// Cross-Platform Native Filesystem I/O Primitives

#native include "fstream"
#native include "sstream"
#native include "string"

#native raw {
inline NyxResult<std::string, std::string> _nyx_fs_read_to_string_result(const std::string& path) {
    std::ifstream file(path);
    if (!file.is_open()) return {false, {}, "cannot open file for reading: " + path};
    std::stringstream buffer;
    buffer << file.rdbuf();
    if (file.bad()) return {false, {}, "failed while reading file: " + path};
    return {true, buffer.str(), {}};
}

inline NyxResult<bool, std::string> _nyx_fs_write_string_result(const std::string& path, const std::string& content) {
    std::ofstream file(path);
    if (!file.is_open()) return {false, false, "cannot open file for writing: " + path};
    file << content;
    if (!file.good()) return {false, false, "failed while writing file: " + path};
    return {true, true, {}};
}

inline NyxResult<bool, std::string> _nyx_fs_append_string_result(const std::string& path, const std::string& content) {
    std::ofstream file(path, std::ios::app);
    if (!file.is_open()) return {false, false, "cannot open file for appending: " + path};
    file << content;
    if (!file.good()) return {false, false, "failed while appending file: " + path};
    return {true, true, {}};
}

inline bool _nyx_fs_exists(const std::string& path) {
    std::ifstream file(path);
    return file.good();
}

inline NyxResult<bool, std::string> _nyx_fs_remove_file_result(const std::string& path) {
    if (std::remove(path.c_str()) != 0) return {false, false, "cannot remove file: " + path};
    return {true, true, {}};
}
}

fn read_to_string(path: string) -> Result<string, string> {
    return _nyx_fs_read_to_string_result(path);
}

fn write_string(path: string, content: string) -> Result<bool, string> {
    return _nyx_fs_write_string_result(path, content);
}

fn append_string(path: string, content: string) -> Result<bool, string> {
    return _nyx_fs_append_string_result(path, content);
}

fn exists(path: string) -> bool {
    return _nyx_fs_exists(path);
}

fn remove_file(path: string) -> Result<bool, string> {
    return _nyx_fs_remove_file_result(path);
}
