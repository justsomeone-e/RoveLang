// nyx Standard Library: std/system
// Hosted operating-system information for native C++ targets.
#target cpp

#native include <cstdint>
#native include <cstdlib>
#native include <filesystem>
#native include <string>
#native include <thread>

#native raw {
#if defined(_WIN32)
#include <windows.h>
#else
#include <unistd.h>
#endif

inline const char* _nyx_system_os_name() {
#if defined(_WIN32)
    return "Windows";
#elif defined(__APPLE__)
    return "macOS";
#elif defined(__linux__)
    return "Linux";
#else
    return "Unknown";
#endif
}

inline const char* _nyx_system_arch_name() {
#if defined(_M_X64) || defined(__x86_64__)
    return "x86_64";
#elif defined(_M_ARM64) || defined(__aarch64__)
    return "arm64";
#elif defined(_M_IX86) || defined(__i386__)
    return "x86";
#elif defined(_M_ARM) || defined(__arm__)
    return "arm";
#else
    return "unknown";
#endif
}

inline std::string _nyx_system_env_value(const char* primary, const char* fallback = nullptr) {
    const char* value = std::getenv(primary);
    if ((!value || !*value) && fallback) value = std::getenv(fallback);
    return value ? std::string(value) : std::string();
}

inline const char* _nyx_system_user_name() {
    static thread_local std::string value;
#if defined(_WIN32)
    value = _nyx_system_env_value("USERNAME", "USER");
#else
    value = _nyx_system_env_value("USER", "LOGNAME");
#endif
    return value.c_str();
}

inline const char* _nyx_system_home_directory() {
    static thread_local std::string value;
#if defined(_WIN32)
    value = _nyx_system_env_value("USERPROFILE", "HOME");
#else
    value = _nyx_system_env_value("HOME");
#endif
    return value.c_str();
}

inline const char* _nyx_system_working_directory() {
    static thread_local std::string value;
    try {
        value = std::filesystem::current_path().string();
    } catch (...) {
        value = "<unavailable>";
    }
    return value.c_str();
}

inline const char* _nyx_system_host_name() {
    static thread_local std::string value;
    char name[256] = {};
#if defined(_WIN32)
    DWORD size = static_cast<DWORD>(sizeof(name));
    value = GetComputerNameA(name, &size) ? std::string(name, size) : "<unavailable>";
#else
    value = gethostname(name, sizeof(name) - 1) == 0 ? std::string(name) : "<unavailable>";
#endif
    return value.c_str();
}

inline std::int64_t _nyx_system_cpu_threads() {
    const unsigned int count = std::thread::hardware_concurrency();
    return count == 0 ? 1 : static_cast<std::int64_t>(count);
}

inline std::int64_t _nyx_system_total_memory_mb() {
#if defined(_WIN32)
    MEMORYSTATUSEX status{};
    status.dwLength = sizeof(status);
    if (!GlobalMemoryStatusEx(&status)) return -1;
    return static_cast<std::int64_t>(status.ullTotalPhys / (1024ULL * 1024ULL));
#elif defined(_SC_PHYS_PAGES) && defined(_SC_PAGE_SIZE)
    const long pages = sysconf(_SC_PHYS_PAGES);
    const long page_size = sysconf(_SC_PAGE_SIZE);
    if (pages < 0 || page_size < 0) return -1;
    return static_cast<std::int64_t>(pages) * static_cast<std::int64_t>(page_size) / (1024LL * 1024LL);
#else
    return -1;
#endif
}
}

extern "C++" fn _nyx_system_os_name() -> string
extern "C++" fn _nyx_system_arch_name() -> string
extern "C++" fn _nyx_system_user_name() -> string
extern "C++" fn _nyx_system_home_directory() -> string
extern "C++" fn _nyx_system_working_directory() -> string
extern "C++" fn _nyx_system_host_name() -> string
extern "C++" fn _nyx_system_cpu_threads() -> int
extern "C++" fn _nyx_system_total_memory_mb() -> int

fn os_name() -> string = _nyx_system_os_name()
fn arch_name() -> string = _nyx_system_arch_name()
fn user_name() -> string = _nyx_system_user_name()
fn home_directory() -> string = _nyx_system_home_directory()
fn working_directory() -> string = _nyx_system_working_directory()
fn host_name() -> string = _nyx_system_host_name()
fn logical_cpu_threads() -> int = _nyx_system_cpu_threads()
fn total_memory_mb() -> int = _nyx_system_total_memory_mb()
