// Rove Standard Library: std/io
#target cpp

fn println_str(msg: string) {
    print(msg)
}

fn println_int(val: int) {
    print(val)
}

fn println_bool(val: bool) {
    print(val)
}

fn prompt_input(prompt: string) -> string {
    return input(prompt)
}

test "std/io comprehensive tests" {
    println_str("Rove I/O Test Passed")
}
