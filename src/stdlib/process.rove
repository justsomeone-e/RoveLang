// Nyx Standard Library: std/process
// Host Process Execution and Environment

fn exec_cmd(command: string) -> Result<int, string> {
    return _rove_process_exec_cmd_result(command);
}

fn get_env(name: string) -> Result<string, string> {
    return _rove_process_get_env_result(name);
}

fn exit_process(code: int) -> void {
    _rove_process_exit(code);
}
