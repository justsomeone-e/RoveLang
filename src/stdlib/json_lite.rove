// nyx Standard Library - std/json_lite
// Flat top-level string/integer field extractor. This is intentionally not a
// general JSON parser and does not implement nesting or escape decoding.

#native include "string"

#native raw {
inline std::string _nyx_json_get_string(const std::string& json_str, const std::string& key) {
    std::string pattern = "\"" + key + "\":";
    size_t pos = json_str.find(pattern);
    if (pos == std::string::npos) return "";
    pos += pattern.length();
    while (pos < json_str.length() && (json_str[pos] == ' ' || json_str[pos] == '\t')) pos++;
    if (pos < json_str.length() && json_str[pos] == '\"') {
        pos++;
        size_t end_pos = json_str.find('\"', pos);
        if (end_pos != std::string::npos) {
            return json_str.substr(pos, end_pos - pos);
        }
    }
    return "";
}

inline int64_t _nyx_json_get_int(const std::string& json_str, const std::string& key) {
    std::string pattern = "\"" + key + "\":";
    size_t pos = json_str.find(pattern);
    if (pos == std::string::npos) return 0;
    pos += pattern.length();
    while (pos < json_str.length() && (json_str[pos] == ' ' || json_str[pos] == '\t')) pos++;
    size_t end_pos = pos;
    while (end_pos < json_str.length() && (isdigit(json_str[end_pos]) || json_str[end_pos] == '-')) end_pos++;
    if (end_pos > pos) {
        try { return std::stoll(json_str.substr(pos, end_pos - pos)); }
        catch(...) { return 0; }
    }
    return 0;
}

inline NyxResult<std::string, std::string> _nyx_json_get_string_result(const std::string& json_str, const std::string& key) {
    std::string pattern = "\"" + key + "\":";
    size_t pos = json_str.find(pattern);
    if (pos == std::string::npos) return {false, {}, "JSON field not found: " + key};
    pos += pattern.size();
    while (pos < json_str.size() && (json_str[pos] == ' ' || json_str[pos] == '\t')) pos++;
    if (pos >= json_str.size() || json_str[pos] != '"') return {false, {}, "JSON field is not a string: " + key};
    size_t end = json_str.find('"', pos + 1);
    if (end == std::string::npos) return {false, {}, "unterminated JSON string field: " + key};
    return {true, json_str.substr(pos + 1, end - pos - 1), {}};
}

inline NyxResult<int64_t, std::string> _nyx_json_get_int_result(const std::string& json_str, const std::string& key) {
    std::string pattern = "\"" + key + "\":";
    size_t pos = json_str.find(pattern);
    if (pos == std::string::npos) return {false, 0, "JSON field not found: " + key};
    pos += pattern.size();
    while (pos < json_str.size() && (json_str[pos] == ' ' || json_str[pos] == '\t')) pos++;
    size_t end = pos + ((pos < json_str.size() && json_str[pos] == '-') ? 1 : 0);
    while (end < json_str.size() && std::isdigit(static_cast<unsigned char>(json_str[end]))) end++;
    if (end == pos || (end == pos + 1 && json_str[pos] == '-')) return {false, 0, "JSON field is not an integer: " + key};
    try { return {true, std::stoll(json_str.substr(pos, end - pos)), {}}; }
    catch (...) { return {false, 0, "JSON integer is out of range: " + key}; }
}
}

fn get_string(json_str: string, key: string) -> Result<string, string> {
    return _nyx_json_get_string_result(json_str, key);
}

fn get_int(json_str: string, key: string) -> Result<int, string> {
    return _nyx_json_get_int_result(json_str, key);
}
