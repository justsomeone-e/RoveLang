// Nyx Standard Library: std/path
// Cross-Platform Path Manipulation Primitives

fn join(a: string, b: string) -> string {
    return _nyx_path_join(a, b);
}

fn basename(p: string) -> string {
    return _nyx_path_basename(p);
}

fn dirname(p: string) -> string {
    return _nyx_path_dirname(p);
}

fn extname(p: string) -> string {
    return _nyx_path_extname(p);
}

fn is_absolute(p: string) -> bool {
    return _nyx_path_is_abs(p);
}

fn normalize(p: string) -> string {
    return _nyx_path_normalize(p);
}
