// Nyx Standard Library: std/str
// String Utilities and Formatting

fn is_empty_str(s: string) -> bool {
    return s == "";
}

fn concat_three(a: string, b: string, c: string) -> string {
    return a + b + c;
}

fn wrap_with(s: string, open_tag: string, close_tag: string) -> string {
    return open_tag + s + close_tag;
}

fn contains_substring(s: string, sub: string) -> bool {
    return contains(s, sub);
}

fn trim(s: string) -> string {
    return _nyx_str_trim(s);
}

fn starts_with(s: string, prefix: string) -> bool {
    return _nyx_str_starts_with(s, prefix);
}

fn ends_with(s: string, suffix: string) -> bool {
    return _nyx_str_ends_with(s, suffix);
}

fn find(s: string, sub: string) -> Result<int, string> {
    return _nyx_str_find_result(s, sub);
}

fn to_upper(s: string) -> string {
    return _nyx_str_to_upper(s);
}

fn to_lower(s: string) -> string {
    return _nyx_str_to_lower(s);
}

fn replace(s: string, from_str: string, to_str: string) -> string {
    return _nyx_str_replace(s, from_str, to_str);
}
