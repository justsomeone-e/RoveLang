// std/web.rove
// Typed WebAssembly browser host API. WebElement and WebEvent are opaque
// handles owned by the generated nyx_host_v1 JavaScript adapter.

type WebElement = int
type WebEvent = int
type WebListener = int

extern "WASM:nyx_host_v1" fn _nyx_host_abi_version() -> int
extern "WASM:nyx_host_v1" fn _nyx_web_document() -> WebElement
extern "WASM:nyx_host_v1" fn _nyx_web_query(selector: string) -> WebElement
extern "WASM:nyx_host_v1" fn _nyx_web_create(tag: string) -> WebElement
extern "WASM:nyx_host_v1" fn _nyx_web_set_text(element: WebElement, value: string) -> void
extern "WASM:nyx_host_v1" fn _nyx_web_set_attribute(element: WebElement, name: string, value: string) -> void
extern "WASM:nyx_host_v1" fn _nyx_web_append(parent: WebElement, child: WebElement) -> void
extern "WASM:nyx_host_v1" fn _nyx_web_remove(element: WebElement) -> void
extern "WASM:nyx_host_v1" fn _nyx_web_release(element: WebElement) -> void
extern "WASM:nyx_host_v1" fn _nyx_web_listen(element: WebElement, event_name: string, callback_id: int) -> WebListener
extern "WASM:nyx_host_v1" fn _nyx_web_unlisten(listener: WebListener) -> void
extern "WASM:nyx_host_v1" fn _nyx_web_request_animation_frame(callback_id: int) -> void
extern "WASM:nyx_host_v1" fn _nyx_web_event_key(event: WebEvent) -> int
extern "WASM:nyx_host_v1" fn _nyx_web_canvas_clear(canvas: WebElement) -> void
extern "WASM:nyx_host_v1" fn _nyx_web_canvas_set_fill_style(canvas: WebElement, color: string) -> void
extern "WASM:nyx_host_v1" fn _nyx_web_canvas_fill_rect(canvas: WebElement, x: float, y: float, width: float, height: float) -> void
extern "WASM:nyx_host_v1" fn _nyx_web_canvas_draw_line(canvas: WebElement, x1: float, y1: float, x2: float, y2: float, color: string, width: float) -> void
extern "WASM:nyx_host_v1" fn _nyx_web_canvas_draw_circle(canvas: WebElement, x: float, y: float, radius: float, color: string) -> void
extern "WASM:nyx_host_v1" fn _nyx_web_canvas_draw_glow_circle(canvas: WebElement, x: float, y: float, radius: float, inner_color: string, outer_color: string) -> void
extern "WASM:nyx_host_v1" fn _nyx_web_canvas_set_global_alpha(canvas: WebElement, alpha: float) -> void
extern "WASM:nyx_host_v1" fn _nyx_web_canvas_set_blend_mode(canvas: WebElement, mode: string) -> void

fn web_host_abi_version() -> int = _nyx_host_abi_version()

fn web_document() -> WebElement = _nyx_web_document()
fn web_query(selector: string) -> WebElement = _nyx_web_query(selector)
fn web_create(tag: string) -> WebElement = _nyx_web_create(tag)

fn web_set_text(element: WebElement, value: string) -> void {
    _nyx_web_set_text(element, value)
}

fn web_set_attribute(element: WebElement, name: string, value: string) -> void {
    _nyx_web_set_attribute(element, name, value)
}

fn web_append(parent: WebElement, child: WebElement) -> void {
    _nyx_web_append(parent, child)
}

fn web_remove(element: WebElement) -> void {
    _nyx_web_remove(element)
}

fn web_release(element: WebElement) -> void {
    _nyx_web_release(element)
}

fn web_listen(element: WebElement, event_name: string, callback_id: int) -> WebListener {
    return _nyx_web_listen(element, event_name, callback_id)
}

fn web_unlisten(listener: WebListener) -> void {
    _nyx_web_unlisten(listener)
}

fn web_request_animation_frame(callback_id: int) -> void {
    _nyx_web_request_animation_frame(callback_id)
}

fn web_event_key(event: WebEvent) -> int = _nyx_web_event_key(event)

fn web_canvas_clear(canvas: WebElement) -> void {
    _nyx_web_canvas_clear(canvas)
}

fn web_canvas_set_fill_style(canvas: WebElement, color: string) -> void {
    _nyx_web_canvas_set_fill_style(canvas, color)
}

fn web_canvas_fill_rect(canvas: WebElement, x: float, y: float, width: float, height: float) -> void {
    _nyx_web_canvas_fill_rect(canvas, x, y, width, height)
}

fn web_canvas_draw_line(canvas: WebElement, x1: float, y1: float, x2: float, y2: float, color: string, width: float) -> void {
    _nyx_web_canvas_draw_line(canvas, x1, y1, x2, y2, color, width)
}

fn web_canvas_draw_circle(canvas: WebElement, x: float, y: float, radius: float, color: string) -> void {
    _nyx_web_canvas_draw_circle(canvas, x, y, radius, color)
}

fn web_canvas_draw_glow_circle(canvas: WebElement, x: float, y: float, radius: float, inner_color: string, outer_color: string) -> void {
    _nyx_web_canvas_draw_glow_circle(canvas, x, y, radius, inner_color, outer_color)
}

fn web_canvas_set_global_alpha(canvas: WebElement, alpha: float) -> void {
    _nyx_web_canvas_set_global_alpha(canvas, alpha)
}

fn web_canvas_set_blend_mode(canvas: WebElement, mode: string) -> void {
    _nyx_web_canvas_set_blend_mode(canvas, mode)
}
