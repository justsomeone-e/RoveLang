// nyx Standard Library - std/hash
// Fast Non-Cryptographic Hashing Algorithms (RFC 9923 FNV-1a 64-bit Hex)

#native include "string"
#native include "sstream"
#native include "iomanip"
#native include "cstdint"

#native raw {
inline std::string _nyx_hash_fnv1a_64_hex(const std::string& str) {
    uint64_t hash = 0xcbf29ce484222325ULL;
    const uint64_t prime = 0x100000001b3ULL;
    const uint8_t* data = reinterpret_cast<const uint8_t*>(str.data());
    for (size_t i = 0; i < str.size(); ++i) {
        hash ^= (uint64_t)data[i];
        hash *= prime;
    }
    std::stringstream ss;
    ss << std::hex << std::setfill('0') << std::setw(16) << hash;
    return ss.str();
}
}

fn fnv1a_64_hex(data: string) -> string {
    return _nyx_hash_fnv1a_64_hex(data);
}