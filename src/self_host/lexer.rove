// Rove Self-Hosted Compiler - Phase 1: Lexer & Tokenizer
// Written completely in Rove language itself

enum TokenType {
    TOKEN_EOF,
    TOKEN_IDENT,
    TOKEN_INT,
    TOKEN_FLOAT,
    TOKEN_STRING,
    TOKEN_FN,
    TOKEN_VAR,
    TOKEN_RETURN,
    TOKEN_IF,
    TOKEN_ELSE,
    TOKEN_WHILE,
    TOKEN_FOR,
    TOKEN_GUARD,
    TOKEN_LPAREN,
    TOKEN_RPAREN,
    TOKEN_LBRACE,
    TOKEN_RBRACE,
    TOKEN_COLON,
    TOKEN_SEMICOLON,
    TOKEN_ARROW,
    TOKEN_PLUS,
    TOKEN_MINUS,
    TOKEN_STAR,
    TOKEN_SLASH
}

struct Token {
    kind: int,
    value: string,
    line: int,
    col: int
}

fn create_token(kind: int, value: string, line: int, col: int) -> Token {
    return Token(kind, value, line, col);
}

fn is_whitespace(c: string) -> bool {
    return c == " " or c == "\t" or c == "\n" or c == "\r";
}

fn is_letter(c: string) -> bool {
    return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_";
}

fn is_digit(c: string) -> bool {
    return c >= "0" and c <= "9";
}

fn tokenize_sample(source: string) -> int {
    var token_count = 0;
    var len = length(source);
    var i = 0;
    
    while i < len {
        var c = source[i];
        if is_whitespace(c) {
            i = i + 1;
        } else if is_letter(c) {
            token_count = token_count + 1;
            while i < len and (is_letter(source[i]) or is_digit(source[i])) {
                i = i + 1;
            }
        } else if is_digit(c) {
            token_count = token_count + 1;
            while i < len and is_digit(source[i]) {
                i = i + 1;
            }
        } else {
            token_count = token_count + 1;
            i = i + 1;
        }
    }
    return token_count;
}

fn main() {
    print("=== [NYX SELF-HOSTED LEXER PHASE 1] ===");
    var sample_code = "fn compute(x: int, y: int) -> int { return x + y; }";
    var tokens = tokenize_sample(sample_code);
    print($"[SELF-HOST] Successfully tokenized sample program: {tokens} tokens found.");
}