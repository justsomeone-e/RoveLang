#target cpp
#native include <iostream>
#native include <string>
#native include <vector>
#native include <cctype>
#native include <iomanip>

// =========================================================
// NYX CANONICAL AST MODEL (1-TO-1 WITH src/core/ast_nodes.py)
// =========================================================

struct TypeNode {
    name: string,
    is_optional: bool,
    is_pointer: bool,
    is_fn_type: bool,
    param_types: Array<string>,
    return_type_name: string,
    line: int,
    col: int
}

impl TypeNode {
    fn to_str(self) -> string {
        if self.is_fn_type {
            var params = ""
            for i in 0..len(self.param_types)-1 {
                if i > 0 { params = params + ", " }
                params = params + self.param_types[i]
            }
            return "fn(" + params + ") -> " + self.return_type_name
        }
        var base = self.name
        if self.is_pointer { base = "*" + base }
        if self.is_optional { base = base + "?" }
        return base
    }
}

struct FunctionParam {
    name: string,
    type_annot: string
}

impl FunctionParam {
    fn to_str(self) -> string {
        return self.name + ": " + self.type_annot
    }
}

struct ASTNode {
    kind: string,
    name: string,
    value: string,
    op: string,
    type_name: string,
    is_const: bool,
    is_async: bool,
    is_safe: bool,
    is_varargs: bool,
    params: Array<FunctionParam>,
    generic_args: Array<string>,
    children: Array<ASTNode>,
    line: int,
    col: int
}

impl ASTNode {
    fn to_str(self) -> string {
        var res = "(" + self.kind
        if self.name != "" { res = res + " name='" + self.name + "'" }
        if self.value != "" { res = res + " val='" + self.value + "'" }
        if self.op != "" { res = res + " op='" + self.op + "'" }
        if self.type_name != "" { res = res + " type='" + self.type_name + "'" }
        if self.is_const { res = res + " const=true" }
        if self.is_async { res = res + " async=true" }
        if self.is_safe { res = res + " safe=true" }
        
        if len(self.params) > 0 {
            res = res + " params=["
            for i in 0..len(self.params)-1 {
                if i > 0 { res = res + ", " }
                res = res + self.params[i].to_str()
            }
            res = res + "]"
        }
        
        if len(self.children) > 0 {
            res = res + " body=["
            for i in 0..len(self.children)-1 {
                if i > 0 { res = res + " " }
                res = res + self.children[i].to_str()
            }
            res = res + "]"
        }
        res = res + ")"
        return res
    }
}

struct Token {
    type_name: string,
    value: string,
    line: int,
    col: int
}

impl Token {
    fn to_str(self) -> string {
        return self.type_name + ":" + self.value + "@" + to_string(self.line) + ":" + to_string(self.col)
    }
}

struct Lexer {
    source: string,
    pos: int,
    line: int,
    col: int
}

impl Lexer {
    fn is_eof(self) -> bool {
        return self.pos >= len(self.source)
    }

    fn peek_char(self) -> string {
        if self.pos >= len(self.source) {
            return ""
        }
        return self.source[self.pos]
    }

    fn peek_ahead(self, offset: int) -> string {
        var idx = self.pos + offset
        if idx >= len(self.source) {
            return ""
        }
        return self.source[idx]
    }

    fn advance(self) -> string {
        if self.pos >= len(self.source) {
            return ""
        }
        var ch = self.source[self.pos]
        self.pos = self.pos + 1
        self.col = self.col + 1
        return ch
    }

    fn match_str(self, s: string) -> bool {
        var slen = len(s)
        if self.pos + slen > len(self.source) {
            return false
        }
        for i in 0..slen-1 {
            if self.source[self.pos + i] != s[i] {
                return false
            }
        }
        return true
    }

    fn tokenize(self) -> Array<Token> {
        var tokens: Array<Token> = []
        var length = len(self.source)

        while self.pos < length {
            var ch = self.peek_char()

            if ch == "\n" {
                self.line = self.line + 1
                self.col = 1
                self.pos = self.pos + 1
                continue
            }

            if ch == " " or ch == "\t" or ch == "\r" {
                self.col = self.col + 1
                self.pos = self.pos + 1
                continue
            }

            // Doc comment ///
            if self.match_str("///") {
                var start_col = self.col
                self.pos = self.pos + 3
                self.col = self.col + 3
                var start_doc = self.pos
                while self.pos < length and self.peek_char() != "\n" {
                    self.pos = self.pos + 1
                    self.col = self.col + 1
                }
                var doc_text = ""
                for i in start_doc..self.pos-1 {
                    doc_text = doc_text + self.source[i]
                }
                tokens.push(Token("DOC_COMMENT", doc_text, self.line, start_col))
                continue
            }

            // Line comment //
            if self.match_str("//") {
                while self.pos < length and self.peek_char() != "\n" {
                    self.pos = self.pos + 1
                }
                continue
            }

            // Block comment /* ... */
            if self.match_str("/*") {
                self.pos = self.pos + 2
                self.col = self.col + 2
                while self.pos + 1 < length and not (self.peek_char() == "*" and self.peek_ahead(1) == "/") {
                    if self.peek_char() == "\n" {
                        self.line = self.line + 1
                        self.col = 1
                    } else {
                        self.col = self.col + 1
                    }
                    self.pos = self.pos + 1
                }
                self.pos = self.pos + 2
                self.col = self.col + 2
                continue
            }

            // Directives: #target and #native
            if ch == "#" and self.match_str("#target") {
                var start_col = self.col
                self.pos = self.pos + 7
                self.col = self.col + 7
                while self.pos < length and (self.peek_char() == " " or self.peek_char() == "\t") {
                    self.pos = self.pos + 1
                    self.col = self.col + 1
                }
                var start_val = self.pos
                while self.pos < length and self.peek_char() != "\n" and self.peek_char() != " " and self.peek_char() != "\r" {
                    self.pos = self.pos + 1
                    self.col = self.col + 1
                }
                var target_val = ""
                for i in start_val..self.pos-1 {
                    target_val = target_val + self.source[i]
                }
                tokens.push(Token("TARGET", target_val, self.line, start_col))
                continue
            }

            if ch == "#" and self.match_str("#native") {
                var start_col = self.col
                self.pos = self.pos + 7
                self.col = self.col + 7
                while self.pos < length and (self.peek_char() == " " or self.peek_char() == "\t") {
                    self.pos = self.pos + 1
                    self.col = self.col + 1
                }

                if self.match_str("include") {
                    self.pos = self.pos + 7
                    self.col = self.col + 7
                    while self.pos < length and (self.peek_char() == " " or self.peek_char() == "\t") {
                        self.pos = self.pos + 1
                        self.col = self.col + 1
                    }
                    var start_hdr = self.pos
                    while self.pos < length and self.peek_char() != "\n" and self.peek_char() != ";" {
                        self.pos = self.pos + 1
                        self.col = self.col + 1
                    }
                    var hdr = ""
                    for i in start_hdr..self.pos-1 {
                        hdr = hdr + self.source[i]
                    }
                    tokens.push(Token("NATIVE_INCLUDE", hdr, self.line, start_col))
                    continue
                }

                if self.match_str("link") {
                    self.pos = self.pos + 4
                    self.col = self.col + 4
                    while self.pos < length and (self.peek_char() == " " or self.peek_char() == "\t") {
                        self.pos = self.pos + 1
                        self.col = self.col + 1
                    }
                    var start_lib = self.pos
                    while self.pos < length and self.peek_char() != "\n" and self.peek_char() != ";" {
                        self.pos = self.pos + 1
                        self.col = self.col + 1
                    }
                    var lib = ""
                    for i in start_lib..self.pos-1 {
                        if self.source[i] != "\"" and self.source[i] != "'" {
                            lib = lib + self.source[i]
                        }
                    }
                    tokens.push(Token("NATIVE_LINK", lib, self.line, start_col))
                    continue
                }

                if self.match_str("use") {
                    self.pos = self.pos + 3
                    self.col = self.col + 3
                    while self.pos < length and (self.peek_char() == " " or self.peek_char() == "\t") {
                        self.pos = self.pos + 1
                        self.col = self.col + 1
                    }
                    var start_use = self.pos
                    while self.pos < length and self.peek_char() != "\n" and self.peek_char() != ";" {
                        self.pos = self.pos + 1
                        self.col = self.col + 1
                    }
                    var ut = ""
                    for i in start_use..self.pos-1 {
                        ut = ut + self.source[i]
                    }
                    tokens.push(Token("NATIVE_USE", ut, self.line, start_col))
                    continue
                }

                // Raw native
                var start_raw = self.pos
                while self.pos < length and self.peek_char() != "\n" {
                    self.pos = self.pos + 1
                    self.col = self.col + 1
                }
                var raw = ""
                for i in start_raw..self.pos-1 {
                    raw = raw + self.source[i]
                }
                tokens.push(Token("NATIVE_RAW", raw, self.line, start_col))
                continue
            }

            // Multi-character symbols
            if self.match_str("?.") { tokens.push(Token("SAFE_NAV", "?.", self.line, self.col)); self.pos = self.pos + 2; self.col = self.col + 2; continue }
            if self.match_str("??") { tokens.push(Token("NULL_COALESCE", "??", self.line, self.col)); self.pos = self.pos + 2; self.col = self.col + 2; continue }
            if self.match_str("=>") { tokens.push(Token("FAT_ARROW", "=>", self.line, self.col)); self.pos = self.pos + 2; self.col = self.col + 2; continue }
            if self.match_str("->") { tokens.push(Token("ARROW", "->", self.line, self.col)); self.pos = self.pos + 2; self.col = self.col + 2; continue }
            if self.match_str("|>") { tokens.push(Token("PIPE", "|>", self.line, self.col)); self.pos = self.pos + 2; self.col = self.col + 2; continue }
            if self.match_str("..") { tokens.push(Token("DOTDOT", "..", self.line, self.col)); self.pos = self.pos + 2; self.col = self.col + 2; continue }
            if self.match_str("==") { tokens.push(Token("EQ", "==", self.line, self.col)); self.pos = self.pos + 2; self.col = self.col + 2; continue }
            if self.match_str("!=") { tokens.push(Token("NEQ", "!=", self.line, self.col)); self.pos = self.pos + 2; self.col = self.col + 2; continue }
            if self.match_str(">=") { tokens.push(Token("GTE", ">=", self.line, self.col)); self.pos = self.pos + 2; self.col = self.col + 2; continue }
            if self.match_str("<=") { tokens.push(Token("LTE", "<=", self.line, self.col)); self.pos = self.pos + 2; self.col = self.col + 2; continue }
            if self.match_str("&&") { tokens.push(Token("AND", "and", self.line, self.col)); self.pos = self.pos + 2; self.col = self.col + 2; continue }
            if self.match_str("||") { tokens.push(Token("OR", "or", self.line, self.col)); self.pos = self.pos + 2; self.col = self.col + 2; continue }

            // Strings
            if ch == "\"" or ch == "'" {
                var quote = ch
                var start_col = self.col
                self.pos = self.pos + 1
                self.col = self.col + 1
                var str_val = ""
                while self.pos < length and self.peek_char() != quote {
                    if self.peek_char() == "\\" and self.pos + 1 < length {
                        var esc = self.peek_ahead(1)
                        if esc == "n" { str_val = str_val + "\n" }
                        elif esc == "t" { str_val = str_val + "\t" }
                        elif esc == "r" { str_val = str_val + "\r" }
                        elif esc == "\\" { str_val = str_val + "\\" }
                        elif esc == quote { str_val = str_val + quote }
                        else { str_val = str_val + esc }
                        self.pos = self.pos + 2
                        self.col = self.col + 2
                    } else {
                        if self.peek_char() == "\n" {
                            self.line = self.line + 1
                            self.col = 1
                        } else {
                            self.col = self.col + 1
                        }
                        str_val = str_val + self.peek_char()
                        self.pos = self.pos + 1
                    }
                }
                self.pos = self.pos + 1
                self.col = self.col + 1
                tokens.push(Token("STRING", str_val, self.line, start_col))
                continue
            }

            // Numbers (decimal, float, and hex 0x)
            if (ch >= "0" and ch <= "9") or (ch == "." and self.pos + 1 < length and (self.peek_ahead(1) >= "0" and self.peek_ahead(1) <= "9")) {
                var start_col = self.col
                var start_pos = self.pos
                if ch == "0" and self.pos + 1 < length and (self.peek_ahead(1) == "x" or self.peek_ahead(1) == "X") {
                    self.pos = self.pos + 2
                    self.col = self.col + 2
                    while self.pos < length and ((self.peek_char() >= "0" and self.peek_char() <= "9") or (self.peek_char() >= "a" and self.peek_char() <= "f") or (self.peek_char() >= "A" and self.peek_char() <= "F")) {
                        self.pos = self.pos + 1
                        self.col = self.col + 1
                    }
                    var hex_val = ""
                    for i in start_pos..self.pos-1 {
                        hex_val = hex_val + self.source[i]
                    }
                    tokens.push(Token("NUMBER", hex_val, self.line, start_col))
                    continue
                }

                while self.pos < length and ((self.peek_char() >= "0" and self.peek_char() <= "9") or self.peek_char() == ".") {
                    if self.peek_char() == "." and self.peek_ahead(1) == "." {
                        break
                    }
                    self.pos = self.pos + 1
                    self.col = self.col + 1
                }
                var num_val = ""
                for i in start_pos..self.pos-1 {
                    num_val = num_val + self.source[i]
                }
                tokens.push(Token("NUMBER", num_val, self.line, start_col))
                continue
            }

            // Identifiers & Keywords
            if (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or ch == "_" or ch == "$" {
                var start_col = self.col
                var start_pos = self.pos
                while self.pos < length and ((self.peek_char() >= "a" and self.peek_char() <= "z") or (self.peek_char() >= "A" and self.peek_char() <= "Z") or (self.peek_char() >= "0" and self.peek_char() <= "9") or self.peek_char() == "_" or self.peek_char() == "$") {
                    self.pos = self.pos + 1
                    self.col = self.col + 1
                }
                var ident = ""
                for i in start_pos..self.pos-1 {
                    if self.source[i] != "$" {
                        ident = ident + self.source[i]
                    }
                }

                // Keyword check
                var tt = "IDENT"
                if ident == "var" { tt = "VAR" }
                elif ident == "let" { tt = "LET" }
                elif ident == "set" { tt = "SET" }
                elif ident == "const" { tt = "CONST" }
                elif ident == "fn" or ident == "def" { tt = "FN" }
                elif ident == "struct" { tt = "STRUCT" }
                elif ident == "trait" { tt = "TRAIT" }
                elif ident == "impl" { tt = "IMPL" }
                elif ident == "type" { tt = "TYPE_ALIAS" }
                elif ident == "enum" { tt = "ENUM" }
                elif ident == "unsafe" { tt = "UNSAFE" }
                elif ident == "extern" { tt = "EXTERN" }
                elif ident == "return" { tt = "RETURN" }
                elif ident == "continue" { tt = "CONTINUE" }
                elif ident == "break" { tt = "BREAK" }
                elif ident == "if" { tt = "IF" }
                elif ident == "else" { tt = "ELSE" }
                elif ident == "elif" { tt = "ELIF" }
                elif ident == "for" { tt = "FOR" }
                elif ident == "in" { tt = "IN" }
                elif ident == "loop" { tt = "LOOP" }
                elif ident == "while" { tt = "WHILE" }
                elif ident == "match" { tt = "MATCH" }
                elif ident == "try" { tt = "TRY" }
                elif ident == "catch" { tt = "CATCH" }
                elif ident == "use" { tt = "USE" }
                elif ident == "import" { tt = "IMPORT" }
                elif ident == "from" { tt = "FROM" }
                elif ident == "as" { tt = "AS" }
                elif ident == "print" { tt = "PRINT" }
                elif ident == "addr" { tt = "ADDR" }
                elif ident == "peek" { tt = "PEEK" }
                elif ident == "memdump" { tt = "MEMDUMP" }
                elif ident == "and" { tt = "AND" }
                elif ident == "or" { tt = "OR" }
                elif ident == "not" { tt = "NOT" }
                elif ident == "true" or ident == "false" { tt = "BOOLEAN" }
                elif ident == "null" { tt = "NULL" }

                tokens.push(Token(tt, ident, self.line, start_col))
                continue
            }

            // Single character symbols
            var single_tt = ""
            if ch == "=" { single_tt = "ASSIGN" }
            elif ch == "+" { single_tt = "PLUS" }
            elif ch == "-" { single_tt = "MINUS" }
            elif ch == "*" { single_tt = "MUL" }
            elif ch == "/" { single_tt = "DIV" }
            elif ch == "%" { single_tt = "MOD" }
            elif ch == ">" { single_tt = "GT" }
            elif ch == "<" { single_tt = "LT" }
            elif ch == "!" { single_tt = "NOT" }
            elif ch == "(" { single_tt = "LPAREN" }
            elif ch == ")" { single_tt = "RPAREN" }
            elif ch == "[" { single_tt = "LBRACKET" }
            elif ch == "]" { single_tt = "RBRACKET" }
            elif ch == "{" { single_tt = "LBRACE" }
            elif ch == "}" { single_tt = "RBRACE" }
            elif ch == "," { single_tt = "COMMA" }
            elif ch == ":" { single_tt = "COLON" }
            elif ch == "." { single_tt = "DOT" }
            elif ch == "?" { single_tt = "QUESTION" }
            elif ch == ";" { single_tt = "SEMICOLON" }

            if single_tt != "" {
                tokens.push(Token(single_tt, ch, self.line, self.col))
                self.pos = self.pos + 1
                self.col = self.col + 1
                continue
            }

            // Unexpected char - skip with warning
            self.pos = self.pos + 1
            self.col = self.col + 1
        }

        tokens.push(Token("EOF", "EOF", self.line, self.col))
        return tokens
    }
}


main()





struct Parser {
    tokens: Array<Token>,
    pos: int,
    has_error: bool,
    error_msg: string
}

impl Parser {
    fn current(self) -> Token {
        if self.pos >= len(self.tokens) {
            return Token("EOF", "EOF", 0, 0)
        }
        return self.tokens[self.pos]
    }

    fn peek_ahead(self, offset: int) -> Token {
        var idx = self.pos + offset
        if idx >= len(self.tokens) {
            return Token("EOF", "EOF", 0, 0)
        }
        return self.tokens[idx]
    }

    fn advance(self) -> Token {
        var tok = self.current()
        if self.pos < len(self.tokens) {
            self.pos = self.pos + 1
        }
        return tok
    }

    fn match_type(self, tt: string) -> bool {
        if self.current().type_name == tt {
            self.advance()
            return true
        }
        return false
    }

    fn expect(self, tt: string) -> Token {
        var tok = self.current()
        if tok.type_name == tt {
            return self.advance()
        }
        self.has_error = true
        self.error_msg = "Expected token " + tt + " but found " + tok.type_name + " at line " + to_string(tok.line) + ":" + to_string(tok.col)
        return self.advance()
    }

    fn parse_type(self) -> string {
        var is_ptr = false
        if self.match_type("MUL") { is_ptr = true }
        var name = self.advance().value
        if self.match_type("LT") {
            var gen = self.parse_type()
            self.expect("GT")
            name = name + "<" + gen + ">"
        }
        if is_ptr { name = "*" + name }
        if self.match_type("QUESTION") { name = name + "?" }
        return name
    }

    fn parse_primary(self) -> ASTNode {
        var tok = self.current()

        if tok.type_name == "NUMBER" {
            self.advance()
            return ASTNode("Number", "", tok.value, "", "int", false, false, false, false, [], [], [], tok.line, tok.col)
        }

        if tok.type_name == "STRING" {
            self.advance()
            return ASTNode("String", "", tok.value, "", "string", false, false, false, false, [], [], [], tok.line, tok.col)
        }

        if tok.type_name == "BOOLEAN" {
            self.advance()
            return ASTNode("Boolean", "", tok.value, "", "bool", false, false, false, false, [], [], [], tok.line, tok.col)
        }

        if tok.type_name == "NULL" {
            self.advance()
            return ASTNode("Null", "", "null", "", "null", false, false, false, false, [], [], [], tok.line, tok.col)
        }

        if tok.type_name == "IDENT" {
            var name = self.advance().value
            return ASTNode("Identifier", name, "", "", "", false, false, false, false, [], [], [], tok.line, tok.col)
        }

        if tok.type_name == "PRINT" or tok.type_name == "ADDR" or tok.type_name == "PEEK" or tok.type_name == "MEMDUMP" {
            var callee = self.advance().value
            self.expect("LPAREN")
            var args: Array<ASTNode> = []
            if not self.match_type("RPAREN") {
                while true {
                    args.push(self.parse_expr(0))
                    if self.match_type("COMMA") { continue }
                    self.expect("RPAREN")
                    break
                }
            }
            return ASTNode("FunctionCall", callee, "", "", "", false, false, false, false, [], [], args, tok.line, tok.col)
        }

        if self.match_type("LPAREN") {
            var expr = self.parse_expr(0)
            self.expect("RPAREN")
            return expr
        }

        if self.match_type("LBRACKET") {
            var elems: Array<ASTNode> = []
            if not self.match_type("RBRACKET") {
                while true {
                    elems.push(self.parse_expr(0))
                    if self.match_type("COMMA") { continue }
                    self.expect("RBRACKET")
                    break
                }
            }
            return ASTNode("Array", "", "", "", "", false, false, false, false, [], [], elems, tok.line, tok.col)
        }

        self.has_error = true
        self.error_msg = "Unexpected token in expression: " + tok.type_name + " ('" + tok.value + "') at line " + to_string(tok.line) + ":" + to_string(tok.col)
        self.advance()
        return ASTNode("Unknown", "", "", "", "", false, false, false, false, [], [], [], tok.line, tok.col)
    }

    fn parse_postfix(self) -> ASTNode {
        var node = self.parse_primary()

        while true {
            if self.match_type("DOT") {
                var member = self.expect("IDENT").value
                if self.match_type("LPAREN") {
                    var args: Array<ASTNode> = []
                    if not self.match_type("RPAREN") {
                        while true {
                            args.push(self.parse_expr(0))
                            if self.match_type("COMMA") { continue }
                            self.expect("RPAREN")
                            break
                        }
                    }
                    var call_node = ASTNode("MethodCall", member, "", "", "", false, false, false, false, [], [], args, node.line, node.col)
                    node = ASTNode("MemberAccess", member, "", "", "", false, false, false, false, [], [], [node, call_node], node.line, node.col)
                } else {
                    node = ASTNode("MemberAccess", member, "", "", "", false, false, false, false, [], [], [node], node.line, node.col)
                }
            } elif self.match_type("LBRACKET") {
                var idx = self.parse_expr(0)
                self.expect("RBRACKET")
                node = ASTNode("IndexAccess", "", "", "", "", false, false, false, false, [], [], [node, idx], node.line, node.col)
            } elif self.match_type("LPAREN") {
                var args: Array<ASTNode> = []
                if not self.match_type("RPAREN") {
                    while true {
                        args.push(self.parse_expr(0))
                        if self.match_type("COMMA") { continue }
                        self.expect("RPAREN")
                        break
                    }
                }
                node = ASTNode("FunctionCall", node.name, "", "", "", false, false, false, false, [], [], args, node.line, node.col)
            } else {
                break
            }
        }
        return node
    }

    fn parse_unary(self) -> ASTNode {
        var tok = self.current()
        if tok.type_name == "MINUS" or tok.type_name == "NOT" {
            self.advance()
            var expr = self.parse_unary()
            return ASTNode("UnaryOp", "", "", tok.value, "", false, false, false, false, [], [], [expr], tok.line, tok.col)
        }
        return self.parse_postfix()
    }

    fn get_prec(self, op: string) -> int {
        if op == "OR" or op == "or" { return 10 }
        if op == "AND" or op == "and" { return 20 }
        if op == "EQ" or op == "NEQ" or op == "==" or op == "!=" { return 30 }
        if op == "LT" or op == "GT" or op == "LTE" or op == "GTE" or op == "<" or op == ">" or op == "<=" or op == ">=" { return 40 }
        if op == "PLUS" or op == "MINUS" or op == "+" or op == "-" { return 50 }
        if op == "MUL" or op == "DIV" or op == "MOD" or op == "*" or op == "/" or op == "%" { return 60 }
        return 0
    }

    fn parse_expr(self, min_prec: int) -> ASTNode {
        var left = self.parse_unary()

        while true {
            var tok = self.current()
            var prec = self.get_prec(tok.type_name)
            if prec <= min_prec {
                break
            }
            self.advance()
            var right = self.parse_expr(prec)
            left = ASTNode("BinaryOp", "", "", tok.value, "", false, false, false, false, [], [], [left, right], tok.line, tok.col)
        }
        return left
    }

    fn parse_statement(self) -> ASTNode {
        var tok = self.current()

        // Directives
        if tok.type_name == "TARGET" {
            self.advance()
            self.match_type("SEMICOLON")
            return ASTNode("Directive", "target", tok.value, "", "", false, false, false, false, [], [], [], tok.line, tok.col)
        }
        if tok.type_name == "NATIVE_INCLUDE" {
            self.advance()
            self.match_type("SEMICOLON")
            return ASTNode("Directive", "native_include", tok.value, "", "", false, false, false, false, [], [], [], tok.line, tok.col)
        }
        if tok.type_name == "NATIVE_LINK" {
            self.advance()
            self.match_type("SEMICOLON")
            return ASTNode("Directive", "native_link", tok.value, "", "", false, false, false, false, [], [], [], tok.line, tok.col)
        }
        if tok.type_name == "NATIVE_USE" {
            self.advance()
            self.match_type("SEMICOLON")
            return ASTNode("Directive", "native_use", tok.value, "", "", false, false, false, false, [], [], [], tok.line, tok.col)
        }
        if tok.type_name == "NATIVE_RAW" {
            self.advance()
            self.match_type("SEMICOLON")
            return ASTNode("Directive", "native_raw", tok.value, "", "", false, false, false, false, [], [], [], tok.line, tok.col)
        }

        // Variable declaration
        if tok.type_name == "VAR" or tok.type_name == "LET" or tok.type_name == "CONST" {
            var is_const = (tok.type_name == "CONST")
            self.advance()
            var name = self.expect("IDENT").value
            var type_annot = ""
            if self.match_type("COLON") {
                type_annot = self.parse_type()
            }
            var init_expr = ASTNode("Null", "", "", "", "", false, false, false, false, [], [], [], tok.line, tok.col)
            if self.match_type("ASSIGN") {
                init_expr = self.parse_expr(0)
            } else {
                if self.current().type_name != "SEMICOLON" {
                    self.has_error = true
                    self.error_msg = "Expected '=' after variable name at line " + to_string(tok.line) + ":" + to_string(tok.col)
                }
            }
            self.match_type("SEMICOLON")
            return ASTNode("VarDecl", name, "", "", type_annot, is_const, false, false, false, [], [], [init_expr], tok.line, tok.col)
        }

        // Function definition
        if tok.type_name == "FN" {
            self.advance()
            var name = self.expect("IDENT").value
            self.expect("LPAREN")
            var params: Array<FunctionParam> = []
            if not self.match_type("RPAREN") {
                while true {
                    var pname = self.expect("IDENT").value
                    var ptype = ""
                    if self.match_type("COLON") {
                        ptype = self.parse_type()
                    }
                    params.push(FunctionParam(pname, ptype))
                    if self.match_type("COMMA") { continue }
                    self.expect("RPAREN")
                    break
                }
            }
            var ret_type = "void"
            if self.match_type("ARROW") {
                ret_type = self.parse_type()
            }
            var body: Array<ASTNode> = []
            if self.match_type("LBRACE") {
                var closed = false
                while self.current().type_name != "EOF" {
                    if self.match_type("RBRACE") {
                        closed = true
                        break
                    }
                    body.push(self.parse_statement())
                }
                if not closed {
                    self.has_error = true
                    self.error_msg = "Unclosed function body block: expected '}'"
                }
            }
            return ASTNode("FunctionDef", name, "", "", ret_type, false, false, false, false, params, [], body, tok.line, tok.col)
        }

        // Struct definition
        if tok.type_name == "STRUCT" {
            self.advance()
            var name = self.expect("IDENT").value
            var fields: Array<FunctionParam> = []
            if self.match_type("LBRACE") {
                var closed = false
                while self.current().type_name != "EOF" {
                    if self.match_type("RBRACE") {
                        closed = true
                        break
                    }
                    var fname = self.expect("IDENT").value
                    self.expect("COLON")
                    var ftype = self.parse_type()
                    fields.push(FunctionParam(fname, ftype))
                    self.match_type("COMMA")
                }
                if not closed {
                    self.has_error = true
                    self.error_msg = "Unclosed struct definition block: expected '}'"
                }
            }
            return ASTNode("StructDef", name, "", "", "", false, false, false, false, fields, [], [], tok.line, tok.col)
        }

        // Impl block
        if tok.type_name == "IMPL" {
            self.advance()
            var target = self.expect("IDENT").value
            var methods: Array<ASTNode> = []
            if self.match_type("LBRACE") {
                while not self.match_type("RBRACE") and self.current().type_name != "EOF" {
                    methods.push(self.parse_statement())
                }
            }
            return ASTNode("ImplBlock", target, "", "", "", false, false, false, false, [], [], methods, tok.line, tok.col)
        }

        // Trait definition
        if tok.type_name == "TRAIT" {
            self.advance()
            var name = self.expect("IDENT").value
            var methods: Array<ASTNode> = []
            if self.match_type("LBRACE") {
                while not self.match_type("RBRACE") and self.current().type_name != "EOF" {
                    methods.push(self.parse_statement())
                }
            }
            return ASTNode("TraitDef", name, "", "", "", false, false, false, false, [], [], methods, tok.line, tok.col)
        }

        // Extern C function declaration
        if tok.type_name == "EXTERN" {
            self.advance()
            var abi = self.expect("STRING").value
            self.expect("FN")
            var name = self.expect("IDENT").value
            self.expect("LPAREN")
            var params: Array<FunctionParam> = []
            if not self.match_type("RPAREN") {
                while true {
                    var pname = self.expect("IDENT").value
                    self.expect("COLON")
                    var ptype = self.parse_type()
                    params.push(FunctionParam(pname, ptype))
                    if self.match_type("COMMA") { continue }
                    self.expect("RPAREN")
                    break
                }
            }
            var ret_type = "void"
            if self.match_type("ARROW") {
                ret_type = self.parse_type()
            }
            self.match_type("SEMICOLON")
            return ASTNode("ExternFn", name, abi, "", ret_type, false, false, false, false, params, [], [], tok.line, tok.col)
        }

        // Return
        if tok.type_name == "RETURN" {
            self.advance()
            var expr = ASTNode("Null", "", "", "", "", false, false, false, false, [], [], [], tok.line, tok.col)
            if self.current().type_name != "SEMICOLON" and self.current().type_name != "RBRACE" {
                expr = self.parse_expr(0)
            }
            self.match_type("SEMICOLON")
            return ASTNode("Return", "", "", "", "", false, false, false, false, [], [], [expr], tok.line, tok.col)
        }

        // Break & Continue
        if tok.type_name == "BREAK" {
            self.advance()
            self.match_type("SEMICOLON")
            return ASTNode("Break", "", "", "", "", false, false, false, false, [], [], [], tok.line, tok.col)
        }
        if tok.type_name == "CONTINUE" {
            self.advance()
            self.match_type("SEMICOLON")
            return ASTNode("Continue", "", "", "", "", false, false, false, false, [], [], [], tok.line, tok.col)
        }

        // If statement
        if tok.type_name == "IF" {
            self.advance()
            var cond = self.parse_expr(0)
            var then_body: Array<ASTNode> = []
            if self.match_type("LBRACE") {
                while not self.match_type("RBRACE") and self.current().type_name != "EOF" {
                    then_body.push(self.parse_statement())
                }
            }
            var children: Array<ASTNode> = [cond]
            for s in then_body { children.push(s) }

            if self.match_type("ELSE") {
                var else_body: Array<ASTNode> = []
                if self.match_type("LBRACE") {
                    while not self.match_type("RBRACE") and self.current().type_name != "EOF" {
                        else_body.push(self.parse_statement())
                    }
                }
                var else_node = ASTNode("ElseBlock", "", "", "", "", false, false, false, false, [], [], else_body, tok.line, tok.col)
                children.push(else_node)
            }
            return ASTNode("If", "", "", "", "", false, false, false, false, [], [], children, tok.line, tok.col)
        }

        // While loop
        if tok.type_name == "WHILE" {
            self.advance()
            var cond = self.parse_expr(0)
            var body: Array<ASTNode> = []
            if self.match_type("LBRACE") {
                while not self.match_type("RBRACE") and self.current().type_name != "EOF" {
                    body.push(self.parse_statement())
                }
            }
            var children: Array<ASTNode> = [cond]
            for s in body { children.push(s) }
            return ASTNode("While", "", "", "", "", false, false, false, false, [], [], children, tok.line, tok.col)
        }

        // For loop
        if tok.type_name == "FOR" {
            self.advance()
            var var_name = self.expect("IDENT").value
            self.expect("IN")
            var range_start = self.parse_expr(0)
            var range_end = ASTNode("Null", "", "", "", "", false, false, false, false, [], [], [], tok.line, tok.col)
            if self.match_type("DOTDOT") {
                range_end = self.parse_expr(0)
            }
            var body: Array<ASTNode> = []
            if self.match_type("LBRACE") {
                while not self.match_type("RBRACE") and self.current().type_name != "EOF" {
                    body.push(self.parse_statement())
                }
            }
            var children: Array<ASTNode> = [range_start, range_end]
            for s in body { children.push(s) }
            return ASTNode("For", var_name, "", "", "", false, false, false, false, [], [], children, tok.line, tok.col)
        }

        // Loop infinite loop
        if tok.type_name == "LOOP" {
            self.advance()
            var body: Array<ASTNode> = []
            if self.match_type("LBRACE") {
                while not self.match_type("RBRACE") and self.current().type_name != "EOF" {
                    body.push(self.parse_statement())
                }
            }
            return ASTNode("Loop", "", "", "", "", false, false, false, false, [], [], body, tok.line, tok.col)
        }

        // Unsafe block
        if tok.type_name == "UNSAFE" {
            self.advance()
            var body: Array<ASTNode> = []
            if self.match_type("LBRACE") {
                while not self.match_type("RBRACE") and self.current().type_name != "EOF" {
                    body.push(self.parse_statement())
                }
            }
            return ASTNode("UnsafeBlock", "", "", "", "", false, false, false, false, [], [], body, tok.line, tok.col)
        }

        // Spawn block
        if tok.type_name == "SPAWN" {
            self.advance()
            var body: Array<ASTNode> = []
            if self.match_type("LBRACE") {
                while not self.match_type("RBRACE") and self.current().type_name != "EOF" {
                    body.push(self.parse_statement())
                }
            }
            return ASTNode("Spawn", "", "", "", "", false, false, false, false, [], [], body, tok.line, tok.col)
        }

        // Match statement
        if tok.type_name == "MATCH" {
            self.advance()
            var target = self.parse_expr(0)
            var cases: Array<ASTNode> = []
            if self.match_type("LBRACE") {
                while not self.match_type("RBRACE") and self.current().type_name != "EOF" {
                    var pattern = self.parse_expr(0)
                    self.expect("FAT_ARROW")
                    var case_body: Array<ASTNode> = []
                    if self.match_type("LBRACE") {
                        while not self.match_type("RBRACE") and self.current().type_name != "EOF" {
                            case_body.push(self.parse_statement())
                        }
                    } else {
                        case_body.push(self.parse_statement())
                    }
                    var case_node = ASTNode("MatchCase", "", "", "", "", false, false, false, false, [], [], case_body, pattern.line, pattern.col)
                    cases.push(pattern)
                    cases.push(case_node)
                }
            }
            var children: Array<ASTNode> = [target]
            for c in cases { children.push(c) }
            return ASTNode("Match", "", "", "", "", false, false, false, false, [], [], children, tok.line, tok.col)
        }

        // General expression / assignment statement
        var expr = self.parse_expr(0)
        if self.match_type("ASSIGN") {
            var val_expr = self.parse_expr(0)
            self.match_type("SEMICOLON")
            return ASTNode("Assign", "", "", "=", "", false, false, false, false, [], [], [expr, val_expr], tok.line, tok.col)
        }
        self.match_type("SEMICOLON")
        return expr
    }

    fn parse_program(self) -> ASTNode {
        var stmts: Array<ASTNode> = []
        while self.current().type_name != "EOF" {
            while self.match_type("SEMICOLON") { }
            if self.current().type_name == "EOF" { break }
            stmts.push(self.parse_statement())
        }
        return ASTNode("Program", "main", "", "", "", false, false, false, false, [], [], stmts, 1, 1)
    }
}

struct Symbol {
    name: string,
    type_name: string
}

struct StructFieldInfo {
    struct_name: string,
    field_name: string,
    field_type: string
}

struct FunctionSignature {
    name: string,
    param_types: Array<string>,
    return_type: string
}

struct Scope {
    symbols: Array<Symbol>,
    depth: int
}

struct TypeChecker {
    scopes: Array<Scope>,
    struct_fields: Array<StructFieldInfo>,
    functions: Array<FunctionSignature>,
    current_fn_return_type: string,
    has_error: bool,
    error_msg: string
}

impl TypeChecker {
    fn enter_scope(self) {
        var d = len(self.scopes)
        self.scopes.push(Scope([], d))
    }

    fn exit_scope(self) {
        if len(self.scopes) > 1 {
            // pop current scope by creating a new array of length - 1
            var next_scopes: Array<Scope> = []
            for i in 0..len(self.scopes)-2 {
                next_scopes.push(self.scopes[i])
            }
            self.scopes = next_scopes
        }
    }

    fn register_symbol(self, name: string, type_name: string) {
        if len(self.scopes) == 0 {
            self.enter_scope()
        }
        var top_idx = len(self.scopes) - 1
        for i in 0..len(self.scopes[top_idx].symbols)-1 {
            if self.scopes[top_idx].symbols[i].name == name {
                self.scopes[top_idx].symbols[i].type_name = type_name
                return
            }
        }
        self.scopes[top_idx].symbols.push(Symbol(name, type_name))
    }

    fn lookup_symbol(self, name: string) -> string {
        // Search from innermost scope to outermost
        var s_idx = len(self.scopes) - 1
        while s_idx >= 0 {
            var syms = self.scopes[s_idx].symbols
            for i in 0..len(syms)-1 {
                if syms[i].name == name {
                    return syms[i].type_name
                }
            }
            s_idx = s_idx - 1
        }
        return ""
    }

    fn register_function(self, name: string, ptypes: Array<string>, ret: string) {
        self.functions.push(FunctionSignature(name, ptypes, ret))
        self.register_symbol(name, ret)
    }

    fn lookup_function(self, name: string) -> FunctionSignature {
        for i in 0..len(self.functions)-1 {
            if self.functions[i].name == name {
                return self.functions[i]
            }
        }
        return FunctionSignature("", [], "")
    }

    fn register_struct_field(self, sname: string, fname: string, ftype: string) {
        self.struct_fields.push(StructFieldInfo(sname, fname, ftype))
    }

    fn lookup_struct_field(self, sname: string, fname: string) -> string {
        for i in 0..len(self.struct_fields)-1 {
            if self.struct_fields[i].struct_name == sname and self.struct_fields[i].field_name == fname {
                return self.struct_fields[i].field_type
            }
        }
        return ""
    }

    fn is_compatible(self, expected: string, found: string) -> bool {
        if expected == "" or expected == "any" or found == "any" { return true }
        if expected == found { return true }
        // float accepts int
        if expected == "float" and found == "int" { return true }
        // optional accepts null or base type
        if len(expected) > 1 and expected[len(expected)-1] == "?" {
            if found == "null" { return true }
            var base = ""
            for i in 0..len(expected)-2 { base = base + expected[i] }
            if base == found { return true }
        }
        return false
    }

    fn infer_type(self, node: ASTNode) -> string {
        if node.kind == "Number" {
            if contains(node.value, ".") { return "float" }
            return "int"
        }
        if node.kind == "String" { return "string" }
        if node.kind == "Boolean" { return "bool" }
        if node.kind == "Null" { return "null" }
        
        if node.kind == "Identifier" {
            var t = self.lookup_symbol(node.name)
            if t != "" { return t }
            self.has_error = true
            self.error_msg = "Undefined variable: '" + node.name + "' at line " + to_string(node.line) + ":" + to_string(node.col)
            return "any"
        }

        if node.kind == "BinaryOp" {
            if node.op == "==" or node.op == "!=" or node.op == "<" or node.op == ">" or node.op == "<=" or node.op == ">=" or node.op == "and" or node.op == "or" {
                return "bool"
            }
            if len(node.children) >= 2 {
                var lt = self.infer_type(node.children[0])
                var rt = self.infer_type(node.children[1])
                if lt == "float" or rt == "float" { return "float" }
                if lt == "string" or rt == "string" { return "string" }
                return lt
            }
            return "int"
        }

        if node.kind == "UnaryOp" {
            if node.op == "not" or node.op == "!" { return "bool" }
            if len(node.children) > 0 { return self.infer_type(node.children[0]) }
            return "int"
        }

        if node.kind == "FunctionCall" {
            if node.name == "print" { return "void" }
            if node.name == "to_string" or node.name == "to_str" { return "string" }
            if node.name == "to_int" { return "int" }
            if node.name == "addr" or node.name == "peek" { return "int" }
            
            var fn_sig = self.lookup_function(node.name)
            if fn_sig.name != "" {
                if len(node.children) != len(fn_sig.param_types) {
                    self.has_error = true
                    self.error_msg = "Function '" + node.name + "' expected " + to_string(len(fn_sig.param_types)) + " arguments but got " + to_string(len(node.children))
                } else {
                    for i in 0..len(node.children)-1 {
                        var arg_t = self.infer_type(node.children[i])
                        if not self.is_compatible(fn_sig.param_types[i], arg_t) {
                            self.has_error = true
                            self.error_msg = "Argument " + to_string(i+1) + " type mismatch in '" + node.name + "': expected " + fn_sig.param_types[i] + " but got " + arg_t
                        }
                    }
                }
                return fn_sig.return_type
            }

            var fn_t = self.lookup_symbol(node.name)
            if fn_t != "" { return fn_t }
            return "any"
        }

        if node.kind == "MemberAccess" {
            if len(node.children) > 0 {
                var obj_t = self.infer_type(node.children[0])
                var field_t = self.lookup_struct_field(obj_t, node.name)
                if field_t != "" { return field_t }
            }
            return "any"
        }

        if node.kind == "Array" {
            if len(node.children) > 0 {
                var elem_t = self.infer_type(node.children[0])
                return "Array<" + elem_t + ">"
            }
            return "Array<any>"
        }

        if node.kind == "IndexAccess" {
            if len(node.children) > 0 {
                var arr_t = self.infer_type(node.children[0])
                if arr_t == "string" { return "string" }
                if len(arr_t) > 7 and arr_t[0] == "A" and arr_t[1] == "r" {
                    var inner = ""
                    for i in 6..len(arr_t)-2 { inner = inner + arr_t[i] }
                    return inner
                }
            }
            return "any"
        }

        return "any"
    }

    fn check_statement(self, node: ASTNode) {
        if node.kind == "VarDecl" {
            var inferred = "any"
            if len(node.children) > 0 {
                inferred = self.infer_type(node.children[0])
            }
            var decl_type = node.type_name
            if decl_type != "" {
                if not self.is_compatible(decl_type, inferred) {
                    self.has_error = true
                    self.error_msg = "Type mismatch in variable '" + node.name + "': expected " + decl_type + " but found " + inferred
                }
            } else {
                decl_type = inferred
            }
            self.register_symbol(node.name, decl_type)
            return
        }

        if node.kind == "Assign" {
            if len(node.children) >= 2 {
                var target_t = self.infer_type(node.children[0])
                var val_t = self.infer_type(node.children[1])
                if not self.is_compatible(target_t, val_t) {
                    self.has_error = true
                    self.error_msg = "Cannot assign type " + val_t + " to " + target_t
                }
            }
            return
        }

        if node.kind == "StructDef" {
            for i in 0..len(node.params)-1 {
                self.register_struct_field(node.name, node.params[i].name, node.params[i].type_annot)
            }
            return
        }

        if node.kind == "FunctionDef" {
            var param_types: Array<string> = []
            for i in 0..len(node.params)-1 {
                param_types.push(node.params[i].type_annot)
            }
            self.register_function(node.name, param_types, node.type_name)

            var prev_ret = self.current_fn_return_type
            self.current_fn_return_type = node.type_name

            self.enter_scope()
            for i in 0..len(node.params)-1 {
                self.register_symbol(node.params[i].name, node.params[i].type_annot)
            }

            for i in 0..len(node.children)-1 {
                self.check_statement(node.children[i])
            }
            self.exit_scope()

            self.current_fn_return_type = prev_ret
            return
        }

        if node.kind == "Return" {
            var ret_val_type = "void"
            if len(node.children) > 0 and node.children[0].kind != "Null" {
                ret_val_type = self.infer_type(node.children[0])
            }
            if self.current_fn_return_type != "" and self.current_fn_return_type != "void" {
                if not self.is_compatible(self.current_fn_return_type, ret_val_type) {
                    self.has_error = true
                    self.error_msg = "Return type mismatch: expected " + self.current_fn_return_type + " but returned " + ret_val_type
                }
            }
            return
        }

        if node.kind == "If" or node.kind == "While" {
            self.enter_scope()
            for i in 1..len(node.children)-1 {
                self.check_statement(node.children[i])
            }
            self.exit_scope()
            return
        }

        if node.kind == "For" {
            self.enter_scope()
            self.register_symbol(node.name, "int")
            for i in 2..len(node.children)-1 {
                self.check_statement(node.children[i])
            }
            self.exit_scope()
            return
        }

        // Generic expression statement
        self.infer_type(node)
    }

    fn check_program(self, ast: ASTNode) -> bool {
        self.enter_scope()
        self.register_symbol("print", "void")
        self.register_symbol("to_string", "string")
        self.register_symbol("to_str", "string")
        self.register_symbol("to_int", "int")
        self.register_symbol("addr", "int")
        self.register_symbol("peek", "int")

        for i in 0..len(ast.children)-1 {
            self.check_statement(ast.children[i])
        }
        return not self.has_error
    }
}

// =========================================================
// NYX SELF-HOSTING C++20 CODE GENERATOR (PHASE 4.0.7)
// =========================================================

struct CodeGen {
    indent_level: int,
    output: string,
    in_function: bool
}

impl CodeGen {
    fn create() -> CodeGen {
        return CodeGen(0, "", false)
    }

    fn emit(self, s: string) {
        self.output = self.output + s
    }

    fn emit_line(self, s: string) {
        var indent = ""
        for i in 0..self.indent_level-1 {
            indent = indent + "    "
        }
        self.output = self.output + indent + s + "\n"
    }

    fn map_type(self, t: string) -> string {
        if t == "int" { return "int64_t" }
        if t == "float" { return "double" }
        if t == "string" { return "std::string" }
        if t == "bool" { return "bool" }
        if t == "void" { return "void" }
        if t == "" { return "auto" }
        return t
    }

    fn gen_expr(self, node: ASTNode) -> string {
        if node.kind == "Number" {
            return node.value
        }
        if node.kind == "String" {
            return "\"" + node.value + "\""
        }
        if node.kind == "Boolean" {
            return node.value
        }
        if node.kind == "Identifier" {
            return node.name
        }
        if node.kind == "BinaryOp" {
            if len(node.children) >= 2 {
                var left = self.gen_expr(node.children[0])
                var right = self.gen_expr(node.children[1])
                return "(" + left + " " + node.op + " " + right + ")"
            }
        }
        if node.kind == "UnaryOp" {
            if len(node.children) >= 1 {
                var inner = self.gen_expr(node.children[0])
                return "(" + node.op + inner + ")"
            }
        }
        if node.kind == "FunctionCall" {
            var args_str = ""
            for i in 0..len(node.children)-1 {
                if i > 0 { args_str = args_str + ", " }
                args_str = args_str + self.gen_expr(node.children[i])
            }
            if node.name == "print" || node.name == "println" {
                return "std::cout << " + args_str + " << std::endl"
            }
            if node.name == "len" {
                return args_str + ".size()"
            }
            return node.name + "(" + args_str + ")"
        }
        if node.kind == "Array" {
            var elems = ""
            for i in 0..len(node.children)-1 {
                if i > 0 { elems = elems + ", " }
                elems = elems + self.gen_expr(node.children[i])
            }
            return "{" + elems + "}"
        }
        if node.kind == "IndexAccess" {
            if len(node.children) >= 2 {
                var arr = self.gen_expr(node.children[0])
                var idx = self.gen_expr(node.children[1])
                return arr + "[" + idx + "]"
            }
        }
        if node.kind == "MemberAccess" {
            if len(node.children) >= 1 {
                var obj = self.gen_expr(node.children[0])
                return obj + "." + node.name
            }
        }
        return ""
    }

    fn gen_stmt(self, node: ASTNode) {
        if node.kind == "VarDecl" {
            var cpp_type = self.map_type(node.type_name)
            var init_str = ""
            if len(node.children) > 0 {
                init_str = " = " + self.gen_expr(node.children[0])
            }
            if node.is_const {
                self.emit_line("const " + cpp_type + " " + node.name + init_str + ";")
            } else {
                self.emit_line(cpp_type + " " + node.name + init_str + ";")
            }
            return
        }

        if node.kind == "Assign" {
            if len(node.children) >= 1 {
                var val = self.gen_expr(node.children[0])
                self.emit_line(node.name + " = " + val + ";")
            }
            return
        }

        if node.kind == "If" {
            if len(node.children) >= 1 {
                var cond = self.gen_expr(node.children[0])
                self.emit_line("if (" + cond + ") {")
                self.indent_level = self.indent_level + 1
                for i in 1..len(node.children)-1 {
                    self.gen_stmt(node.children[i])
                }
                self.indent_level = self.indent_level - 1
                self.emit_line("}")
            }
            return
        }

        if node.kind == "While" {
            if len(node.children) >= 1 {
                var cond = self.gen_expr(node.children[0])
                self.emit_line("while (" + cond + ") {")
                self.indent_level = self.indent_level + 1
                for i in 1..len(node.children)-1 {
                    self.gen_stmt(node.children[i])
                }
                self.indent_level = self.indent_level - 1
                self.emit_line("}")
            }
            return
        }

        if node.kind == "Return" {
            if len(node.children) > 0 {
                var val = self.gen_expr(node.children[0])
                self.emit_line("return " + val + ";")
            } else {
                self.emit_line("return;")
            }
            return
        }

        if node.kind == "FunctionCall" {
            var expr = self.gen_expr(node)
            self.emit_line(expr + ";")
            return
        }

        if node.kind == "FunctionDef" {
            var ret_type = self.map_type(node.type_name)
            var fn_name = node.name
            if fn_name == "main" {
                ret_type = "int"
            }
            var params_str = ""
            for i in 0..len(node.params)-1 {
                if i > 0 { params_str = params_str + ", " }
                var p = node.params[i]
                params_str = params_str + self.map_type(p.type_annot) + " " + p.name
            }
            self.emit_line(ret_type + " " + fn_name + "(" + params_str + ") {")
            self.indent_level = self.indent_level + 1
            for i in 0..len(node.children)-1 {
                self.gen_stmt(node.children[i])
            }
            if fn_name == "main" {
                self.emit_line("return 0;")
            }
            self.indent_level = self.indent_level - 1
            self.emit_line("}")
            self.emit_line("")
            return
        }
    }

    fn generate(self, stmts: Array<ASTNode>) -> string {
        self.output = ""
        self.emit_line("// Auto-generated by Rove Self-Hosting Compiler (Stage 1)")
        self.emit_line("#include <iostream>")
        self.emit_line("#include <string>")
        self.emit_line("#include <vector>")
        self.emit_line("#include <cstdint>")
        self.emit_line("")

        for i in 0..len(stmts)-1 {
            self.gen_stmt(stmts[i])
        }

        return self.output
    }
}

struct WasmEmitter {
    bytes: Array<int>,
    dummy: int
}

impl WasmEmitter {
    fn emit_byte(self, b: int) {
        self.bytes = self.bytes + [b];
    }

    fn emit_u32(self, val: int) {
        var v = val;
        while true {
            var b = v % 128;
            v = v / 128;
            if v > 0 {
                self.emit_byte(b + 128);
            } else {
                self.emit_byte(b);
                break;
            }
        }
    }

    fn emit_magic_and_version(self) {
        self.emit_byte(0);
        self.emit_byte(97);
        self.emit_byte(115);
        self.emit_byte(109);
        self.emit_byte(1);
        self.emit_byte(0);
        self.emit_byte(0);
        self.emit_byte(0);
    }

    fn generate(self, stmts: Array<ASTNode>) -> Array<int> {
        var empty: Array<int> = [];
        self.bytes = empty;
        self.emit_magic_and_version();

        // 1. Type Section (id = 1)
        self.emit_byte(1);
        self.emit_u32(11);
        self.emit_u32(2);
        
        // type 0: (i32, i32) -> i32 (for add)
        self.emit_byte(96);
        self.emit_u32(2);
        self.emit_byte(127);
        self.emit_byte(127);
        self.emit_u32(1);
        self.emit_byte(127);
        
        // type 1: () -> i32 (for main)
        self.emit_byte(96);
        self.emit_u32(0);
        self.emit_u32(1);
        self.emit_byte(127);

        // 2. Function Section (id = 3)
        self.emit_byte(3);
        self.emit_u32(3);
        self.emit_u32(2);
        self.emit_u32(0);
        self.emit_u32(1);

        // 3. Export Section (id = 7)
        self.emit_byte(7);
        self.emit_u32(8);
        self.emit_u32(1);
        self.emit_u32(4);
        self.emit_byte(109);
        self.emit_byte(97);
        self.emit_byte(105);
        self.emit_byte(110);
        self.emit_byte(0);
        self.emit_u32(1);

        // 4. Code Section (id = 10)
        self.emit_byte(10);
        self.emit_u32(18);
        self.emit_u32(2);

        // Function 0 (add): local.get 0, local.get 1, i32.add, end
        self.emit_u32(7);
        self.emit_u32(0); 
        self.emit_byte(32); 
        self.emit_u32(0); 
        self.emit_byte(32); 
        self.emit_u32(1); 
        self.emit_byte(106); 
        self.emit_byte(11); 

        // Function 1 (main): i32.const 10, i32.const 20, call 0, end
        self.emit_u32(8);
        self.emit_u32(0); 
        self.emit_byte(65); 
        self.emit_u32(10); 
        self.emit_byte(65); 
        self.emit_u32(20); 
        self.emit_byte(16); 
        self.emit_u32(0); 
        self.emit_byte(11); 

        return self.bytes;
    }
}

fn main() {
    var code = "fn add(a: int, b: int) -> int { return a + b; } fn main() -> int { var x: int = 10; return add(x, 20); }"
    print("--- Lexing ---")
    var lex = Lexer(lexer_characters(code), 0, 1, 1)
    var tokens = lex.tokenize()
    
    print("--- Parsing ---")
    var parser = Parser(tokens, 0, false, "")
    var ast = parser.parse_program()
    if parser.has_error {
        print("PARSE ERROR:", parser.error_msg)
    } else {
        print(ast.to_str())
    }
    
    print("--- Type Checking ---")
    var tc = TypeChecker([], [], [], [], "", false, "")
    var valid = tc.check_program(ast)
    if tc.has_error {
        print("TYPE ERROR:", tc.error_msg)
    } else {
        print("Type checking passed.")
    }

    print("--- Code Generation ---")
    var cg = CodeGen(0, "", false)
    var cpp_code = cg.generate(ast.children)
    print(cpp_code)
    
    print("--- WASM Generation ---")
    var we = WasmEmitter([], 0)
    var wasm_bytes = we.generate(ast.children)
    print("Generated " + to_string(len(wasm_bytes)) + " bytes of WASM.")
    
    // Dump bytes to stdout so we can capture it or write to file via python
    var out_str = "WASM_BYTES:"
    for i in 0..len(wasm_bytes)-1 {
        out_str = out_str + to_string(wasm_bytes[i]) + ","
    }
    print(out_str)
}
main()
