#target cpp
#native include <string>
#native include <vector>

// Canonical typed HIR schema v1. The tagged HIRNode representation keeps the
// Rove implementation self-hostable while preserving the exact public JSON
// contract of src/ir/model.py.

fn hir_json_control_escape(ch: string) -> string {
    var controls = "\0\u0001\u0002\u0003\u0004\u0005\u0006\u0007\u0008\u0009\u000a\u000b\u000c\u000d\u000e\u000f\u0010\u0011\u0012\u0013\u0014\u0015\u0016\u0017\u0018\u0019\u001a\u001b\u001c\u001d\u001e\u001f"
    var digits = "0123456789abcdef"
    for code in 0..31 {
        if controls[code] == ch {
            if code == 8 { return "\\b" }
            if code == 9 { return "\\t" }
            if code == 10 { return "\\n" }
            if code == 12 { return "\\f" }
            if code == 13 { return "\\r" }
            return "\\u00" + digits[code / 16] + digits[code % 16]
        }
    }
    return ""
}

fn hir_json_escape(value: string) -> string {
    var result = ""
    for i in 0..len(value)-1 {
        var ch = value[i]
        if ch == "\\" { result = result + "\\\\" }
        elif ch == "\"" { result = result + "\\\"" }
        else {
            var control_escape = hir_json_control_escape(ch)
            if control_escape != "" { result = result + control_escape }
            else { result = result + ch }
        }
    }
    return result
}

fn hir_json_quote(value: string) -> string {
    return "\"" + hir_json_escape(value) + "\""
}

struct HIRSpan {
    source: string,
    line: int,
    column: int,
    length: int
}

impl HIRSpan {
    fn to_json(self) -> string {
        return "{\"column\":" + to_string(self.column) +
            ",\"length\":" + to_string(self.length) +
            ",\"line\":" + to_string(self.line) +
            ",\"node\":\"SourceSpan\",\"source\":" + hir_json_quote(self.source) + "}"
    }
}

struct HIRType {
    name: string,
    arguments: Array<HIRType>,
    optional: bool,
    pointer: bool,
    parameter_types: Array<HIRType>,
    return_types: Array<HIRType>
}

impl HIRType {
    fn canonical(self) -> string {
        var result = self.name
        if len(self.return_types) > 0 {
            var params = ""
            for i in 0..len(self.parameter_types)-1 {
                if i > 0 { params = params + "," }
                params = params + self.parameter_types[i].canonical()
            }
            result = "fn(" + params + ")->" + self.return_types[0].canonical()
        } else {
            if len(self.arguments) > 0 {
                result = result + "<"
                for i in 0..len(self.arguments)-1 {
                    if i > 0 { result = result + "," }
                    result = result + self.arguments[i].canonical()
                }
                result = result + ">"
            }
            if self.pointer { result = "*" + result }
        }
        if self.optional { result = result + "?" }
        return result
    }

    fn list_json(self, values: Array<HIRType>) -> string {
        var result = "["
        for i in 0..len(values)-1 {
            if i > 0 { result = result + "," }
            result = result + values[i].to_json()
        }
        return result + "]"
    }

    fn to_json(self) -> string {
        var return_json = "null"
        if len(self.return_types) > 0 { return_json = self.return_types[0].to_json() }
        return "{\"arguments\":" + self.list_json(self.arguments) +
            ",\"name\":" + hir_json_quote(self.name) +
            ",\"node\":\"IRType\",\"optional\":" + to_string(self.optional) +
            ",\"parameter_types\":" + self.list_json(self.parameter_types) +
            ",\"pointer\":" + to_string(self.pointer) +
            ",\"return_type\":" + return_json + "}"
    }
}

struct HIRNode {
    kind: string,
    span: HIRSpan,
    type_info: HIRType,
    has_type: bool,
    return_type: HIRType,
    has_return_type: bool,
    name: string,
    symbol: string,
    value: string,
    value_kind: string,
    op: string,
    aux_name: string,
    aux_symbol: string,
    flag_a: bool,
    flag_b: bool,
    first: Array<HIRNode>,
    second: Array<HIRNode>,
    third: Array<HIRNode>,
    items: Array<HIRNode>,
    strings: Array<string>
}

impl HIRNode {
    fn nodes_json(self, values: Array<HIRNode>) -> string {
        var result = "["
        for i in 0..len(values)-1 {
            if i > 0 { result = result + "," }
            result = result + values[i].to_json()
        }
        return result + "]"
    }

    fn strings_json(self, values: Array<string>) -> string {
        var result = "["
        for i in 0..len(values)-1 {
            if i > 0 { result = result + "," }
            result = result + hir_json_quote(values[i])
        }
        return result + "]"
    }

    fn node_types_json(self, values: Array<HIRNode>) -> string {
        var result = "["
        for i in 0..len(values)-1 {
            if i > 0 { result = result + "," }
            result = result + values[i].type_info.to_json()
        }
        return result + "]"
    }

    fn optional_node_json(self, values: Array<HIRNode>) -> string {
        if len(values) == 0 { return "null" }
        return values[0].to_json()
    }

    fn type_json(self) -> string {
        if not self.has_type { return "null" }
        return self.type_info.to_json()
    }

    fn return_type_json(self) -> string {
        if not self.has_return_type { return "null" }
        return self.return_type.to_json()
    }

    fn literal_json(self) -> string {
        if self.value_kind == "string" { return hir_json_quote(self.value) }
        if self.value_kind == "bool" { return self.value }
        if self.value_kind == "null" { return "null" }
        return self.value
    }

    fn branches_json(self) -> string {
        var result = "["
        for i in 0..len(self.items)-1 {
            if i > 0 { result = result + "," }
            var branch = self.items[i]
            result = result + "[" + branch.first[0].to_json() + "," + branch.nodes_json(branch.second) + "]"
        }
        return result + "]"
    }

    fn to_json(self) -> string {
        var span_json = self.span.to_json()
        var type_json = self.type_json()

        if self.kind == "IRLiteral" {
            return "{\"node\":\"IRLiteral\",\"span\":" + span_json +
                ",\"type\":" + type_json + ",\"value\":" + self.literal_json() + "}"
        }
        if self.kind == "IRReference" {
            return "{\"name\":" + hir_json_quote(self.name) +
                ",\"node\":\"IRReference\",\"span\":" + span_json +
                ",\"symbol\":" + hir_json_quote(self.symbol) +
                ",\"type\":" + type_json + "}"
        }
        if self.kind == "IRBinary" {
            return "{\"left\":" + self.first[0].to_json() +
                ",\"node\":\"IRBinary\",\"op\":" + hir_json_quote(self.op) +
                ",\"right\":" + self.second[0].to_json() +
                ",\"span\":" + span_json + ",\"type\":" + type_json + "}"
        }
        if self.kind == "IRUnary" {
            return "{\"expr\":" + self.first[0].to_json() +
                ",\"node\":\"IRUnary\",\"op\":" + hir_json_quote(self.op) +
                ",\"span\":" + span_json + ",\"type\":" + type_json + "}"
        }
        if self.kind == "IRAwait" {
            return "{\"expr\":" + self.first[0].to_json() +
                ",\"node\":\"IRAwait\",\"span\":" + span_json +
                ",\"type\":" + type_json + "}"
        }
        if self.kind == "IRResultPropagate" {
            return "{\"expr\":" + self.first[0].to_json() +
                ",\"node\":\"IRResultPropagate\",\"span\":" + span_json +
                ",\"type\":" + type_json + "}"
        }
        if self.kind == "IRCall" {
            return "{\"args\":" + self.nodes_json(self.first) +
                ",\"callee\":" + hir_json_quote(self.name) +
                ",\"callee_symbol\":" + hir_json_quote(self.symbol) +
                ",\"node\":\"IRCall\",\"receiver\":" + self.optional_node_json(self.second) +
                ",\"span\":" + span_json + ",\"type\":" + type_json + "}"
        }
        if self.kind == "IRMemberAccess" {
            return "{\"member\":" + hir_json_quote(self.name) +
                ",\"node\":\"IRMemberAccess\",\"obj\":" + self.first[0].to_json() +
                ",\"safe\":" + to_string(self.flag_a) +
                ",\"span\":" + span_json + ",\"type\":" + type_json + "}"
        }
        if self.kind == "IRIndexAccess" {
            return "{\"index\":" + self.second[0].to_json() +
                ",\"node\":\"IRIndexAccess\",\"obj\":" + self.first[0].to_json() +
                ",\"span\":" + span_json + ",\"type\":" + type_json + "}"
        }
        if self.kind == "IRArray" {
            return "{\"elements\":" + self.nodes_json(self.first) +
                ",\"node\":\"IRArray\",\"span\":" + span_json +
                ",\"type\":" + type_json + "}"
        }
        if self.kind == "IRNullCoalesce" {
            return "{\"left\":" + self.first[0].to_json() +
                ",\"node\":\"IRNullCoalesce\",\"right\":" + self.second[0].to_json() +
                ",\"span\":" + span_json + ",\"type\":" + type_json + "}"
        }
        if self.kind == "IRConditional" {
            return "{\"condition\":" + self.first[0].to_json() +
                ",\"else_expr\":" + self.third[0].to_json() +
                ",\"node\":\"IRConditional\",\"span\":" + span_json +
                ",\"then_expr\":" + self.second[0].to_json() +
                ",\"type\":" + type_json + "}"
        }
        if self.kind == "IRMatchExpressionCase" {
            return "{\"node\":\"IRMatchExpressionCase\",\"pattern\":" +
                self.optional_node_json(self.first) +
                ",\"value\":" + self.second[0].to_json() + "}"
        }
        if self.kind == "IRMatchExpression" {
            return "{\"cases\":" + self.nodes_json(self.items) +
                ",\"node\":\"IRMatchExpression\",\"span\":" + span_json +
                ",\"subject\":" + self.first[0].to_json() +
                ",\"type\":" + type_json + "}"
        }
        if self.kind == "IRLambda" {
            return "{\"body\":" + self.second[0].to_json() +
                ",\"node\":\"IRLambda\",\"params\":" + self.nodes_json(self.first) +
                ",\"span\":" + span_json + ",\"type\":" + type_json + "}"
        }
        if self.kind == "IRVarDecl" {
            return "{\"expr\":" + self.first[0].to_json() +
                ",\"is_const\":" + to_string(self.flag_a) +
                ",\"name\":" + hir_json_quote(self.name) +
                ",\"node\":\"IRVarDecl\",\"span\":" + span_json +
                ",\"symbol\":" + hir_json_quote(self.symbol) +
                ",\"type\":" + type_json + "}"
        }
        if self.kind == "IRAssign" {
            return "{\"expr\":" + self.second[0].to_json() +
                ",\"node\":\"IRAssign\",\"span\":" + span_json +
                ",\"target\":" + self.first[0].to_json() + "}"
        }
        if self.kind == "IRExprStatement" {
            return "{\"expr\":" + self.first[0].to_json() +
                ",\"node\":\"IRExprStatement\",\"span\":" + span_json + "}"
        }
        if self.kind == "IRReturn" {
            return "{\"expr\":" + self.optional_node_json(self.first) +
                ",\"node\":\"IRReturn\",\"span\":" + span_json + "}"
        }
        if self.kind == "IRThrow" {
            return "{\"expr\":" + self.first[0].to_json() +
                ",\"node\":\"IRThrow\",\"span\":" + span_json + "}"
        }
        if self.kind == "IRIf" {
            var else_json = "null"
            if self.flag_a { else_json = self.nodes_json(self.third) }
            return "{\"condition\":" + self.first[0].to_json() +
                ",\"elif_branches\":" + self.branches_json() +
                ",\"else_branch\":" + else_json +
                ",\"node\":\"IRIf\",\"span\":" + span_json +
                ",\"then_branch\":" + self.nodes_json(self.second) + "}"
        }
        if self.kind == "IRWhile" {
            return "{\"body\":" + self.nodes_json(self.second) +
                ",\"condition\":" + self.first[0].to_json() +
                ",\"node\":\"IRWhile\",\"span\":" + span_json + "}"
        }
        if self.kind == "IRFor" {
            return "{\"body\":" + self.nodes_json(self.items) +
                ",\"collection_expr\":" + self.optional_node_json(self.third) +
                ",\"end_expr\":" + self.optional_node_json(self.second) +
                ",\"node\":\"IRFor\",\"span\":" + span_json +
                ",\"start_expr\":" + self.optional_node_json(self.first) +
                ",\"symbol\":" + hir_json_quote(self.symbol) +
                ",\"var_name\":" + hir_json_quote(self.name) + "}"
        }
        if self.kind == "IRBreak" { return "{\"node\":\"IRBreak\",\"span\":" + span_json + "}" }
        if self.kind == "IRContinue" { return "{\"node\":\"IRContinue\",\"span\":" + span_json + "}" }
        if self.kind == "IRDefer" {
            return "{\"expr\":" + self.first[0].to_json() +
                ",\"node\":\"IRDefer\",\"span\":" + span_json + "}"
        }
        if self.kind == "IRGuard" {
            return "{\"condition\":" + self.first[0].to_json() +
                ",\"else_body\":" + self.nodes_json(self.second) +
                ",\"node\":\"IRGuard\",\"span\":" + span_json + "}"
        }
        if self.kind == "IRUnsafeBlock" or self.kind == "IRSpawn" {
            return "{\"body\":" + self.nodes_json(self.first) +
                ",\"node\":" + hir_json_quote(self.kind) + ",\"span\":" + span_json + "}"
        }
        if self.kind == "IRAssert" {
            var message_json = "null"
            if self.flag_a { message_json = hir_json_quote(self.value) }
            return "{\"condition\":" + self.first[0].to_json() +
                ",\"message\":" + message_json +
                ",\"node\":\"IRAssert\",\"span\":" + span_json + "}"
        }
        if self.kind == "IRMatchCase" {
            return "{\"body\":" + self.nodes_json(self.second) +
                ",\"node\":\"IRMatchCase\",\"pattern\":" + self.first[0].to_json() + "}"
        }
        if self.kind == "IRMatch" {
            return "{\"cases\":" + self.nodes_json(self.items) +
                ",\"expr\":" + self.first[0].to_json() +
                ",\"node\":\"IRMatch\",\"span\":" + span_json + "}"
        }
        if self.kind == "IRTryCatch" {
            return "{\"catch_body\":" + self.nodes_json(self.second) +
                ",\"error_name\":" + hir_json_quote(self.name) +
                ",\"error_symbol\":" + hir_json_quote(self.symbol) +
                ",\"node\":\"IRTryCatch\",\"span\":" + span_json +
                ",\"try_body\":" + self.nodes_json(self.first) + "}"
        }
        if self.kind == "IRTestBlock" {
            return "{\"body\":" + self.nodes_json(self.first) +
                ",\"description\":" + hir_json_quote(self.value) +
                ",\"node\":\"IRTestBlock\",\"span\":" + span_json + "}"
        }
        if self.kind == "IRParameter" {
            return "{\"default\":" + self.optional_node_json(self.first) +
                ",\"name\":" + hir_json_quote(self.name) +
                ",\"node\":\"IRParameter\",\"symbol\":" + hir_json_quote(self.symbol) +
                ",\"type\":" + type_json + "}"
        }
        if self.kind == "IRFunction" {
            return "{\"body\":" + self.nodes_json(self.second) +
                ",\"doc_comment\":" + hir_json_quote(self.value) +
                ",\"generic_params\":" + self.strings_json(self.strings) +
                ",\"is_async\":" + to_string(self.flag_a) +
                ",\"name\":" + hir_json_quote(self.name) +
                ",\"node\":\"IRFunction\",\"params\":" + self.nodes_json(self.first) +
                ",\"return_type\":" + self.return_type_json() +
                ",\"span\":" + span_json + ",\"symbol\":" + hir_json_quote(self.symbol) + "}"
        }
        if self.kind == "IRStruct" {
            return "{\"doc_comment\":" + hir_json_quote(self.value) +
                ",\"fields\":" + self.nodes_json(self.first) +
                ",\"generic_params\":" + self.strings_json(self.strings) +
                ",\"name\":" + hir_json_quote(self.name) +
                ",\"node\":\"IRStruct\",\"span\":" + span_json +
                ",\"symbol\":" + hir_json_quote(self.symbol) + "}"
        }
        if self.kind == "IRTrait" {
            return "{\"methods\":" + self.nodes_json(self.first) +
                ",\"name\":" + hir_json_quote(self.name) +
                ",\"node\":\"IRTrait\",\"span\":" + span_json +
                ",\"symbol\":" + hir_json_quote(self.symbol) + "}"
        }
        if self.kind == "IRImpl" {
            var trait_json = "null"
            if self.flag_a { trait_json = hir_json_quote(self.value) }
            return "{\"methods\":" + self.nodes_json(self.first) +
                ",\"node\":\"IRImpl\",\"span\":" + span_json +
                ",\"target_type\":" + hir_json_quote(self.name) +
                ",\"trait_name\":" + trait_json + "}"
        }
        if self.kind == "IRTypeAlias" {
            return "{\"actual_type\":" + self.type_json() +
                ",\"name\":" + hir_json_quote(self.name) +
                ",\"node\":\"IRTypeAlias\",\"span\":" + span_json +
                ",\"symbol\":" + hir_json_quote(self.symbol) + "}"
        }
        if self.kind == "IREnumMember" {
            return "{\"is_variant\":" + to_string(self.flag_a) +
                ",\"name\":" + hir_json_quote(self.name) +
                ",\"node\":\"IREnumMember\",\"payload_types\":" + self.node_types_json(self.second) +
                ",\"value\":" + self.optional_node_json(self.first) + "}"
        }
        if self.kind == "IREnum" {
            return "{\"generic_params\":" + self.strings_json(self.strings) +
                ",\"members\":" + self.nodes_json(self.first) +
                ",\"name\":" + hir_json_quote(self.name) +
                ",\"node\":\"IREnum\",\"span\":" + span_json +
                ",\"symbol\":" + hir_json_quote(self.symbol) + "}"
        }
        if self.kind == "IRExternFunction" {
            return "{\"abi\":" + hir_json_quote(self.value) +
                ",\"name\":" + hir_json_quote(self.name) +
                ",\"node\":\"IRExternFunction\",\"params\":" + self.nodes_json(self.first) +
                ",\"return_type\":" + self.return_type_json() +
                ",\"span\":" + span_json + ",\"symbol\":" + hir_json_quote(self.symbol) +
                ",\"varargs\":" + to_string(self.flag_a) + "}"
        }
        if self.kind == "IRNativeDirective" {
            return "{\"kind\":" + hir_json_quote(self.name) +
                ",\"node\":\"IRNativeDirective\",\"origin_module\":" + hir_json_quote(self.aux_name) +
                ",\"span\":" + span_json + ",\"value\":" + hir_json_quote(self.value) + "}"
        }
        if self.kind == "IRForeignImport" {
            return "{\"alias\":" + hir_json_quote(self.name) +
                ",\"ecosystem\":" + hir_json_quote(self.op) +
                ",\"module\":" + hir_json_quote(self.value) +
                ",\"node\":\"IRForeignImport\",\"source\":" + hir_json_quote(self.aux_name) +
                ",\"span\":" + span_json + ",\"symbol\":" + hir_json_quote(self.symbol) + "}"
        }
        return "null"
    }
}

struct HIRModule {
    source_name: string,
    target: string,
    items: Array<HIRNode>,
    schema_version: int
}

impl HIRModule {
    fn to_json(self) -> string {
        var items_json = "["
        for i in 0..len(self.items)-1 {
            if i > 0 { items_json = items_json + "," }
            items_json = items_json + self.items[i].to_json()
        }
        items_json = items_json + "]"
        return "{\"items\":" + items_json +
            ",\"node\":\"IRModule\",\"schema_version\":" + to_string(self.schema_version) +
            ",\"source_name\":" + hir_json_quote(self.source_name) +
            ",\"target\":" + hir_json_quote(self.target) + "}"
    }
}

fn hir_type(name: string) -> HIRType {
    return HIRType(name, [], false, false, [], [])
}

fn hir_optional_type(base: HIRType) -> HIRType {
    return HIRType(base.name, base.arguments, true, base.pointer, base.parameter_types, base.return_types)
}

fn hir_array_type(element: HIRType) -> HIRType {
    return HIRType("Array", [element], false, false, [], [])
}

fn hir_function_type(params: Array<HIRType>, result: HIRType) -> HIRType {
    return HIRType("fn", [], false, false, params, [result])
}

fn hir_empty_node(kind: string, span: HIRSpan) -> HIRNode {
    return HIRNode(kind, span, hir_type("any"), false, hir_type("any"), false,
        "", "", "", "", "", "", "", false, false, [], [], [], [], [])
}
