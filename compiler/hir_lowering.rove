#target cpp
#native include <string>
#native include <vector>

// Rove-authored AST -> canonical typed HIR v1 lowering. This module uses the
// tagged ASTNode/HIRNode representations from parser.rove and hir.rove so the
// production frontend can bootstrap without Python object-model dependencies.

fn hir_text_slice(value: string, start: int, end_exclusive: int) -> string {
    var result = ""
    var i = start
    while i < end_exclusive and i < len(value) {
        if i >= 0 { result = result + value[i] }
        i = i + 1
    }
    return result
}

fn hir_trim_type_text(value: string) -> string {
    var start = 0
    var end_exclusive = len(value)
    while start < end_exclusive and (value[start] == " " or value[start] == "\t" or
        value[start] == "\r" or value[start] == "\n") {
        start = start + 1
    }
    while end_exclusive > start and (value[end_exclusive-1] == " " or
        value[end_exclusive-1] == "\t" or value[end_exclusive-1] == "\r" or
        value[end_exclusive-1] == "\n") {
        end_exclusive = end_exclusive - 1
    }
    return hir_text_slice(value, start, end_exclusive)
}

fn hir_type_from_name(raw_name: string) -> HIRType {
    if raw_name == "" { return hir_type("any") }
    var text = hir_trim_type_text(raw_name)
    var optional = false
    var pointer = false
    if len(text) > 0 and text[len(text)-1] == "?" {
        optional = true
        text = hir_text_slice(text, 0, len(text)-1)
    }
    if len(text) > 0 and text[0] == "*" {
        pointer = true
        text = hir_text_slice(text, 1, len(text))
    }

    var open_index = -1
    for i in 0..len(text)-1 {
        if text[i] == "<" {
            open_index = i
            break
        }
    }
    if open_index < 0 or len(text) == 0 or text[len(text)-1] != ">" {
        return HIRType(text, [], optional, pointer, [], [])
    }

    var base_name = hir_text_slice(text, 0, open_index)
    var arguments: Array<HIRType> = []
    var argument_start = open_index + 1
    var depth = 0
    var i = argument_start
    while i < len(text)-1 {
        var ch = text[i]
        if ch == "<" { depth = depth + 1 }
        elif ch == ">" { depth = depth - 1 }
        elif ch == "," and depth == 0 {
            arguments.push(hir_type_from_name(hir_text_slice(text, argument_start, i)))
            argument_start = i + 1
        }
        i = i + 1
    }
    if argument_start < len(text)-1 {
        arguments.push(hir_type_from_name(hir_text_slice(text, argument_start, len(text)-1)))
    }
    return HIRType(base_name, arguments, optional, pointer, [], [])
}

fn hir_null_type() -> HIRType {
    return HIRType("null", [], true, false, [], [])
}

fn hir_types_equal(left: HIRType, right: HIRType) -> bool {
    return left.canonical() == right.canonical()
}

fn hir_hex_digit(ch: string) -> int {
    if ch >= "0" and ch <= "9" { return to_int(ch) }
    if ch == "a" or ch == "A" { return 10 }
    if ch == "b" or ch == "B" { return 11 }
    if ch == "c" or ch == "C" { return 12 }
    if ch == "d" or ch == "D" { return 13 }
    if ch == "e" or ch == "E" { return 14 }
    if ch == "f" or ch == "F" { return 15 }
    return 0
}

fn hir_normalize_number_literal(value: string) -> string {
    if len(value) > 2 and value[0] == "0" and (value[1] == "x" or value[1] == "X") {
        var number = 0
        for i in 2..len(value)-1 { number = number * 16 + hir_hex_digit(value[i]) }
        return to_string(number)
    }
    if contains(value, ".") {
        var dot_index = 0
        for i in 0..len(value)-1 {
            if value[i] == "." { dot_index = i; break }
        }
        var whole = hir_text_slice(value, 0, dot_index)
        var fraction = hir_text_slice(value, dot_index + 1, len(value))
        while len(whole) > 1 and whole[0] == "0" { whole = hir_text_slice(whole, 1, len(whole)) }
        if whole == "" { whole = "0" }
        while len(fraction) > 1 and fraction[len(fraction)-1] == "0" {
            fraction = hir_text_slice(fraction, 0, len(fraction)-1)
        }
        if fraction == "" { fraction = "0" }
        return whole + "." + fraction
    }
    return to_string(to_int(value))
}

struct HIRSymbol {
    name: string,
    identity: string,
    type_info: HIRType,
    kind: string,
    found: bool
}

struct HIRScope {
    symbols: Array<HIRSymbol>
}

struct HIRStructField {
    struct_name: string,
    field_name: string,
    field_type: HIRType
}

struct HIRFunctionInfo {
    name: string,
    params: Array<FunctionParam>
}

struct HIRLowerer {
    source_name: string,
    target: string,
    scopes: Array<HIRScope>,
    struct_fields: Array<HIRStructField>,
    functions: Array<HIRFunctionInfo>,
    reserved_names: Array<string>,
    counter: int,
    current_owner: string,
    has_error: bool,
    error_msg: string
}

impl HIRLowerer {
    fn span(self, node: ASTNode) -> HIRSpan {
        var line = node.line
        var column = node.col
        if line < 1 { line = 1 }
        if column < 1 { column = 1 }
        return HIRSpan(self.source_name, line, column, 1)
    }

    fn fail(self, message: string, node: ASTNode) {
        if not self.has_error {
            self.has_error = true
            self.error_msg = self.source_name + ":" + to_string(node.line) + ":" +
                to_string(node.col) + ": " + message
        }
    }

    fn enter_scope(self) {
        var symbols: Array<HIRSymbol> = []
        self.scopes.push(HIRScope(symbols))
    }

    fn exit_scope(self) {
        if len(self.scopes) <= 1 { return }
        var next_scopes: Array<HIRScope> = []
        for i in 0..len(self.scopes)-2 { next_scopes.push(self.scopes[i]) }
        self.scopes = next_scopes
    }

    fn missing_symbol(self) -> HIRSymbol {
        return HIRSymbol("", "", hir_type("any"), "", false)
    }

    fn resolve_symbol(self, name: string) -> HIRSymbol {
        var scope_index = len(self.scopes) - 1
        while scope_index >= 0 {
            var symbols = self.scopes[scope_index].symbols
            for i in 0..len(symbols)-1 {
                if symbols[i].name == name { return symbols[i] }
            }
            scope_index = scope_index - 1
        }
        return self.missing_symbol()
    }

    fn declare_symbol(self, symbol: HIRSymbol, node: ASTNode) -> bool {
        if len(self.scopes) == 0 { self.enter_scope() }
        var scope_index = len(self.scopes) - 1
        for i in 0..len(self.scopes[scope_index].symbols)-1 {
            if self.scopes[scope_index].symbols[i].name == symbol.name {
                self.fail("Duplicate symbol '" + symbol.name + "' in the same scope", node)
                return false
            }
        }
        self.scopes[scope_index].symbols.push(symbol)
        return true
    }

    fn next_symbol(self, name: string) -> string {
        self.counter = self.counter + 1
        return self.current_owner + "::local::" + to_string(self.counter) + "::" + name
    }

    fn name_is_reserved(self, name: string) -> bool {
        for i in 0..len(self.reserved_names)-1 {
            if self.reserved_names[i] == name { return true }
        }
        return false
    }

    fn reserve_name(self, name: string) {
        if name == "" or name == "_" { return }
        if not self.name_is_reserved(name) { self.reserved_names.push(name) }
        var emitted_name = ""
        for i in 0..len(name)-1 {
            if name[i] == "$" { emitted_name = emitted_name + "_" }
            else { emitted_name = emitted_name + name[i] }
        }
        if not self.name_is_reserved(emitted_name) {
            self.reserved_names.push(emitted_name)
        }
    }

    fn reserve_user_names(self, node: ASTNode) -> void {
        self.reserve_name(node.name)
        for i in 0..len(node.params)-1 { self.reserve_name(node.params[i].name) }
        for i in 0..len(node.children)-1 { self.reserve_user_names(node.children[i]) }
    }

    fn next_internal_name(self, purpose: string) -> string {
        while true {
            self.counter = self.counter + 1
            var candidate = "nyx_internal_" + purpose + "_" + to_string(self.counter)
            if not self.name_is_reserved(candidate) {
                self.reserve_name(candidate)
                return candidate
            }
        }
        return ""
    }

    fn lookup_struct_field(self, struct_name: string, field_name: string) -> HIRType {
        for i in 0..len(self.struct_fields)-1 {
            var field = self.struct_fields[i]
            if field.struct_name == struct_name and field.field_name == field_name {
                return field.field_type
            }
        }
        return hir_type("any")
    }

    fn struct_field_count(self, struct_name: string) -> int {
        var count = 0
        for i in 0..len(self.struct_fields)-1 {
            if self.struct_fields[i].struct_name == struct_name { count = count + 1 }
        }
        return count
    }

    fn struct_field_name_at(self, struct_name: string, field_index: int) -> string {
        var current = 0
        for i in 0..len(self.struct_fields)-1 {
            if self.struct_fields[i].struct_name == struct_name {
                if current == field_index { return self.struct_fields[i].field_name }
                current = current + 1
            }
        }
        return ""
    }

    fn struct_field_type_at(self, struct_name: string, field_index: int) -> HIRType {
        var current = 0
        for i in 0..len(self.struct_fields)-1 {
            if self.struct_fields[i].struct_name == struct_name {
                if current == field_index { return self.struct_fields[i].field_type }
                current = current + 1
            }
        }
        return hir_type("any")
    }

    fn lookup_function_params(self, name: string) -> Array<FunctionParam> {
        for i in 0..len(self.functions)-1 {
            if self.functions[i].name == name {
                return self.functions[i].params
            }
        }
        return []
    }

    fn declare_callable(self, prefix: string, name: string, params: Array<HIRType>, result: HIRType, node: ASTNode) {
        self.declare_symbol(HIRSymbol(name, prefix + "::" + name,
            hir_function_type(params, result), prefix, true), node)
    }

    fn declare_builtins(self, node: ASTNode) {
        var any_type = hir_type("any")
        var int_type = hir_type("int")
        var float_type = hir_type("float")
        var string_type = hir_type("string")
        var bool_type = hir_type("bool")
        var void_type = hir_type("void")
        var uintptr_type = hir_type("uintptr")
        var result_type = HIRType("Result", [any_type, any_type], false, false, [], [])
        var no_types: Array<HIRType> = []

        self.declare_callable("builtin", "print", no_types, void_type, node)
        self.declare_callable("builtin", "input", [string_type], string_type, node)
        self.declare_callable("builtin", "to_string", [any_type], string_type, node)
        self.declare_callable("builtin", "to_int", [string_type], int_type, node)
        self.declare_callable("builtin", "contains", [string_type, string_type], bool_type, node)
        self.declare_callable("builtin", "is_number", [string_type], bool_type, node)
        self.declare_callable("builtin", "addr", [any_type], uintptr_type, node)
        self.declare_callable("builtin", "peek", [uintptr_type], uintptr_type, node)
        self.declare_callable("builtin", "memdump", [uintptr_type, int_type], void_type, node)
        self.declare_callable("builtin", "delay_ms", [int_type], void_type, node)
        self.declare_callable("builtin", "channel", no_types, hir_type("Channel"), node)
        self.declare_callable("builtin", "Ok", [any_type], result_type, node)
        self.declare_callable("builtin", "Err", [any_type], result_type, node)
        self.declare_callable("builtin", "len", [any_type], int_type, node)
        self.declare_callable("builtin", "args", no_types, hir_array_type(string_type), node)
        self.declare_callable("builtin", "map", [any_type, any_type], any_type, node)
        self.declare_callable("builtin", "filter", [any_type, any_type], any_type, node)
        self.declare_callable("builtin", "fold", [any_type, any_type, any_type], any_type, node)

        self.declare_callable("intrinsic", "_nyx_destructure_check",
            [any_type, int_type, string_type], any_type, node)
        self.declare_callable("intrinsic", "_nyx_bootstrap_read_file", [string_type], string_type, node)
        self.declare_callable("intrinsic", "_nyx_bootstrap_write_file", [string_type, string_type], bool_type, node)
        self.declare_callable("intrinsic", "_nyx_bootstrap_file_exists", [string_type], bool_type, node)
        self.declare_callable("intrinsic", "_nyx_bootstrap_remove_file", [string_type], bool_type, node)
        self.declare_callable("intrinsic", "_nyx_process_exit", [int_type], void_type, node)
        self.declare_callable("intrinsic", "_nyx_toolchain_compile_cpp", [string_type, string_type], int_type, node)
        self.declare_callable("intrinsic", "_nyx_toolchain_last_error", no_types, string_type, node)
        self.declare_callable("intrinsic", "_nyx_utf8_from_codepoint", [int_type], string_type, node)
        self.declare_callable("intrinsic", "_nyx_math_sin", [float_type], float_type, node)
        self.declare_callable("intrinsic", "_nyx_math_cos", [float_type], float_type, node)
        self.declare_callable("intrinsic", "_nyx_math_tan", [float_type], float_type, node)
        self.declare_callable("intrinsic", "_nyx_math_sqrt", [float_type], float_type, node)
        self.declare_callable("intrinsic", "_nyx_math_pow", [float_type, float_type], float_type, node)
        self.declare_callable("intrinsic", "_nyx_math_abs", [float_type], float_type, node)
        self.declare_callable("intrinsic", "_nyx_math_floor", [float_type], float_type, node)
        self.declare_callable("intrinsic", "_nyx_math_ceil", [float_type], float_type, node)
        self.declare_callable("intrinsic", "_nyx_math_round", [float_type], float_type, node)
        self.declare_callable("intrinsic", "_nyx_math_clamp", [float_type, float_type, float_type], float_type, node)
        self.declare_callable("intrinsic", "_nyx_time_now_ms", no_types, int_type, node)
        self.declare_callable("intrinsic", "_nyx_time_now_us", no_types, int_type, node)
        self.declare_callable("intrinsic", "_nyx_time_sleep_ms", [int_type], void_type, node)
        self.declare_callable("intrinsic", "_nyx_base64_encode", [string_type], string_type, node)
        self.declare_callable("intrinsic", "_nyx_base64_decode", [string_type], string_type, node)
        self.declare_callable("intrinsic", "_nyx_base64_decode_result", [string_type], hir_type_from_name("Result<string, string>"), node)
        self.declare_callable("intrinsic", "_nyx_hash_fnv1a_64_hex", [string_type], string_type, node)
        self.declare_callable("intrinsic", "_nyx_fs_read_to_string", [string_type], string_type, node)
        self.declare_callable("intrinsic", "_nyx_fs_write_string", [string_type, string_type], bool_type, node)
        self.declare_callable("intrinsic", "_nyx_fs_append_string", [string_type, string_type], bool_type, node)
        self.declare_callable("intrinsic", "_nyx_fs_exists", [string_type], bool_type, node)
        self.declare_callable("intrinsic", "_nyx_fs_remove_file", [string_type], bool_type, node)
        self.declare_callable("intrinsic", "_nyx_fs_read_to_string_result", [string_type], hir_type_from_name("Result<string, string>"), node)
        self.declare_callable("intrinsic", "_nyx_fs_write_string_result", [string_type, string_type], hir_type_from_name("Result<bool, string>"), node)
        self.declare_callable("intrinsic", "_nyx_fs_append_string_result", [string_type, string_type], hir_type_from_name("Result<bool, string>"), node)
        self.declare_callable("intrinsic", "_nyx_fs_remove_file_result", [string_type], hir_type_from_name("Result<bool, string>"), node)
        self.declare_callable("intrinsic", "_nyx_json_get_string", [string_type, string_type], string_type, node)
        self.declare_callable("intrinsic", "_nyx_json_get_int", [string_type, string_type], int_type, node)
        self.declare_callable("intrinsic", "_nyx_json_get_string_result", [string_type, string_type], hir_type_from_name("Result<string, string>"), node)
        self.declare_callable("intrinsic", "_nyx_json_get_int_result", [string_type, string_type], hir_type_from_name("Result<int, string>"), node)
        self.declare_callable("intrinsic", "_nyx_net_tcp_connect", [string_type, int_type], int_type, node)
        self.declare_callable("intrinsic", "_nyx_net_tcp_send", [int_type, string_type], bool_type, node)
        self.declare_callable("intrinsic", "_nyx_net_tcp_recv", [int_type, int_type], string_type, node)
        self.declare_callable("intrinsic", "_nyx_net_tcp_close", [int_type], void_type, node)
        self.declare_callable("intrinsic", "_nyx_net_tcp_connect_result", [string_type, int_type], hir_type_from_name("Result<int, string>"), node)
        self.declare_callable("intrinsic", "_nyx_net_tcp_send_result", [int_type, string_type], hir_type_from_name("Result<bool, string>"), node)
        self.declare_callable("intrinsic", "_nyx_net_tcp_recv_result", [int_type, int_type], hir_type_from_name("Result<string, string>"), node)
        self.declare_callable("intrinsic", "_nyx_net_tcp_close_result", [int_type], hir_type_from_name("Result<bool, string>"), node)
        self.declare_callable("intrinsic", "_nyx_mutex_create", no_types, int_type, node)
        self.declare_callable("intrinsic", "_nyx_mutex_lock", [int_type], void_type, node)
        self.declare_callable("intrinsic", "_nyx_mutex_unlock", [int_type], void_type, node)
        self.declare_callable("intrinsic", "_nyx_channel_create", no_types, int_type, node)
        self.declare_callable("intrinsic", "_nyx_channel_send", [int_type, string_type], void_type, node)
        self.declare_callable("intrinsic", "_nyx_channel_recv", [int_type], string_type, node)
        self.declare_callable("intrinsic", "_nyx_process_exec_cmd_result", [string_type], hir_type_from_name("Result<int, string>"), node)
        self.declare_callable("intrinsic", "_nyx_process_get_env_result", [string_type], hir_type_from_name("Result<string, string>"), node)
        self.declare_callable("intrinsic", "_nyx_path_join", [string_type, string_type], string_type, node)
        self.declare_callable("intrinsic", "_nyx_path_basename", [string_type], string_type, node)
        self.declare_callable("intrinsic", "_nyx_path_dirname", [string_type], string_type, node)
        self.declare_callable("intrinsic", "_nyx_path_extname", [string_type], string_type, node)
        self.declare_callable("intrinsic", "_nyx_path_is_abs", [string_type], bool_type, node)
        self.declare_callable("intrinsic", "_nyx_path_normalize", [string_type], string_type, node)
        self.declare_callable("intrinsic", "_nyx_str_trim", [string_type], string_type, node)
        self.declare_callable("intrinsic", "_nyx_str_starts_with", [string_type, string_type], bool_type, node)
        self.declare_callable("intrinsic", "_nyx_str_ends_with", [string_type, string_type], bool_type, node)
        self.declare_callable("intrinsic", "_nyx_str_find_result", [string_type, string_type], hir_type_from_name("Result<int, string>"), node)
        self.declare_callable("intrinsic", "_nyx_str_to_upper", [string_type], string_type, node)
        self.declare_callable("intrinsic", "_nyx_str_to_lower", [string_type], string_type, node)
        self.declare_callable("intrinsic", "_nyx_str_replace", [string_type, string_type, string_type], string_type, node)
    }

    fn predeclare_top_level(self, program: ASTNode) {
        for i in 0..len(program.children)-1 {
            var node = program.children[i]
            var symbol = self.missing_symbol()
            if node.kind == "FunctionDef" {
                var parameter_types: Array<HIRType> = []
                for p in 0..len(node.params)-1 {
                    parameter_types.push(hir_type_from_name(node.params[p].type_annot))
                }
                var result_type = hir_type("any")
                if node.is_safe { result_type = hir_type_from_name(node.type_name) }
                var public_result_type = result_type
                if node.is_async {
                    public_result_type = HIRType("Task", [result_type], false, false, [], [])
                }
                symbol = HIRSymbol(node.name, "function::" + node.name,
                    hir_function_type(parameter_types, public_result_type), "function", true)
                self.functions.push(HIRFunctionInfo(node.name, node.params))
            } elif node.kind == "ExternFn" {
                var parameter_types: Array<HIRType> = []
                for p in 0..len(node.params)-1 {
                    parameter_types.push(hir_type_from_name(node.params[p].type_annot))
                }
                symbol = HIRSymbol(node.name, "extern::" + node.value + "::" + node.name,
                    hir_function_type(parameter_types, hir_type_from_name(node.type_name)), "extern", true)
            } elif node.kind == "StructDef" {
                symbol = HIRSymbol(node.name, "type::struct::" + node.name,
                    hir_type(node.name), "struct", true)
                for p in 0..len(node.params)-1 {
                    self.struct_fields.push(HIRStructField(node.name, node.params[p].name,
                        hir_type_from_name(node.params[p].type_annot)))
                }
            } elif node.kind == "TraitDef" {
                symbol = HIRSymbol(node.name, "type::trait::" + node.name,
                    hir_type(node.name), "trait", true)
            } elif node.kind == "TypeAlias" {
                symbol = HIRSymbol(node.name, "type::alias::" + node.name,
                    hir_type_from_name(node.type_name), "alias", true)
            } elif node.kind == "EnumDef" {
                symbol = HIRSymbol(node.name, "type::enum::" + node.name,
                    hir_type(node.name), "enum", true)
            } elif node.kind == "Import" and node.op != "" {
                symbol = HIRSymbol(node.name, "foreign::" + node.op + "::" + node.name,
                    hir_type("foreign::" + node.op), "foreign-module", true)
            }
            if symbol.found { self.declare_symbol(symbol, node) }
            if node.kind == "EnumDef" {
                var result_arguments: Array<HIRType> = []
                for g in 0..len(node.generic_args)-1 {
                    result_arguments.push(hir_type(node.generic_args[g]))
                }
                var variant_result = HIRType(node.name, result_arguments, false, false, [], [])
                for m in 0..len(node.children)-1 {
                    var member = node.children[m]
                    if member.is_safe {
                        var payload_types: Array<HIRType> = []
                        for p in 0..len(member.params)-1 {
                            payload_types.push(hir_type_from_name(member.params[p].type_annot))
                        }
                        self.declare_callable("enum::" + node.name + "::variant",
                            member.name, payload_types, variant_result, member)
                    }
                }
            }
        }
    }

    fn require_symbol(self, name: string, node: ASTNode) -> HIRSymbol {
        var symbol = self.resolve_symbol(name)
        if not symbol.found { self.fail("Missing predeclared symbol '" + name + "'", node) }
        return symbol
    }

    fn parameter(self, param: FunctionParam, identity: string, owner: ASTNode) -> HIRNode {
        var result = hir_empty_node("IRParameter", self.span(owner))
        result.name = param.name
        result.symbol = identity
        result.type_info = hir_type_from_name(param.type_annot)
        result.has_type = true
        if len(param.default_expr) > 0 {
            result.first = [self.lower_expr(param.default_expr[0])]
        }
        return result
    }

    fn lower_function(self, node: ASTNode, identity: string) -> HIRNode {
        var previous_owner = self.current_owner
        self.current_owner = identity
        self.enter_scope()
        var parameters: Array<HIRNode> = []
        for i in 0..len(node.params)-1 {
            var param = node.params[i]
            var symbol_id = identity + "::param::" + to_string(i) + "::" + param.name
            var param_type = hir_type_from_name(param.type_annot)
            self.declare_symbol(HIRSymbol(param.name, symbol_id, param_type, "parameter", true), node)
            parameters.push(self.parameter(param, symbol_id, node))
        }
        var body = self.lower_block(node.children, false)
        self.exit_scope()
        self.current_owner = previous_owner

        var result = hir_empty_node("IRFunction", self.span(node))
        result.name = node.name
        result.symbol = identity
        result.first = parameters
        result.second = body
        result.return_type = hir_type("any")
        if node.is_safe { result.return_type = hir_type_from_name(node.type_name) }
        result.has_return_type = true
        result.strings = node.generic_args
        result.flag_a = node.is_async
        result.value = node.value
        return result
    }

    fn native_directive(self, node: ASTNode, kind: string) -> HIRNode {
        var result = hir_empty_node("IRNativeDirective", self.span(node))
        result.name = kind
        result.value = node.value
        result.aux_name = node.op
        return result
    }

    fn lower_top_level(self, node: ASTNode) -> HIRNode {
        if node.kind == "Import" and node.op != "" {
            var symbol = self.require_symbol(node.name, node)
            var result = hir_empty_node("IRForeignImport", self.span(node))
            result.name = node.name
            result.symbol = symbol.identity
            result.value = node.value
            result.op = node.op
            result.aux_name = node.type_name
            return result
        }
        if node.kind == "FunctionDef" {
            var symbol = self.require_symbol(node.name, node)
            return self.lower_function(node, symbol.identity)
        }
        if node.kind == "StructDef" {
            var symbol = self.require_symbol(node.name, node)
            var fields: Array<HIRNode> = []
            for i in 0..len(node.params)-1 {
                var field = node.params[i]
                fields.push(self.parameter(field, symbol.identity + "::field::" + field.name, node))
            }
            var result = hir_empty_node("IRStruct", self.span(node))
            result.name = node.name
            result.symbol = symbol.identity
            result.first = fields
            result.strings = node.generic_args
            result.value = node.value
            return result
        }
        if node.kind == "TraitDef" {
            var symbol = self.require_symbol(node.name, node)
            var methods: Array<HIRNode> = []
            for i in 0..len(node.children)-1 {
                var method = node.children[i]
                methods.push(self.lower_function(method, symbol.identity + "::method::" + method.name))
            }
            var result = hir_empty_node("IRTrait", self.span(node))
            result.name = node.name
            result.symbol = symbol.identity
            result.first = methods
            return result
        }
        if node.kind == "ImplBlock" {
            var methods: Array<HIRNode> = []
            for i in 0..len(node.children)-1 {
                var method = node.children[i]
                methods.push(self.lower_function(method,
                    "impl::" + node.name + "::method::" + method.name))
            }
            var result = hir_empty_node("IRImpl", self.span(node))
            result.name = node.name
            result.first = methods
            if node.value != "" { result.flag_a = true; result.value = node.value }
            return result
        }
        if node.kind == "TypeAlias" {
            var symbol = self.require_symbol(node.name, node)
            var result = hir_empty_node("IRTypeAlias", self.span(node))
            result.name = node.name
            result.symbol = symbol.identity
            result.type_info = hir_type_from_name(node.type_name)
            result.has_type = true
            return result
        }
        if node.kind == "EnumDef" {
            var symbol = self.require_symbol(node.name, node)
            var members: Array<HIRNode> = []
            for i in 0..len(node.children)-1 {
                var member_ast = node.children[i]
                var member = hir_empty_node("IREnumMember", self.span(member_ast))
                member.name = member_ast.name
                if len(member_ast.children) > 0 { member.first = [self.lower_expr(member_ast.children[0])] }
                member.flag_a = member_ast.is_safe
                for p in 0..len(member_ast.params)-1 {
                    var payload_type = hir_empty_node("__type__", self.span(member_ast))
                    payload_type.type_info = hir_type_from_name(member_ast.params[p].type_annot)
                    payload_type.has_type = true
                    member.second.push(payload_type)
                }
                members.push(member)
            }
            var result = hir_empty_node("IREnum", self.span(node))
            result.name = node.name
            result.symbol = symbol.identity
            result.first = members
            result.strings = node.generic_args
            return result
        }
        if node.kind == "ExternFn" {
            var symbol = self.require_symbol(node.name, node)
            var parameters: Array<HIRNode> = []
            for i in 0..len(node.params)-1 {
                parameters.push(self.parameter(node.params[i],
                    symbol.identity + "::param::" + to_string(i) + "::" + node.params[i].name, node))
            }
            var result = hir_empty_node("IRExternFunction", self.span(node))
            result.value = node.value
            result.name = node.name
            result.symbol = symbol.identity
            result.first = parameters
            result.return_type = hir_type_from_name(node.type_name)
            result.has_return_type = true
            result.flag_a = node.is_varargs
            return result
        }
        if node.kind == "Directive" {
            if node.name == "target" { return hir_empty_node("__skip__", self.span(node)) }
            if node.name == "native_include" { return self.native_directive(node, "include") }
            if node.name == "native_link" { return self.native_directive(node, "link") }
            if node.name == "native_raw" { return self.native_directive(node, "raw") }
            if node.name == "native_use" { return self.native_directive(node, "use") }
        }
        return self.lower_statement(node)
    }

    fn lower_program(self, program: ASTNode) -> HIRModule {
        self.reserved_names = []
        self.reserve_user_names(program)
        for i in 0..len(program.children)-1 {
            if program.children[i].kind == "Directive" and program.children[i].name == "target" {
                self.target = program.children[i].value
            }
        }
        self.enter_scope()
        self.declare_builtins(program)
        self.enter_scope()
        self.predeclare_top_level(program)
        var items: Array<HIRNode> = []
        for i in 0..len(program.children)-1 {
            if program.children[i].kind == "DestructureDecl" {
                var declarations = self.lower_destructure(program.children[i])
                for d in 0..len(declarations)-1 { items.push(declarations[d]) }
            } else {
                var item = self.lower_top_level(program.children[i])
                if item.kind != "__skip__" { items.push(item) }
            }
        }
        self.exit_scope()
        return HIRModule(self.source_name, self.target, items, 1)
    }

    fn lower_block(self, statements: Array<ASTNode>, create_scope: bool) -> Array<HIRNode> {
        if create_scope { self.enter_scope() }
        var result: Array<HIRNode> = []
        for i in 0..len(statements)-1 {
            if statements[i].kind == "DestructureDecl" {
                var declarations = self.lower_destructure(statements[i])
                for d in 0..len(declarations)-1 { result.push(declarations[d]) }
            } else {
                result.push(self.lower_statement(statements[i]))
            }
        }
        if create_scope { self.exit_scope() }
        return result
    }

    fn lower_destructure(self, node: ASTNode) -> Array<HIRNode> {
        var span = self.span(node)
        var source_expr = self.lower_expr(node.children[len(node.children)-1])
        var binding_count = len(node.children) - 1
        if node.value == "array" {
            var minimum = hir_empty_node("IRLiteral", span)
            minimum.value = to_string(binding_count)
            minimum.value_kind = "int"
            minimum.type_info = hir_type("int")
            minimum.has_type = true

            var message = hir_empty_node("IRLiteral", span)
            message.value = "Array destructuring requires at least " +
                to_string(binding_count) + " elements"
            message.value_kind = "string"
            message.type_info = hir_type("string")
            message.has_type = true

            var checked_source = hir_empty_node("IRCall", span)
            checked_source.name = "_nyx_destructure_check"
            checked_source.symbol = "intrinsic::_nyx_destructure_check"
            checked_source.first = [source_expr, minimum, message]
            checked_source.type_info = source_expr.type_info
            checked_source.has_type = true
            source_expr = checked_source
        }
        var temp_name = self.next_internal_name("destructure")
        var temp_symbol = HIRSymbol(temp_name,
            self.current_owner + "::local::" + to_string(self.counter) + "::" + temp_name,
            source_expr.type_info, "temporary", true)
        self.declare_symbol(temp_symbol, node)

        var temp_decl = hir_empty_node("IRVarDecl", span)
        temp_decl.name = temp_name
        temp_decl.symbol = temp_symbol.identity
        temp_decl.type_info = source_expr.type_info
        temp_decl.has_type = true
        temp_decl.first = [source_expr]
        temp_decl.flag_a = true
        var declarations: Array<HIRNode> = [temp_decl]

        var source_ref = hir_empty_node("IRReference", span)
        source_ref.name = temp_name
        source_ref.symbol = temp_symbol.identity
        source_ref.type_info = source_expr.type_info
        source_ref.has_type = true

        for i in 0..binding_count-1 {
            var binding_name = node.children[i].name
            if binding_name == "_" { continue }
            var binding_type = hir_type("any")
            var extracted = hir_empty_node("IRIndexAccess", span)
            if node.value == "array" {
                if source_expr.type_info.name == "Array" and len(source_expr.type_info.arguments) > 0 {
                    binding_type = source_expr.type_info.arguments[0]
                }
                var index = hir_empty_node("IRLiteral", span)
                index.value = to_string(i)
                index.value_kind = "int"
                index.type_info = hir_type("int")
                index.has_type = true
                extracted.first = [source_ref]
                extracted.second = [index]
            } else {
                binding_type = self.struct_field_type_at(node.name, i)
                extracted = hir_empty_node("IRMemberAccess", span)
                extracted.name = self.struct_field_name_at(node.name, i)
                extracted.first = [source_ref]
            }
            extracted.type_info = binding_type
            extracted.has_type = true

            var symbol = HIRSymbol(binding_name, self.next_symbol(binding_name),
                binding_type, "variable", true)
            self.declare_symbol(symbol, node.children[i])
            var declaration = hir_empty_node("IRVarDecl", span)
            declaration.name = binding_name
            declaration.symbol = symbol.identity
            declaration.type_info = binding_type
            declaration.has_type = true
            declaration.first = [extracted]
            declaration.flag_a = node.is_const
            declarations.push(declaration)
        }
        return declarations
    }

    fn is_expression_ast(self, node: ASTNode) -> bool {
        return node.kind == "Number" or node.kind == "String" or node.kind == "Boolean" or
            node.kind == "Null" or node.kind == "Identifier" or node.kind == "BinaryOp" or
            node.kind == "UnaryOp" or node.kind == "Await" or node.kind == "FunctionCall" or node.kind == "MemberAccess" or
            node.kind == "ResultPropagate" or
            node.kind == "IndexAccess" or node.kind == "Array" or node.kind == "NullCoalesce" or
            node.kind == "Lambda" or node.kind == "ConditionalExpr" or
            node.kind == "MatchExpr"
    }

    fn lower_statement(self, node: ASTNode) -> HIRNode {
        var span = self.span(node)
        if node.kind == "VarDecl" {
            var expr = self.lower_expr(node.children[0])
            var value_type = expr.type_info
            if node.type_name != "" { value_type = hir_type_from_name(node.type_name) }
            if expr.kind == "IRArray" and len(expr.first) == 0 and
                expr.type_info.name == "Array" and len(expr.type_info.arguments) == 1 and
                expr.type_info.arguments[0].name == "any" and
                value_type.name == "Array" and len(value_type.arguments) == 1 and
                value_type.arguments[0].name != "any" and
                not value_type.optional and not value_type.pointer {
                expr.type_info = value_type
            }
            var symbol = HIRSymbol(node.name, self.next_symbol(node.name), value_type, "variable", true)
            self.declare_symbol(symbol, node)
            var result = hir_empty_node("IRVarDecl", span)
            result.name = node.name
            result.symbol = symbol.identity
            result.type_info = value_type
            result.has_type = true
            result.first = [expr]
            result.flag_a = node.is_const
            return result
        }
        if node.kind == "Assign" {
            if len(node.children) >= 2 and node.children[0].kind == "Identifier" {
                var existing = self.resolve_symbol(node.children[0].name)
                if not existing.found {
                    var expr = self.lower_expr(node.children[1])
                    var symbol = HIRSymbol(node.children[0].name,
                        self.next_symbol(node.children[0].name), expr.type_info, "variable", true)
                    self.declare_symbol(symbol, node)
                    var declaration = hir_empty_node("IRVarDecl", span)
                    declaration.name = node.children[0].name
                    declaration.symbol = symbol.identity
                    declaration.type_info = expr.type_info
                    declaration.has_type = true
                    declaration.first = [expr]
                    return declaration
                }
            }
            var result = hir_empty_node("IRAssign", span)
            if len(node.children) >= 2 {
                result.first = [self.lower_expr(node.children[0])]
                result.second = [self.lower_expr(node.children[1])]
            }
            return result
        }
        if node.kind == "Return" {
            var result = hir_empty_node("IRReturn", span)
            if len(node.children) > 0 {
                var expr = node.children[0]
                if expr.kind != "Null" or expr.value != "" { result.first = [self.lower_expr(expr)] }
            }
            return result
        }
        if node.kind == "If" {
            var then_ast: Array<ASTNode> = []
            var branch_index = 1
            while branch_index < len(node.children) and node.children[branch_index].kind != "ElifBlock" and
                node.children[branch_index].kind != "ElseBlock" {
                then_ast.push(node.children[branch_index])
                branch_index = branch_index + 1
            }
            var branches: Array<HIRNode> = []
            while branch_index < len(node.children) and node.children[branch_index].kind == "ElifBlock" {
                var branch_ast = node.children[branch_index]
                var branch_body_ast: Array<ASTNode> = []
                for i in 1..len(branch_ast.children)-1 { branch_body_ast.push(branch_ast.children[i]) }
                var branch = hir_empty_node("__elif__", self.span(branch_ast))
                branch.first = [self.lower_expr(branch_ast.children[0])]
                branch.second = self.lower_block(branch_body_ast, true)
                branches.push(branch)
                branch_index = branch_index + 1
            }
            var else_body: Array<HIRNode> = []
            var has_else = false
            if branch_index < len(node.children) and node.children[branch_index].kind == "ElseBlock" {
                has_else = true
                else_body = self.lower_block(node.children[branch_index].children, true)
            }
            var result = hir_empty_node("IRIf", span)
            result.first = [self.lower_expr(node.children[0])]
            result.second = self.lower_block(then_ast, true)
            result.items = branches
            result.flag_a = has_else
            result.third = else_body
            return result
        }
        if node.kind == "While" {
            var body_ast: Array<ASTNode> = []
            for i in 1..len(node.children)-1 { body_ast.push(node.children[i]) }
            var result = hir_empty_node("IRWhile", span)
            result.first = [self.lower_expr(node.children[0])]
            result.second = self.lower_block(body_ast, true)
            return result
        }
        if node.kind == "Loop" {
            var condition = hir_empty_node("IRLiteral", span)
            condition.type_info = hir_type("bool")
            condition.has_type = true
            condition.value = "true"
            condition.value_kind = "bool"
            var result = hir_empty_node("IRWhile", span)
            result.first = [condition]
            result.second = self.lower_block(node.children, true)
            return result
        }
        if node.kind == "For" {
            var start_nodes: Array<HIRNode> = []
            var end_nodes: Array<HIRNode> = []
            var collection_nodes: Array<HIRNode> = []
            var item_type = hir_type("int")
            if len(node.children) >= 2 and node.children[1].kind == "Null" and node.children[1].value == "" {
                var collection = self.lower_expr(node.children[0])
                collection_nodes = [collection]
                item_type = hir_type("any")
                if collection.type_info.name == "Array" and len(collection.type_info.arguments) > 0 {
                    item_type = collection.type_info.arguments[0]
                } elif collection.type_info.name == "Iterator" and len(collection.type_info.arguments) > 0 {
                    item_type = collection.type_info.arguments[0]
                } elif collection.type_info.name == "string" {
                    item_type = hir_type("string")
                }
            } else {
                if len(node.children) > 0 { start_nodes = [self.lower_expr(node.children[0])] }
                if len(node.children) > 1 { end_nodes = [self.lower_expr(node.children[1])] }
            }
            self.enter_scope()
            var symbol = HIRSymbol(node.name, self.next_symbol(node.name), item_type, "loop-variable", true)
            self.declare_symbol(symbol, node)
            var body_ast: Array<ASTNode> = []
            for i in 2..len(node.children)-1 { body_ast.push(node.children[i]) }
            var body = self.lower_block(body_ast, false)
            self.exit_scope()
            var result = hir_empty_node("IRFor", span)
            result.name = node.name
            result.symbol = symbol.identity
            result.first = start_nodes
            result.second = end_nodes
            result.third = collection_nodes
            result.items = body
            return result
        }
        if node.kind == "Break" { return hir_empty_node("IRBreak", span) }
        if node.kind == "Continue" { return hir_empty_node("IRContinue", span) }
        if node.kind == "Throw" {
            var result = hir_empty_node("IRThrow", span)
            result.first = [self.lower_expr(node.children[0])]
            return result
        }
        if node.kind == "Defer" {
            var result = hir_empty_node("IRDefer", span)
            result.first = [self.lower_expr(node.children[0])]
            return result
        }
        if node.kind == "Guard" {
            var body_ast: Array<ASTNode> = []
            for i in 1..len(node.children)-1 { body_ast.push(node.children[i]) }
            var result = hir_empty_node("IRGuard", span)
            result.first = [self.lower_expr(node.children[0])]
            result.second = self.lower_block(body_ast, true)
            return result
        }
        if node.kind == "UnsafeBlock" or node.kind == "Spawn" {
            var hir_kind = "IRUnsafeBlock"
            if node.kind == "Spawn" { hir_kind = "IRSpawn" }
            var result = hir_empty_node(hir_kind, span)
            result.first = self.lower_block(node.children, true)
            return result
        }
        if node.kind == "Assert" {
            var result = hir_empty_node("IRAssert", span)
            result.first = [self.lower_expr(node.children[0])]
            result.flag_a = node.value != ""
            result.value = node.value
            return result
        }
        if node.kind == "TestBlock" {
            var result = hir_empty_node("IRTestBlock", span)
            result.value = node.value
            result.first = self.lower_block(node.children, true)
            return result
        }
        if node.kind == "TryCatch" {
            var try_ast: Array<ASTNode> = []
            var catch_ast: Array<ASTNode> = []
            if len(node.children) > 0 { try_ast = node.children[0].children }
            if len(node.children) > 1 { catch_ast = node.children[1].children }
            var try_body = self.lower_block(try_ast, true)
            self.enter_scope()
            var error_symbol = HIRSymbol(node.name, self.next_symbol(node.name),
                hir_type("string"), "catch", true)
            self.declare_symbol(error_symbol, node)
            var catch_body = self.lower_block(catch_ast, false)
            self.exit_scope()
            var result = hir_empty_node("IRTryCatch", span)
            result.name = node.name
            result.symbol = error_symbol.identity
            result.first = try_body
            result.second = catch_body
            return result
        }
        if node.kind == "Match" {
            var subject = self.lower_expr(node.children[0])
            var cases: Array<HIRNode> = []
            var index = 1
            while index + 1 < len(node.children) {
                var pattern_ast = node.children[index]
                var case_ast = node.children[index + 1]
                self.enter_scope()
                var pattern = self.lower_pattern(pattern_ast, subject.type_info)
                var body = self.lower_block(case_ast.children, false)
                self.exit_scope()
                var match_case = hir_empty_node("IRMatchCase", self.span(case_ast))
                match_case.first = [pattern]
                match_case.second = body
                cases.push(match_case)
                index = index + 2
            }
            var result = hir_empty_node("IRMatch", span)
            result.first = [subject]
            result.items = cases
            return result
        }
        if self.is_expression_ast(node) {
            var result = hir_empty_node("IRExprStatement", span)
            result.first = [self.lower_expr(node)]
            return result
        }
        self.fail("Unsupported statement node '" + node.kind + "'", node)
        return hir_empty_node("IRExprStatement", span)
    }

    fn call_result_type(self, symbol: HIRSymbol) -> HIRType {
        if not symbol.found { return hir_type("any") }
        if symbol.kind == "struct" { return symbol.type_info }
        if len(symbol.type_info.return_types) > 0 { return symbol.type_info.return_types[0] }
        return hir_type("any")
    }

    fn inferred_call_result_type(self, symbol: HIRSymbol, args: Array<HIRNode>) -> HIRType {
        var declared = self.call_result_type(symbol)
        if len(declared.arguments) == 0 or not contains(symbol.kind, "enum::") { return declared }
        var inferred: Array<HIRType> = []
        for r in 0..len(declared.arguments)-1 {
            var declared_argument = declared.arguments[r]
            var replacement = hir_type("any")
            for p in 0..len(symbol.type_info.parameter_types)-1 {
                if p < len(args) and symbol.type_info.parameter_types[p].name == declared_argument.name {
                    replacement = args[p].type_info
                    break
                }
            }
            inferred.push(replacement)
        }
        return HIRType(declared.name, inferred, declared.optional, declared.pointer, [], [])
    }

    fn specialize_pattern_type(self, declared: HIRType, variant_result: HIRType,
        subject_type: HIRType) -> HIRType {
        if variant_result.name != subject_type.name { return declared }
        for i in 0..len(variant_result.arguments)-1 {
            if i < len(subject_type.arguments) and variant_result.arguments[i].name == declared.name {
                return subject_type.arguments[i]
            }
        }
        return declared
    }

    fn binary_type(self, node: ASTNode, left: HIRNode, right: HIRNode) -> HIRType {
        if node.type_name != "" { return hir_type_from_name(node.type_name) }
        if node.op == "==" or node.op == "!=" or node.op == "<" or node.op == ">" or
            node.op == "<=" or node.op == ">=" or node.op == "and" or node.op == "or" or
            node.op == "&&" or node.op == "||" {
            return hir_type("bool")
        }
        if node.op == "+" and (left.type_info.name == "string" or right.type_info.name == "string") {
            return hir_type("string")
        }
        if left.type_info.name == "float" or right.type_info.name == "float" { return hir_type("float") }
        if left.type_info.name != "any" { return left.type_info }
        return right.type_info
    }

    fn common_element_type(self, elements: Array<HIRNode>) -> HIRType {
        if len(elements) == 0 { return hir_type("any") }
        var current = elements[0].type_info
        for i in 1..len(elements)-1 {
            var candidate = elements[i].type_info
            if hir_types_equal(current, candidate) { continue }
            if (current.name == "int" or current.name == "float") and
                (candidate.name == "int" or candidate.name == "float") {
                current = hir_type("float")
            } else {
                return hir_type("any")
            }
        }
        return current
    }

    fn lower_pattern(self, node: ASTNode, expected_type: HIRType) -> HIRNode {
        if node.kind == "Identifier" {
            var result = hir_empty_node("IRReference", self.span(node))
            result.name = node.name
            result.type_info = expected_type
            result.has_type = true
            if node.name == "_" {
                result.symbol = "pattern::_"
                return result
            }
            var symbol = HIRSymbol(node.name, self.next_symbol(node.name),
                expected_type, "pattern-binding", true)
            self.declare_symbol(symbol, node)
            result.symbol = symbol.identity
            return result
        }
        if node.kind == "FunctionCall" {
            var symbol = self.resolve_symbol(node.name)
            var args: Array<HIRNode> = []
            var variant_result = self.call_result_type(symbol)
            for i in 0..len(node.children)-1 {
                var payload_type = hir_type("any")
                if symbol.found and contains(symbol.kind, "enum::") and i < len(symbol.type_info.parameter_types) {
                    payload_type = self.specialize_pattern_type(
                        symbol.type_info.parameter_types[i], variant_result, expected_type)
                }
                args.push(self.lower_pattern(node.children[i], payload_type))
            }
            var result = hir_empty_node("IRCall", self.span(node))
            result.name = node.name
            result.symbol = "pattern-constructor::" + node.name
            if symbol.found { result.symbol = symbol.identity }
            result.first = args
            result.type_info = variant_result
            if symbol.found and contains(symbol.kind, "enum::") {
                // A payload variant's trailing generic parameters can only be
                // recovered from the matched subject (Success<T> cannot infer
                // E from its payload). Keep the pattern constructor at the
                // concrete subject type so HIR matches ordinary constructor
                // calls and remains parity-stable with the Python lowerer.
                if expected_type.name == variant_result.name and len(expected_type.arguments) > 0 {
                    result.type_info = expected_type
                } else {
                    result.type_info = hir_type(variant_result.name)
                }
            }
            result.has_type = true
            return result
        }
        return self.lower_expr(node)
    }

    fn lower_pipeline(self, node: ASTNode) -> HIRNode {
        var left = self.lower_expr(node.children[0])
        var target = node.children[1]
        var callee = ""
        var raw_args: Array<ASTNode> = []
        if target.kind == "Identifier" { callee = target.name }
        elif target.kind == "FunctionCall" { callee = target.name; raw_args = target.children }
        else {
            self.fail("Pipeline target must be a function name or call", target)
            return hir_empty_node("IRCall", self.span(node))
        }
        var symbol = self.resolve_symbol(callee)
        if not symbol.found { self.fail("Unresolved pipeline function '" + callee + "'", target) }
        var args: Array<HIRNode> = [left]
        for i in 0..len(raw_args)-1 { args.push(self.lower_expr(raw_args[i])) }
        var result = hir_empty_node("IRCall", self.span(node))
        result.name = callee
        result.symbol = symbol.identity
        result.first = args
        result.type_info = self.call_result_type(symbol)
        result.has_type = true
        return result
    }

    fn lower_lambda_with_types(self, node: ASTNode, parameter_types: Array<HIRType>) -> HIRNode {
        self.counter = self.counter + 1
        var identity = self.current_owner + "::lambda::" + to_string(self.counter)
        self.enter_scope()
        var parameters: Array<HIRNode> = []
        var actual_types: Array<HIRType> = []
        for i in 0..len(node.params)-1 {
            var name = node.params[i].name
            var value_type = hir_type("any")
            if i < len(parameter_types) { value_type = parameter_types[i] }
            var symbol_id = identity + "::param::" + to_string(i) + "::" + name
            self.declare_symbol(HIRSymbol(name, symbol_id, value_type, "lambda-param", true), node)
            var parameter = self.parameter(FunctionParam(name, "", "", []), symbol_id, node)
            parameter.type_info = value_type
            parameter.has_type = true
            parameters.push(parameter)
            actual_types.push(value_type)
        }
        var body = self.lower_expr(node.children[0])
        self.exit_scope()
        var result = hir_empty_node("IRLambda", self.span(node))
        result.first = parameters
        result.second = [body]
        result.type_info = hir_function_type(actual_types, body.type_info)
        result.has_type = true
        return result
    }

    fn lower_expr(self, node: ASTNode) -> HIRNode {
        var span = self.span(node)
        if node.kind == "Number" {
            var result = hir_empty_node("IRLiteral", span)
            result.value = hir_normalize_number_literal(node.value)
            result.value_kind = "int"
            result.type_info = hir_type("int")
            if contains(node.value, ".") {
                result.value_kind = "float"
                result.type_info = hir_type("float")
            }
            result.has_type = true
            return result
        }
        if node.kind == "String" {
            var result = hir_empty_node("IRLiteral", span)
            result.value = node.value
            result.value_kind = "string"
            result.type_info = hir_type("string")
            result.has_type = true
            return result
        }
        if node.kind == "Boolean" {
            var result = hir_empty_node("IRLiteral", span)
            result.value = node.value
            result.value_kind = "bool"
            result.type_info = hir_type("bool")
            result.has_type = true
            return result
        }
        if node.kind == "Null" {
            var result = hir_empty_node("IRLiteral", span)
            result.value = "null"
            result.value_kind = "null"
            result.type_info = hir_null_type()
            result.has_type = true
            return result
        }
        if node.kind == "Identifier" {
            var symbol = self.resolve_symbol(node.name)
            if not symbol.found { self.fail("Unresolved identifier '" + node.name + "'", node) }
            var result = hir_empty_node("IRReference", span)
            result.name = node.name
            result.symbol = symbol.identity
            result.type_info = symbol.type_info
            result.has_type = true
            return result
        }
        if node.kind == "BinaryOp" {
            if node.op == "|>" { return self.lower_pipeline(node) }
            var left = self.lower_expr(node.children[0])
            var right = self.lower_expr(node.children[1])
            var result = hir_empty_node("IRBinary", span)
            result.first = [left]
            result.second = [right]
            result.op = node.op
            result.type_info = self.binary_type(node, left, right)
            result.has_type = true
            return result
        }
        if node.kind == "UnaryOp" {
            var expr = self.lower_expr(node.children[0])
            var result = hir_empty_node("IRUnary", span)
            result.first = [expr]
            result.op = node.op
            result.type_info = expr.type_info
            if node.op == "!" or node.op == "not" { result.type_info = hir_type("bool") }
            result.has_type = true
            return result
        }
        if node.kind == "MatchExpr" {
            if len(node.children) < 2 {
                self.fail("Match expression has no arms", node)
                return hir_empty_node("IRLiteral", span)
            }
            var fallback_case = node.children[len(node.children)-1]
            if fallback_case.kind != "MatchExprCase" or len(fallback_case.children) < 2 or
                fallback_case.children[0].kind != "Identifier" or
                fallback_case.children[0].name != "_" {
                self.fail("Match expression is not exhaustive", node)
                return hir_empty_node("IRLiteral", span)
            }
            var subject = self.lower_expr(node.children[0])
            var cases: Array<HIRNode> = []
            var arm_values: Array<HIRNode> = []
            var case_index = 1
            while case_index < len(node.children) {
                var match_case = node.children[case_index]
                if match_case.kind == "MatchExprCase" and len(match_case.children) >= 2 {
                    var pattern = match_case.children[0]
                    var lowered_value = self.lower_expr(match_case.children[1])
                    var lowered_case = hir_empty_node("IRMatchExpressionCase", self.span(pattern))
                    if pattern.kind != "Identifier" or pattern.name != "_" {
                        lowered_case.first = [self.lower_expr(pattern)]
                    }
                    lowered_case.second = [lowered_value]
                    cases.push(lowered_case)
                    arm_values.push(lowered_value)
                }
                case_index = case_index + 1
            }
            var result = hir_empty_node("IRMatchExpression", span)
            result.first = [subject]
            result.items = cases
            result.type_info = self.common_element_type(arm_values)
            result.has_type = true
            return result
        }
        if node.kind == "ConditionalExpr" {
            if len(node.children) < 3 {
                self.fail("Conditional expression requires an else value", node)
                return hir_empty_node("IRConditional", span)
            }
            var else_expr = self.lower_expr(node.children[len(node.children)-1])
            var branch_index = len(node.children) - 2
            while branch_index >= 2 {
                var branch = node.children[branch_index]
                if branch.kind == "ConditionalBranch" and len(branch.children) >= 2 {
                    var lowered_condition = self.lower_expr(branch.children[0])
                    var lowered_value = self.lower_expr(branch.children[1])
                    var nested = hir_empty_node("IRConditional", self.span(branch))
                    nested.first = [lowered_condition]
                    nested.second = [lowered_value]
                    nested.third = [else_expr]
                    nested.type_info = self.common_element_type([lowered_value, else_expr])
                    nested.has_type = true
                    else_expr = nested
                }
                branch_index = branch_index - 1
            }
            var then_expr = self.lower_expr(node.children[1])
            var result = hir_empty_node("IRConditional", span)
            result.first = [self.lower_expr(node.children[0])]
            result.second = [then_expr]
            result.third = [else_expr]
            result.type_info = self.common_element_type([then_expr, else_expr])
            result.has_type = true
            return result
        }
        if node.kind == "Await" {
            var expr = self.lower_expr(node.children[0])
            var result_type = hir_type("any")
            if expr.type_info.name == "Task" and len(expr.type_info.arguments) == 1 {
                result_type = expr.type_info.arguments[0]
            }
            var result = hir_empty_node("IRAwait", span)
            result.first = [expr]
            result.type_info = result_type
            result.has_type = true
            return result
        }
        if node.kind == "ResultPropagate" {
            var expr = self.lower_expr(node.children[0])
            var result_type = hir_type("any")
            if expr.type_info.name == "Result" and len(expr.type_info.arguments) == 2 {
                result_type = expr.type_info.arguments[0]
            }
            var result = hir_empty_node("IRResultPropagate", span)
            result.first = [expr]
            result.type_info = result_type
            result.has_type = true
            return result
        }
        if node.kind == "FunctionCall" {
            if (node.name == "map" or node.name == "filter" or node.name == "fold") and len(node.children) > 0 {
                var collection = self.lower_expr(node.children[0])
                var element_type = hir_type("any")
                if collection.type_info.name == "Array" and len(collection.type_info.arguments) == 1 {
                    element_type = collection.type_info.arguments[0]
                }
                var collection_args: Array<HIRNode> = [collection]
                var result_type = hir_type("any")
                if node.name == "map" and len(node.children) == 2 {
                    var callback = self.lower_lambda_with_types(node.children[1], [element_type])
                    collection_args.push(callback)
                    result_type = HIRType("Array", [callback.type_info.return_types[0]], false, false, [], [])
                } elif node.name == "filter" and len(node.children) == 2 {
                    collection_args.push(self.lower_lambda_with_types(node.children[1], [element_type]))
                    result_type = collection.type_info
                } elif node.name == "fold" and len(node.children) == 3 {
                    var initial = self.lower_expr(node.children[1])
                    collection_args.push(initial)
                    collection_args.push(self.lower_lambda_with_types(node.children[2], [initial.type_info, element_type]))
                    result_type = initial.type_info
                }
                var collection_symbol = self.resolve_symbol(node.name)
                var collection_call = hir_empty_node("IRCall", span)
                collection_call.name = node.name
                collection_call.symbol = collection_symbol.identity
                collection_call.first = collection_args
                collection_call.type_info = result_type
                collection_call.has_type = true
                return collection_call
            }
            var args: Array<HIRNode> = []
            for i in 0..len(node.children)-1 { args.push(self.lower_expr(node.children[i])) }
            var symbol = self.resolve_symbol(node.name)
            if not symbol.found { self.fail("Unresolved function or constructor '" + node.name + "'", node) }
            var param_count = len(symbol.type_info.parameter_types)
            if len(args) < param_count {
                var callee_params = self.lookup_function_params(node.name)
                for i in len(args)..param_count-1 {
                    if i < len(callee_params) and len(callee_params[i].default_expr) > 0 {
                        args.push(self.lower_expr(callee_params[i].default_expr[0]))
                    }
                }
            }
            var result = hir_empty_node("IRCall", span)
            result.name = node.name
            result.symbol = symbol.identity
            result.first = args
            result.type_info = self.inferred_call_result_type(symbol, args)
            if symbol.identity == "builtin::Ok" and len(args) > 0 {
                result.type_info = HIRType("Result", [args[0].type_info, hir_type("any")], false, false, [], [])
            } elif symbol.identity == "builtin::Err" and len(args) > 0 {
                result.type_info = HIRType("Result", [hir_type("any"), args[0].type_info], false, false, [], [])
            }
            result.has_type = true
            return result
        }
        if node.kind == "MemberAccess" {
            var receiver = self.lower_expr(node.children[0])
            if len(node.children) > 1 and node.children[1].kind == "MethodCall" {
                var method_ast = node.children[1]
                var args: Array<HIRNode> = []
                for i in 0..len(method_ast.children)-1 { args.push(self.lower_expr(method_ast.children[i])) }
                var call = hir_empty_node("IRCall", span)
                call.name = node.name
                call.symbol = "method::" + receiver.type_info.canonical() + "::" + node.name
                call.first = args
                call.second = [receiver]
                var call_type = hir_type("any")
                if (receiver.type_info.name == "Array" or receiver.type_info.name == "string" or receiver.type_info.name == "Iterator") and
                    (node.name == "len" or node.name == "length" or node.name == "size") and
                    len(args) == 0 {
                    call_type = hir_type("int")
                }
                call.type_info = call_type
                call.has_type = true
                return call
            }
            var value_type = self.lookup_struct_field(receiver.type_info.name, node.name)
            if node.is_safe { value_type = hir_optional_type(value_type) }
            var result = hir_empty_node("IRMemberAccess", span)
            result.name = node.name
            result.first = [receiver]
            result.flag_a = node.is_safe
            result.type_info = value_type
            result.has_type = true
            return result
        }
        if node.kind == "IndexAccess" {
            var obj = self.lower_expr(node.children[0])
            var index = self.lower_expr(node.children[1])
            var value_type = hir_type("any")
            if obj.type_info.name == "Array" and len(obj.type_info.arguments) > 0 {
                value_type = obj.type_info.arguments[0]
            } elif obj.type_info.name == "Iterator" and len(obj.type_info.arguments) > 0 {
                value_type = obj.type_info.arguments[0]
            } elif obj.type_info.name == "string" {
                value_type = hir_type("string")
            }
            var result = hir_empty_node("IRIndexAccess", span)
            result.first = [obj]
            result.second = [index]
            result.type_info = value_type
            result.has_type = true
            return result
        }
        if node.kind == "Array" {
            var elements: Array<HIRNode> = []
            for i in 0..len(node.children)-1 { elements.push(self.lower_expr(node.children[i])) }
            var result = hir_empty_node("IRArray", span)
            result.first = elements
            result.type_info = hir_array_type(self.common_element_type(elements))
            result.has_type = true
            return result
        }
        if node.kind == "NullCoalesce" {
            var left = self.lower_expr(node.children[0])
            var right = self.lower_expr(node.children[1])
            var value_type = left.type_info
            if left.type_info.name == "null" { value_type = right.type_info }
            else { value_type.optional = false }
            var result = hir_empty_node("IRNullCoalesce", span)
            result.first = [left]
            result.second = [right]
            result.type_info = value_type
            result.has_type = true
            return result
        }
        if node.kind == "Lambda" {
            var parameter_types: Array<HIRType> = []
            for i in 0..len(node.params)-1 { parameter_types.push(hir_type("any")) }
            return self.lower_lambda_with_types(node, parameter_types)
        }
        self.fail("Unsupported expression node '" + node.kind + "'", node)
        return hir_empty_node("IRLiteral", span)
    }
}
