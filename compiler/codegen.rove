#target cpp
#native include <string>
#native include <vector>

// =========================================================
// ROVE SELF-HOSTING C++20 CODE GENERATOR (PHASE 4.0.7)
// =========================================================

struct CodeGen {
    indent_level: int,
    output: string,
    in_function: bool
}

impl CodeGen {
    fn create() -> CodeGen {
        return CodeGen(0, "", false)
    }

    fn emit(self, s: string) {
        self.output = self.output + s
    }

    fn emit_line(self, s: string) {
        var indent = ""
        for i in 0..self.indent_level-1 {
            indent = indent + "    "
        }
        self.output = self.output + indent + s + "\n"
    }

    fn quote_string(self, value: string) -> string {
        var escaped = ""
        for i in 0..len(value)-1 {
            var ch = value[i]
            if ch == "\\" {
                escaped = escaped + "\\\\"
            } elif ch == "\"" {
                escaped = escaped + "\\\""
            } elif ch == "\n" {
                escaped = escaped + "\\n"
            } elif ch == "\r" {
                escaped = escaped + "\\r"
            } elif ch == "\t" {
                escaped = escaped + "\\t"
            } else {
                escaped = escaped + ch
            }
        }
        return "std::string(\"" + escaped + "\", sizeof(\"" + escaped + "\") - 1)"
    }

    fn map_type(self, t: string) -> string {
        if t == "int" { return "int64_t" }
        if t == "float" { return "double" }
        if t == "string" { return "std::string" }
        if t == "bool" { return "bool" }
        if t == "void" { return "void" }
        if t == "" { return "auto" }
        if len(t) > 1 and t[len(t)-1] == "?" {
            var base = ""
            for i in 0..len(t)-2 { base = base + t[i] }
            return "std::optional<" + self.map_type(base) + ">"
        }
        if len(t) > 1 and t[0] == "*" {
            var base = ""
            for i in 1..len(t)-1 { base = base + t[i] }
            return self.map_type(base) + "*"
        }
        if len(t) > 7 and t[0] == "A" and t[1] == "r" and t[2] == "r" and t[3] == "a" and t[4] == "y" and t[5] == "<" and t[len(t)-1] == ">" {
            var inner = ""
            for i in 6..len(t)-2 { inner = inner + t[i] }
            return "std::vector<" + self.map_type(inner) + ">"
        }
        return t
    }

    fn gen_args(self, args: Array<ASTNode>) -> string {
        var result = ""
        for i in 0..len(args)-1 {
            if i > 0 { result = result + ", " }
            result = result + self.gen_expr(args[i])
        }
        return result
    }

    fn gen_expr(self, node: ASTNode) -> string {
        if node.kind == "Number" { return node.value }
        if node.kind == "String" { return self.quote_string(node.value) }
        if node.kind == "Boolean" { return node.value }
        if node.kind == "Null" { return "nullptr" }
        if node.kind == "Identifier" {
            if node.name == "self" { return "this" }
            return node.name
        }
        if node.kind == "BinaryOp" {
            if len(node.children) >= 2 {
                var left = self.gen_expr(node.children[0])
                var right = self.gen_expr(node.children[1])
                var cpp_op = node.op
                if cpp_op == "and" { cpp_op = "&&" }
                if cpp_op == "or" { cpp_op = "||" }
                return "(" + left + " " + cpp_op + " " + right + ")"
            }
        }
        if node.kind == "UnaryOp" {
            if len(node.children) >= 1 {
                var inner = self.gen_expr(node.children[0])
                var cpp_op = node.op
                if cpp_op == "not" { cpp_op = "!" }
                return "(" + cpp_op + inner + ")"
            }
        }
        if node.kind == "FunctionCall" {
            var args_str = self.gen_args(node.children)
            if node.name == "print" or node.name == "println" {
                return "_nyx_print(" + args_str + ")"
            }
            if node.name == "len" { return "_nyx_len(" + args_str + ")" }
            if node.name == "args" { return "_nyx_args()" }
            if node.name == "contains" { return "_nyx_contains(" + args_str + ")" }
            if node.name == "to_string" or node.name == "to_str" {
                return "_nyx_to_string(" + args_str + ")"
            }
            if node.name == "to_int" { return "_nyx_to_int(" + args_str + ")" }
            if node.name == "main" { return "_nyx_user_main(" + args_str + ")" }
            return node.name + "(" + args_str + ")"
        }
        if node.kind == "Array" {
            return "{" + self.gen_args(node.children) + "}"
        }
        if node.kind == "IndexAccess" {
            if len(node.children) >= 2 {
                var arr = self.gen_expr(node.children[0])
                var idx = self.gen_expr(node.children[1])
                return "_nyx_index(" + arr + ", " + idx + ")"
            }
        }
        if node.kind == "MemberAccess" {
            if len(node.children) >= 1 {
                var obj = self.gen_expr(node.children[0])
                var separator = "."
                if obj == "this" { separator = "->" }
                if len(node.children) >= 2 and node.children[1].kind == "MethodCall" {
                    var method = node.name
                    if method == "push" { method = "push_back" }
                    if method == "len" or method == "length" or method == "size" {
                        return "static_cast<int64_t>(" + obj + separator + "size())"
                    }
                    return obj + separator + method + "(" + self.gen_args(node.children[1].children) + ")"
                }
                return obj + separator + node.name
            }
        }
        return ""
    }

    fn gen_params(self, node: ASTNode, is_method: bool) -> string {
        var result = ""
        var emitted = 0
        for i in 0..len(node.params)-1 {
            var p = node.params[i]
            if is_method and p.name == "self" { continue }
            if emitted > 0 { result = result + ", " }
            result = result + self.map_type(p.type_annot) + " " + p.name
            emitted = emitted + 1
        }
        return result
    }

    fn gen_function(self, node: ASTNode, is_method: bool) {
        var ret_type = self.map_type(node.type_name)
        var fn_name = node.name
        if fn_name == "main" { fn_name = "_nyx_user_main" }
        var prefix = ""
        if is_method and (len(node.params) == 0 or node.params[0].name != "self") {
            prefix = "static "
        }
        self.emit_line(prefix + ret_type + " " + fn_name + "(" + self.gen_params(node, is_method) + ") {")
        self.indent_level = self.indent_level + 1
        for i in 0..len(node.children)-1 {
            self.gen_stmt(node.children[i])
        }
        self.indent_level = self.indent_level - 1
        self.emit_line("}")
    }

    fn gen_struct(self, node: ASTNode, stmts: Array<ASTNode>) {
        self.emit_line("struct " + node.name + " {")
        self.indent_level = self.indent_level + 1

        for i in 0..len(node.params)-1 {
            var field = node.params[i]
            self.emit_line(self.map_type(field.type_annot) + " " + field.name + "{};")
        }

        self.emit_line(node.name + "() = default;")
        if len(node.params) > 0 {
            var params_str = ""
            var init_str = ""
            for i in 0..len(node.params)-1 {
                var field = node.params[i]
                if i > 0 {
                    params_str = params_str + ", "
                    init_str = init_str + ", "
                }
                params_str = params_str + self.map_type(field.type_annot) + " _nyx_" + field.name
                init_str = init_str + field.name + "(std::move(_nyx_" + field.name + "))"
            }
            self.emit_line(node.name + "(" + params_str + ") : " + init_str + " {}")
        }

        for i in 0..len(stmts)-1 {
            var candidate = stmts[i]
            if candidate.kind == "ImplBlock" and candidate.name == node.name {
                for j in 0..len(candidate.children)-1 {
                    if candidate.children[j].kind == "FunctionDef" {
                        self.gen_function(candidate.children[j], true)
                    }
                }
            }
        }

        self.indent_level = self.indent_level - 1
        self.emit_line("};")
        self.emit_line("")
    }

    fn gen_extern(self, node: ASTNode) {
        var prefix = ""
        if node.value == "C" { prefix = "extern \"C\" " }
        self.emit_line(prefix + self.map_type(node.type_name) + " " + node.name + "(" + self.gen_params(node, false) + ");")
    }

    fn gen_stmt(self, node: ASTNode) {
        if node.kind == "VarDecl" {
            var cpp_type = self.map_type(node.type_name)
            var init_str = ""
            if len(node.children) > 0 {
                init_str = " = " + self.gen_expr(node.children[0])
            }
            if node.is_const {
                self.emit_line("const " + cpp_type + " " + node.name + init_str + ";")
            } else {
                self.emit_line(cpp_type + " " + node.name + init_str + ";")
            }
            return
        }

        if node.kind == "Assign" {
            if len(node.children) >= 2 {
                var target = self.gen_expr(node.children[0])
                var val = self.gen_expr(node.children[1])
                self.emit_line(target + " = " + val + ";")
            }
            return
        }

        if node.kind == "If" {
            if len(node.children) >= 1 {
                var cond = self.gen_expr(node.children[0])
                self.emit_line("if (" + cond + ") {")
                self.indent_level = self.indent_level + 1
                var idx = 1
                while idx < len(node.children) and node.children[idx].kind != "ElifBlock" and node.children[idx].kind != "ElseBlock" {
                    self.gen_stmt(node.children[idx])
                    idx = idx + 1
                }
                self.indent_level = self.indent_level - 1
                self.emit_line("}")

                while idx < len(node.children) and node.children[idx].kind == "ElifBlock" {
                    var branch = node.children[idx]
                    if len(branch.children) > 0 {
                        self.emit_line("else if (" + self.gen_expr(branch.children[0]) + ") {")
                        self.indent_level = self.indent_level + 1
                        for j in 1..len(branch.children)-1 {
                            self.gen_stmt(branch.children[j])
                        }
                        self.indent_level = self.indent_level - 1
                        self.emit_line("}")
                    }
                    idx = idx + 1
                }

                if idx < len(node.children) and node.children[idx].kind == "ElseBlock" {
                    self.emit_line("else {")
                    self.indent_level = self.indent_level + 1
                    for j in 0..len(node.children[idx].children)-1 {
                        self.gen_stmt(node.children[idx].children[j])
                    }
                    self.indent_level = self.indent_level - 1
                    self.emit_line("}")
                }
            }
            return
        }

        if node.kind == "While" {
            if len(node.children) >= 1 {
                var cond = self.gen_expr(node.children[0])
                self.emit_line("while (" + cond + ") {")
                self.indent_level = self.indent_level + 1
                for i in 1..len(node.children)-1 {
                    self.gen_stmt(node.children[i])
                }
                self.indent_level = self.indent_level - 1
                self.emit_line("}")
            }
            return
        }

        if node.kind == "For" {
            if len(node.children) >= 2 {
                if node.children[1].kind == "Null" {
                    self.emit_line("for (auto& " + node.name + " : " + self.gen_expr(node.children[0]) + ") {")
                } else {
                    self.emit_line("for (int64_t " + node.name + " = " + self.gen_expr(node.children[0]) + "; " + node.name + " <= static_cast<int64_t>(" + self.gen_expr(node.children[1]) + "); ++" + node.name + ") {")
                }
                self.indent_level = self.indent_level + 1
                for i in 2..len(node.children)-1 {
                    self.gen_stmt(node.children[i])
                }
                self.indent_level = self.indent_level - 1
                self.emit_line("}")
            }
            return
        }

        if node.kind == "Loop" {
            self.emit_line("while (true) {")
            self.indent_level = self.indent_level + 1
            for i in 0..len(node.children)-1 { self.gen_stmt(node.children[i]) }
            self.indent_level = self.indent_level - 1
            self.emit_line("}")
            return
        }

        if node.kind == "Break" { self.emit_line("break;"); return }
        if node.kind == "Continue" { self.emit_line("continue;"); return }

        if node.kind == "UnsafeBlock" {
            self.emit_line("// unsafe boundary")
            for i in 0..len(node.children)-1 { self.gen_stmt(node.children[i]) }
            return
        }

        if node.kind == "Spawn" {
            self.emit_line("std::thread([=]() mutable {")
            self.indent_level = self.indent_level + 1
            for i in 0..len(node.children)-1 { self.gen_stmt(node.children[i]) }
            self.indent_level = self.indent_level - 1
            self.emit_line("}).detach();")
            return
        }

        if node.kind == "Return" {
            if len(node.children) > 0 and node.children[0].kind != "Null" {
                var val = self.gen_expr(node.children[0])
                self.emit_line("return " + val + ";")
            } else {
                self.emit_line("return;")
            }
            return
        }

        if node.kind == "FunctionCall" or node.kind == "MemberAccess" {
            var expr = self.gen_expr(node)
            if expr != "" { self.emit_line(expr + ";") }
            return
        }

        if node.kind == "FunctionDef" {
            self.gen_function(node, false)
            self.emit_line("")
            return
        }

        if node.kind == "ExternFn" { self.gen_extern(node); return }
    }

    fn generate(self, stmts: Array<ASTNode>) -> string {
        self.output = ""
        self.indent_level = 0
        self.emit_line("// Auto-generated by the Rove self-host compiler")
        self.emit_line("#ifndef _CRT_SECURE_NO_WARNINGS")
        self.emit_line("#define _CRT_SECURE_NO_WARNINGS")
        self.emit_line("#endif")
        self.emit_line("#include <iostream>")
        self.emit_line("#include <string>")
        self.emit_line("#include <vector>")
        self.emit_line("#include <cstdint>")
        self.emit_line("#include <cstdlib>")
        self.emit_line("#include <cstdio>")
        self.emit_line("#include <fstream>")
        self.emit_line("#include <optional>")
        self.emit_line("#include <sstream>")
        self.emit_line("#include <thread>")
        self.emit_line("#include <utility>")
        self.emit_line("#ifdef _WIN32")
        self.emit_line("#include <process.h>")
        self.emit_line("#else")
        self.emit_line("#include <sys/types.h>")
        self.emit_line("#include <sys/wait.h>")
        self.emit_line("#include <unistd.h>")
        self.emit_line("#endif")
        self.emit_line("")

        self.emit_line("inline void _nyx_print() { std::cout << '\\n'; }")
        self.emit_line("template <typename First, typename... Rest>")
        self.emit_line("void _nyx_print(First&& first, Rest&&... rest) {")
        self.indent_level = self.indent_level + 1
        self.emit_line("std::cout << std::boolalpha << std::forward<First>(first);")
        self.emit_line("((std::cout << ' ' << std::forward<Rest>(rest)), ...);")
        self.emit_line("std::cout << '\\n';")
        self.indent_level = self.indent_level - 1
        self.emit_line("}")
        self.emit_line("inline std::string _nyx_to_string(const std::string& value) { return value; }")
        self.emit_line("inline std::string _nyx_to_string(bool value) { return value ? \"true\" : \"false\"; }")
        self.emit_line("template <typename T> std::string _nyx_to_string(const T& value) { std::ostringstream stream; stream << value; return stream.str(); }")
        self.emit_line("inline int64_t _nyx_to_int(const std::string& value) { try { return std::stoll(value); } catch (...) { return 0; } }")
        self.emit_line("inline std::string _nyx_utf8_from_codepoint(int64_t raw_codepoint) {")
        self.indent_level = self.indent_level + 1
        self.emit_line("uint32_t codepoint = static_cast<uint32_t>(raw_codepoint);")
        self.emit_line("if (raw_codepoint < 0 || codepoint > 0x10FFFF || (codepoint >= 0xD800 && codepoint <= 0xDFFF)) codepoint = 0xFFFD;")
        self.emit_line("std::string result;")
        self.emit_line("if (codepoint <= 0x7F) { result.push_back(static_cast<char>(codepoint)); }")
        self.emit_line("else if (codepoint <= 0x7FF) { result.push_back(static_cast<char>(0xC0 | (codepoint >> 6))); result.push_back(static_cast<char>(0x80 | (codepoint & 0x3F))); }")
        self.emit_line("else if (codepoint <= 0xFFFF) { result.push_back(static_cast<char>(0xE0 | (codepoint >> 12))); result.push_back(static_cast<char>(0x80 | ((codepoint >> 6) & 0x3F))); result.push_back(static_cast<char>(0x80 | (codepoint & 0x3F))); }")
        self.emit_line("else { result.push_back(static_cast<char>(0xF0 | (codepoint >> 18))); result.push_back(static_cast<char>(0x80 | ((codepoint >> 12) & 0x3F))); result.push_back(static_cast<char>(0x80 | ((codepoint >> 6) & 0x3F))); result.push_back(static_cast<char>(0x80 | (codepoint & 0x3F))); }")
        self.emit_line("return result;")
        self.indent_level = self.indent_level - 1
        self.emit_line("}")
        self.emit_line("inline bool _nyx_contains(const std::string& value, const std::string& part) { return value.find(part) != std::string::npos; }")
        self.emit_line("template <typename T> int64_t _nyx_len(const T& value) { return static_cast<int64_t>(value.size()); }")
        self.emit_line("inline std::string _nyx_index(const std::string& value, int64_t index) { if (index < 0 || static_cast<size_t>(index) >= value.size()) return {}; return std::string(1, value[static_cast<size_t>(index)]); }")
        self.emit_line("template <typename T> T& _nyx_index(std::vector<T>& value, int64_t index) { return value[static_cast<size_t>(index)]; }")
        self.emit_line("template <typename T> const T& _nyx_index(const std::vector<T>& value, int64_t index) { return value[static_cast<size_t>(index)]; }")
        self.emit_line("inline std::vector<std::string> _nyx_cli_arguments;")
        self.emit_line("inline std::vector<std::string> _nyx_args() { return _nyx_cli_arguments; }")
        self.emit_line("inline std::string _nyx_bootstrap_read_file(const std::string& path) { std::ifstream file(path, std::ios::binary); if (!file.is_open()) return {}; std::ostringstream buffer; buffer << file.rdbuf(); return buffer.str(); }")
        self.emit_line("inline bool _nyx_bootstrap_write_file(const std::string& path, const std::string& content) { std::ofstream file(path, std::ios::binary); if (!file.is_open()) return false; file.write(content.data(), static_cast<std::streamsize>(content.size())); return file.good(); }")
        self.emit_line("inline bool _nyx_bootstrap_file_exists(const std::string& path) { std::ifstream file(path, std::ios::binary); return file.good(); }")
        self.emit_line("inline bool _nyx_bootstrap_remove_file(const std::string& path) { return std::remove(path.c_str()) == 0; }")
        self.emit_line("[[noreturn]] inline void _nyx_process_exit(int64_t code) { std::exit(static_cast<int>(code)); }")
        self.emit_line("inline std::string _nyx_toolchain_error;")
        self.emit_line("inline int _nyx_spawn_wait(const std::vector<std::string>& command) {")
        self.indent_level = self.indent_level + 1
        self.emit_line("if (command.empty()) return -1;")
        self.emit_line("std::vector<char*> arguments;")
        self.emit_line("arguments.reserve(command.size() + 1);")
        self.emit_line("for (const auto& part : command) arguments.push_back(const_cast<char*>(part.c_str()));")
        self.emit_line("arguments.push_back(nullptr);")
        self.emit_line("#ifdef _WIN32")
        self.emit_line("const intptr_t result = _spawnvp(_P_WAIT, command[0].c_str(), arguments.data());")
        self.emit_line("return result == -1 ? -1 : static_cast<int>(result);")
        self.emit_line("#else")
        self.emit_line("const pid_t child = fork();")
        self.emit_line("if (child < 0) return -1;")
        self.emit_line("if (child == 0) { execvp(command[0].c_str(), arguments.data()); _exit(127); }")
        self.emit_line("int status = 0;")
        self.emit_line("if (waitpid(child, &status, 0) < 0) return -1;")
        self.emit_line("if (WIFEXITED(status)) return WEXITSTATUS(status);")
        self.emit_line("if (WIFSIGNALED(status)) return 128 + WTERMSIG(status);")
        self.emit_line("return -1;")
        self.emit_line("#endif")
        self.indent_level = self.indent_level - 1
        self.emit_line("}")
        self.emit_line("inline int _nyx_toolchain_compile_cpp(const std::string& source, const std::string& output) {")
        self.indent_level = self.indent_level + 1
        self.emit_line("std::vector<std::string> compilers;")
        self.emit_line("if (const char* configured = std::getenv(\"ROVE_CXX\"); configured && *configured) compilers.emplace_back(configured);")
        self.emit_line("else if (const char* legacy = std::getenv(\"NYX_CXX\"); legacy && *legacy) compilers.emplace_back(legacy);")
        self.emit_line("compilers.emplace_back(\"clang++\");")
        self.emit_line("compilers.emplace_back(\"g++\");")
        self.emit_line("compilers.emplace_back(\"c++\");")
        self.emit_line("for (const auto& compiler : compilers) {")
        self.indent_level = self.indent_level + 1
        self.emit_line("const int result = _nyx_spawn_wait({compiler, \"-std=c++20\", \"-O2\", source, \"-o\", output});")
        self.emit_line("if (result == 0) { _nyx_toolchain_error.clear(); return 0; }")
        self.emit_line("if (result == -1 || result == 127) continue;")
        self.emit_line("_nyx_toolchain_error = compiler + \" exited with code \" + std::to_string(result);")
        self.emit_line("return result;")
        self.indent_level = self.indent_level - 1
        self.emit_line("}")
        self.emit_line("_nyx_toolchain_error = \"No C++20 compiler found (set ROVE_CXX or install clang++/g++; NYX_CXX remains a legacy alias)\";")
        self.emit_line("return 127;")
        self.indent_level = self.indent_level - 1
        self.emit_line("}")
        self.emit_line("inline std::string _nyx_toolchain_last_error() { return _nyx_toolchain_error; }")
        self.emit_line("")

        for i in 0..len(stmts)-1 {
            if stmts[i].kind == "Directive" and stmts[i].name == "native_include" {
                self.emit_line("#include " + stmts[i].value)
            }
            if stmts[i].kind == "Directive" and stmts[i].name == "native_raw" {
                self.emit_line(stmts[i].value)
            }
        }

        for i in 0..len(stmts)-1 {
            if stmts[i].kind == "StructDef" {
                self.emit_line("struct " + stmts[i].name + ";")
            }
        }
        self.emit_line("")

        for i in 0..len(stmts)-1 {
            if stmts[i].kind == "ExternFn" { self.gen_extern(stmts[i]) }
        }

        for i in 0..len(stmts)-1 {
            if stmts[i].kind == "FunctionDef" {
                var fn_name = stmts[i].name
                if fn_name == "main" { fn_name = "_nyx_user_main" }
                self.emit_line(self.map_type(stmts[i].type_name) + " " + fn_name + "(" + self.gen_params(stmts[i], false) + ");")
            }
        }
        self.emit_line("")

        for i in 0..len(stmts)-1 {
            if stmts[i].kind == "StructDef" {
                self.gen_struct(stmts[i], stmts)
            }
        }

        for i in 0..len(stmts)-1 {
            if stmts[i].kind == "FunctionDef" {
                self.gen_stmt(stmts[i])
            }
        }

        var has_user_main = false
        var has_explicit_main = false
        for i in 0..len(stmts)-1 {
            if stmts[i].kind == "FunctionDef" and stmts[i].name == "main" { has_user_main = true }
            if stmts[i].kind == "FunctionCall" and stmts[i].name == "main" { has_explicit_main = true }
        }

        self.emit_line("int main(int argc, char** argv) {")
        self.indent_level = self.indent_level + 1
        self.emit_line("for (int i = 0; i < argc; ++i) { _nyx_cli_arguments.emplace_back(argv[i] ? argv[i] : \"\"); }")
        for i in 0..len(stmts)-1 {
            var kind = stmts[i].kind
            if kind != "Directive" and kind != "StructDef" and kind != "ImplBlock" and kind != "TraitDef" and kind != "ExternFn" and kind != "FunctionDef" {
                self.gen_stmt(stmts[i])
            }
        }
        if has_user_main and not has_explicit_main { self.emit_line("_nyx_user_main();") }
        self.emit_line("return 0;")
        self.indent_level = self.indent_level - 1
        self.emit_line("}")

        return self.output
    }
}
