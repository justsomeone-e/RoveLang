#target cpp
#native include <string>
#native include <vector>

struct Symbol {
    name: string,
    type_name: string
}

struct StructFieldInfo {
    struct_name: string,
    field_name: string,
    field_type: string
}

struct TypeAliasInfo {
    name: string,
    actual_type: string
}

struct FunctionSignature {
    name: string,
    param_types: Array<string>,
    return_type: string,
    defaults: Array<string>,
    generic_params: Array<string>
}

struct Scope {
    symbols: Array<Symbol>,
    depth: int
}

fn typechecker_int_literal_fits_i64(value: string) -> bool {
    if value == "" { return false }
    var start = 0
    var negative = false
    if value[0] == "-" {
        negative = true
        start = 1
    }
    if start >= len(value) { return false }
    while start < len(value) - 1 and value[start] == "0" { start = start + 1 }
    var digit_count = len(value) - start
    if digit_count < 19 { return true }
    if digit_count > 19 { return false }
    var limit = "9223372036854775807"
    if negative { limit = "9223372036854775808" }
    for i in 0..18 {
        var digit = value[start + i]
        if digit < limit[i] { return true }
        if digit > limit[i] { return false }
    }
    return true
}

struct TypeChecker {
    scopes: Array<Scope>,
    struct_fields: Array<StructFieldInfo>,
    type_aliases: Array<TypeAliasInfo>,
    functions: Array<FunctionSignature>,
    current_fn_return_type: string,
    current_fn_is_async: bool,
    has_error: bool,
    error_msg: string
}

impl TypeChecker {
    fn resolve_alias(self, type_name: string) -> string {
        var current = type_name
        var steps = 0
        while steps <= len(self.type_aliases) {
            var resolved = ""
            for i in 0..len(self.type_aliases)-1 {
                if self.type_aliases[i].name == current {
                    resolved = self.type_aliases[i].actual_type
                }
            }
            if resolved == "" or resolved == current { return current }
            current = resolved
            steps = steps + 1
        }
        return current
    }

    fn validate_integer_literals(self, node: ASTNode) -> void {
        if node.kind == "Number" and not contains(node.value, ".") and
            not typechecker_int_literal_fits_i64(node.value) {
            self.has_error = true
            self.error_msg = "E2012: integer literal outside signed 64-bit range: " + node.value
        }
        for i in 0..len(node.children)-1 {
            self.validate_integer_literals(node.children[i])
        }
    }

    fn require_bool_condition(self, node: ASTNode, context: string) -> void {
        var actual = self.infer_type(node)
        if actual != "bool" and actual != "any" {
            self.has_error = true
            self.error_msg = "E2013: " + context + " condition must be bool, found " + actual
        }
    }

    fn enter_scope(self) {
        var d = len(self.scopes)
        self.scopes.push(Scope([], d))
    }

    fn exit_scope(self) {
        if len(self.scopes) > 1 {
            // pop current scope by creating a new array of length - 1
            var next_scopes: Array<Scope> = []
            for i in 0..len(self.scopes)-2 {
                next_scopes.push(self.scopes[i])
            }
            self.scopes = next_scopes
        }
    }

    fn register_symbol(self, name: string, type_name: string) {
        if len(self.scopes) == 0 {
            self.enter_scope()
        }
        var top_idx = len(self.scopes) - 1
        for i in 0..len(self.scopes[top_idx].symbols)-1 {
            if self.scopes[top_idx].symbols[i].name == name {
                self.scopes[top_idx].symbols[i].type_name = type_name
                return
            }
        }
        self.scopes[top_idx].symbols.push(Symbol(name, type_name))
    }

    fn lookup_symbol(self, name: string) -> string {
        // Search from innermost scope to outermost
        var s_idx = len(self.scopes) - 1
        while s_idx >= 0 {
            var syms = self.scopes[s_idx].symbols
            for i in 0..len(syms)-1 {
                if syms[i].name == name {
                    return syms[i].type_name
                }
            }
            s_idx = s_idx - 1
        }
        return ""
    }

    fn register_function(self, name: string, ptypes: Array<string>, ret: string, defaults: Array<string>, generic_params: Array<string>) {
        self.functions.push(FunctionSignature(name, ptypes, ret, defaults, generic_params))
        self.register_symbol(name, ret)
    }

    fn lookup_function(self, name: string) -> FunctionSignature {
        for i in 0..len(self.functions)-1 {
            if self.functions[i].name == name {
                return self.functions[i]
            }
        }
        return FunctionSignature("", [], "", [], [])
    }

    fn register_struct_field(self, sname: string, fname: string, ftype: string) {
        self.struct_fields.push(StructFieldInfo(sname, fname, ftype))
    }

    fn lookup_struct_field(self, sname: string, fname: string) -> string {
        for i in 0..len(self.struct_fields)-1 {
            if self.struct_fields[i].struct_name == sname and self.struct_fields[i].field_name == fname {
                return self.struct_fields[i].field_type
            }
        }
        return ""
    }

    fn struct_field_count(self, sname: string) -> int {
        var count = 0
        for i in 0..len(self.struct_fields)-1 {
            if self.struct_fields[i].struct_name == sname { count = count + 1 }
        }
        return count
    }

    fn struct_field_type_at(self, sname: string, field_index: int) -> string {
        var current = 0
        for i in 0..len(self.struct_fields)-1 {
            if self.struct_fields[i].struct_name == sname {
                if current == field_index { return self.struct_fields[i].field_type }
                current = current + 1
            }
        }
        return "any"
    }

    fn array_element_type(self, type_name: string) -> string {
        if len(type_name) > 7 and type_name[0] == "A" and type_name[1] == "r" and
            type_name[2] == "r" and type_name[3] == "a" and type_name[4] == "y" and
            type_name[5] == "<" and type_name[len(type_name)-1] == ">" {
            var result = ""
            for i in 6..len(type_name)-2 { result = result + type_name[i] }
            return result
        }
        return ""
    }

    fn is_compatible(self, expected: string, found: string) -> bool {
        expected = self.resolve_alias(expected)
        found = self.resolve_alias(found)
        if expected == "" or expected == "any" or found == "any" { return true }
        if expected == found { return true }
        // Empty collection literals start as Array<any>; their element type is
        // fixed by the declaration/call context. Match the reference frontend's
        // generic container compatibility during bootstrap.
        if len(expected) >= 6 and len(found) >= 6 and
            expected[0] == "A" and expected[1] == "r" and expected[2] == "r" and
            expected[3] == "a" and expected[4] == "y" and expected[5] == "<" and
            found[0] == "A" and found[1] == "r" and found[2] == "r" and
            found[3] == "a" and found[4] == "y" and found[5] == "<" {
            return true
        }
        if len(expected) >= 7 and len(found) >= 7 and
            expected[0] == "R" and expected[1] == "e" and expected[2] == "s" and
            expected[3] == "u" and expected[4] == "l" and expected[5] == "t" and expected[6] == "<" and
            found[0] == "R" and found[1] == "e" and found[2] == "s" and
            found[3] == "u" and found[4] == "l" and found[5] == "t" and found[6] == "<" {
            return true
        }
        // float accepts int
        if expected == "float" and found == "int" { return true }
        // optional accepts null or base type
        if len(expected) > 1 and expected[len(expected)-1] == "?" {
            if found == "null" { return true }
            var base = ""
            for i in 0..len(expected)-2 { base = base + expected[i] }
            if base == found { return true }
        }
        return false
    }

    fn infer_type(self, node: ASTNode) -> string {
        if node.kind == "Number" {
            if contains(node.value, ".") { return "float" }
            return "int"
        }
        if node.kind == "String" { return "string" }
        if node.kind == "Boolean" { return "bool" }
        if node.kind == "Null" { return "null" }
        
        if node.kind == "Identifier" {
            var t = self.lookup_symbol(node.name)
            if t != "" { return t }
            self.has_error = true
            self.error_msg = "Undefined variable: '" + node.name + "' at line " + to_string(node.line) + ":" + to_string(node.col)
            return "any"
        }

        if node.kind == "BinaryOp" {
            if node.op == "==" or node.op == "!=" or node.op == "<" or node.op == ">" or node.op == "<=" or node.op == ">=" or node.op == "and" or node.op == "or" {
                return "bool"
            }
            if len(node.children) >= 2 {
                var lt = self.infer_type(node.children[0])
                var rt = self.infer_type(node.children[1])
                if lt == "float" or rt == "float" { return "float" }
                if lt == "string" or rt == "string" { return "string" }
                return lt
            }
            return "int"
        }

        if node.kind == "UnaryOp" {
            if node.op == "not" or node.op == "!" { return "bool" }
            if len(node.children) > 0 { return self.infer_type(node.children[0]) }
            return "int"
        }

        if node.kind == "Await" {
            if not self.current_fn_is_async {
                self.has_error = true
                self.error_msg = "'await' is only valid inside an async function"
                return "any"
            }
            if len(node.children) == 0 { return "any" }
            var awaited_type = self.infer_type(node.children[0])
            if awaited_type == "any" { return "any" }
            if len(awaited_type) > 6 and awaited_type[0] == "T" and
                awaited_type[1] == "a" and awaited_type[2] == "s" and
                awaited_type[3] == "k" and awaited_type[4] == "<" and
                awaited_type[len(awaited_type)-1] == ">" {
                var result_type = ""
                for i in 5..len(awaited_type)-2 { result_type = result_type + awaited_type[i] }
                return result_type
            }
            self.has_error = true
            self.error_msg = "'await' operand is not a Task: " + awaited_type
            return "any"
        }

        if node.kind == "FunctionCall" {
            if node.name == "print" { return "void" }
            if node.name == "args" { return "Array<string>" }
            if node.name == "to_string" or node.name == "to_str" { return "string" }
            if node.name == "to_int" { return "int" }
            if node.name == "addr" or node.name == "peek" { return "int" }
            
            var fn_sig = self.lookup_function(node.name)
            if fn_sig.name != "" {
                var provided = len(node.children)
                var total = len(fn_sig.param_types)
                var missing_defaults_ok = true
                var idx = provided
                while idx < total {
                    if idx >= len(fn_sig.defaults) or fn_sig.defaults[idx] == "" {
                        missing_defaults_ok = false
                        break
                    }
                    idx = idx + 1
                }
                if provided > total or not missing_defaults_ok {
                    self.has_error = true
                    self.error_msg = "Function '" + node.name + "' expected " + to_string(total) + " arguments but got " + to_string(provided)
                } else {
                    for i in 0..len(node.children)-1 {
                        var arg_t = self.infer_type(node.children[i])
                        var expected = fn_sig.param_types[i]
                        var direct_generic = false
                        for g in 0..len(fn_sig.generic_params)-1 {
                            if expected == fn_sig.generic_params[g] { direct_generic = true }
                        }
                        if not direct_generic and not self.is_compatible(expected, arg_t) {
                            self.has_error = true
                            self.error_msg = "Argument " + to_string(i+1) + " type mismatch in '" + node.name + "': expected " + fn_sig.param_types[i] + " but got " + arg_t
                        }
                    }
                }
                var inferred_return = fn_sig.return_type
                for i in 0..len(node.children)-1 {
                    for g in 0..len(fn_sig.generic_params)-1 {
                        if fn_sig.param_types[i] == fn_sig.generic_params[g] and
                            inferred_return == fn_sig.generic_params[g] {
                            inferred_return = self.infer_type(node.children[i])
                        }
                    }
                }
                return inferred_return
            }

            var fn_t = self.lookup_symbol(node.name)
            if fn_t != "" { return fn_t }
            return "any"
        }

        if node.kind == "MemberAccess" {
            if len(node.children) > 0 {
                var obj_t = self.infer_type(node.children[0])
                var field_t = self.lookup_struct_field(obj_t, node.name)
                if field_t != "" { return field_t }
            }
            return "any"
        }

        if node.kind == "Array" {
            if len(node.children) > 0 {
                var elem_t = self.infer_type(node.children[0])
                return "Array<" + elem_t + ">"
            }
            return "Array<any>"
        }

        if node.kind == "IndexAccess" {
            if len(node.children) > 0 {
                var arr_t = self.infer_type(node.children[0])
                if arr_t == "string" { return "string" }
                if len(arr_t) > 7 and arr_t[0] == "A" and arr_t[1] == "r" {
                    var inner = ""
                    for i in 6..len(arr_t)-2 { inner = inner + arr_t[i] }
                    return inner
                }
            }
            return "any"
        }

        if node.kind == "ConditionalExpr" {
            if len(node.children) < 3 {
                self.has_error = true
                self.error_msg = "Conditional expression requires if and else values"
                return "any"
            }
            self.require_bool_condition(node.children[0], "if expression")
            var result_type = self.infer_type(node.children[1])
            var branch_index = 2
            while branch_index < len(node.children) - 1 {
                var branch = node.children[branch_index]
                if branch.kind == "ConditionalBranch" and len(branch.children) >= 2 {
                    self.require_bool_condition(branch.children[0], "elif expression")
                    var branch_type = self.infer_type(branch.children[1])
                    if result_type != branch_type {
                        if (result_type == "int" or result_type == "float") and
                            (branch_type == "int" or branch_type == "float") {
                            result_type = "float"
                        } else {
                            self.has_error = true
                            self.error_msg = "Conditional expression branch type mismatch: " +
                                result_type + " vs " + branch_type
                        }
                    }
                }
                branch_index = branch_index + 1
            }
            var else_type = self.infer_type(node.children[len(node.children)-1])
            if result_type != else_type {
                if (result_type == "int" or result_type == "float") and
                    (else_type == "int" or else_type == "float") {
                    result_type = "float"
                } else {
                    self.has_error = true
                    self.error_msg = "Conditional expression branch type mismatch: " +
                        result_type + " vs " + else_type
                }
            }
            return result_type
        }

        if node.kind == "MatchExpr" {
            if len(node.children) < 2 {
                self.has_error = true
                self.error_msg = "E2014: match expression requires a final '_' fallback"
                return "any"
            }
            var subject_type = self.infer_type(node.children[0])
            var result_type = "any"
            var wildcard_count = 0
            var wildcard_index = -1
            var case_index = 1
            while case_index < len(node.children) {
                var match_case = node.children[case_index]
                if match_case.kind == "MatchExprCase" and len(match_case.children) >= 2 {
                    var pattern = match_case.children[0]
                    var is_wildcard = pattern.kind == "Identifier" and pattern.name == "_"
                    if is_wildcard {
                        wildcard_count = wildcard_count + 1
                        wildcard_index = case_index
                    } elif pattern.kind == "Identifier" {
                        self.has_error = true
                        self.error_msg = "E2015: match expression supports literal patterns and '_' fallback"
                    } else {
                        var pattern_type = self.infer_type(pattern)
                        if not self.is_compatible(subject_type, pattern_type) and
                            not self.is_compatible(pattern_type, subject_type) {
                            self.has_error = true
                            self.error_msg = "Match expression pattern type mismatch: " +
                                subject_type + " vs " + pattern_type
                        }
                    }
                    var arm_type = self.infer_type(match_case.children[1])
                    if result_type == "any" { result_type = arm_type }
                    elif result_type != arm_type {
                        if (result_type == "int" or result_type == "float") and
                            (arm_type == "int" or arm_type == "float") {
                            result_type = "float"
                        } else {
                            self.has_error = true
                            self.error_msg = "Match expression arm type mismatch: " +
                                result_type + " vs " + arm_type
                        }
                    }
                }
                case_index = case_index + 1
            }
            if wildcard_count != 1 or wildcard_index != len(node.children) - 1 {
                self.has_error = true
                self.error_msg = "E2014: match expression must end with exactly one '_' fallback"
            }
            return result_type
        }

        return "any"
    }

    fn check_statement(self, node: ASTNode) {
        if node.kind == "VarDecl" {
            var inferred = "any"
            if len(node.children) > 0 {
                inferred = self.infer_type(node.children[0])
            }
            var decl_type = node.type_name
            if decl_type != "" {
                if not self.is_compatible(decl_type, inferred) {
                    self.has_error = true
                    self.error_msg = "Type mismatch in variable '" + node.name + "': expected " + decl_type + " but found " + inferred
                }
            } else {
                decl_type = inferred
            }
            self.register_symbol(node.name, decl_type)
            return
        }

        if node.kind == "DestructureDecl" {
            if len(node.children) < 2 {
                self.has_error = true
                self.error_msg = "Destructuring requires bindings and an initializer"
                return
            }
            var initializer_type = self.infer_type(node.children[len(node.children)-1])
            var binding_count = len(node.children) - 1
            if node.value == "array" {
                var element_type = self.array_element_type(initializer_type)
                if initializer_type != "any" and element_type == "" {
                    self.has_error = true
                    self.error_msg = "E2048: array destructuring requires Array<T>, found " + initializer_type
                    return
                }
                if element_type == "" { element_type = "any" }
                for i in 0..binding_count-1 {
                    if node.children[i].name != "_" {
                        self.register_symbol(node.children[i].name, element_type)
                    }
                }
                return
            }

            var field_count = self.struct_field_count(node.name)
            if field_count == 0 {
                self.has_error = true
                self.error_msg = "E2049: unknown struct destructuring pattern '" + node.name + "'"
                return
            }
            if initializer_type != "any" and initializer_type != node.name {
                self.has_error = true
                self.error_msg = "E2049: struct destructuring expected " + node.name + " but found " + initializer_type
                return
            }
            if binding_count != field_count {
                self.has_error = true
                self.error_msg = "E2050: struct pattern '" + node.name + "' expected " +
                    to_string(field_count) + " bindings but got " + to_string(binding_count)
                return
            }
            for i in 0..binding_count-1 {
                if node.children[i].name != "_" {
                    self.register_symbol(node.children[i].name, self.struct_field_type_at(node.name, i))
                }
            }
            return
        }

        if node.kind == "Assign" {
            if len(node.children) >= 2 {
                var target_t = self.infer_type(node.children[0])
                var val_t = self.infer_type(node.children[1])
                if not self.is_compatible(target_t, val_t) {
                    self.has_error = true
                    self.error_msg = "Cannot assign type " + val_t + " to " + target_t
                }
            }
            return
        }

        if node.kind == "Import" {
            if node.name != "" {
                var mod_type = "any"
                if node.op != "" {
                    mod_type = "foreign-module::" + node.op + "::" + node.value
                }
                self.register_symbol(node.name, mod_type)
            }
            for i in 0..len(node.generic_args)-1 {
                self.register_symbol(node.generic_args[i], "any")
            }
            return
        }

        if node.kind == "StructDef" {
            for i in 0..len(node.params)-1 {
                self.register_struct_field(node.name, node.params[i].name, node.params[i].type_annot)
            }
            return
        }

        if node.kind == "TypeAlias" {
            self.type_aliases.push(TypeAliasInfo(node.name, node.type_name))
            self.register_symbol(node.name, node.type_name)
            return
        }

        if node.kind == "FunctionDef" {
            var param_types: Array<string> = []
            var defaults: Array<string> = []
            for i in 0..len(node.params)-1 {
                var param_type = node.params[i].type_annot
                if param_type == "" { param_type = "any" }
                param_types.push(param_type)
                defaults.push(node.params[i].default_val)
            }
            var public_return_type = node.type_name
            if node.is_async { public_return_type = "Task<" + node.type_name + ">" }
            self.register_function(node.name, param_types, public_return_type, defaults, node.generic_args)

            var prev_ret = self.current_fn_return_type
            var prev_async = self.current_fn_is_async
            self.current_fn_return_type = node.type_name
            self.current_fn_is_async = node.is_async

            self.enter_scope()
            for i in 0..len(node.params)-1 {
                var param_type = node.params[i].type_annot
                if param_type == "" { param_type = "any" }
                self.register_symbol(node.params[i].name, param_type)
            }

            for i in 0..len(node.children)-1 {
                self.check_statement(node.children[i])
            }
            self.exit_scope()

            self.current_fn_return_type = prev_ret
            self.current_fn_is_async = prev_async
            return
        }

        if node.kind == "Return" {
            var ret_val_type = "void"
            if len(node.children) > 0 and node.children[0].kind != "Null" {
                ret_val_type = self.infer_type(node.children[0])
            }
            if self.current_fn_return_type != "" and self.current_fn_return_type != "void" {
                if not self.is_compatible(self.current_fn_return_type, ret_val_type) {
                    self.has_error = true
                    self.error_msg = "Return type mismatch: expected " + self.current_fn_return_type + " but returned " + ret_val_type
                }
            }
            return
        }

        if node.kind == "If" {
            if len(node.children) > 0 { self.require_bool_condition(node.children[0], "if") }
            self.enter_scope()
            var idx = 1
            while idx < len(node.children) and node.children[idx].kind != "ElifBlock" and node.children[idx].kind != "ElseBlock" {
                self.check_statement(node.children[idx])
                idx = idx + 1
            }
            self.exit_scope()

            while idx < len(node.children) and node.children[idx].kind == "ElifBlock" {
                var branch = node.children[idx]
                if len(branch.children) > 0 { self.require_bool_condition(branch.children[0], "elif") }
                self.enter_scope()
                for i in 1..len(branch.children)-1 {
                    self.check_statement(branch.children[i])
                }
                self.exit_scope()
                idx = idx + 1
            }

            if idx < len(node.children) and node.children[idx].kind == "ElseBlock" {
                self.enter_scope()
                for i in 0..len(node.children[idx].children)-1 {
                    self.check_statement(node.children[idx].children[i])
                }
                self.exit_scope()
            }
            return
        }

        if node.kind == "ConditionalExpr" or node.kind == "MatchExpr" {
            self.infer_type(node)
            return
        }

        if node.kind == "Throw" {
            if len(node.children) > 0 { self.infer_type(node.children[0]) }
            return
        }

        if node.kind == "TryCatch" {
            if len(node.children) > 0 {
                self.enter_scope()
                for i in 0..len(node.children[0].children)-1 {
                    self.check_statement(node.children[0].children[i])
                }
                self.exit_scope()
            }
            if len(node.children) > 1 {
                self.enter_scope()
                self.register_symbol(node.children[1].name, "string")
                for i in 0..len(node.children[1].children)-1 {
                    self.check_statement(node.children[1].children[i])
                }
                self.exit_scope()
            }
            return
        }

        if node.kind == "While" {
            if len(node.children) > 0 { self.require_bool_condition(node.children[0], "while") }
            self.enter_scope()
            for i in 1..len(node.children)-1 {
                self.check_statement(node.children[i])
            }
            self.exit_scope()
            return
        }

        if node.kind == "Guard" {
            if len(node.children) > 0 { self.require_bool_condition(node.children[0], "guard") }
            self.enter_scope()
            for i in 1..len(node.children)-1 {
                self.check_statement(node.children[i])
            }
            self.exit_scope()
            return
        }

        if node.kind == "For" {
            self.enter_scope()
            self.register_symbol(node.name, "int")
            for i in 2..len(node.children)-1 {
                self.check_statement(node.children[i])
            }
            self.exit_scope()
            return
        }

        // Generic expression statement
        self.infer_type(node)
    }

    fn check_program(self, ast: ASTNode) -> bool {
        self.validate_integer_literals(ast)
        self.enter_scope()
        self.register_symbol("print", "void")
        self.register_symbol("to_string", "string")
        self.register_symbol("to_str", "string")
        self.register_symbol("to_int", "int")
        self.register_symbol("addr", "int")
        self.register_symbol("peek", "int")
        self.register_symbol("args", "Array<string>")

        // Foreign aliases are declarations: make them visible while function
        // bodies are checked regardless of where the import appears.
        for i in 0..len(ast.children)-1 {
            if ast.children[i].kind == "Import" {
                self.check_statement(ast.children[i])
            }
        }

        for i in 0..len(ast.children)-1 {
            if ast.children[i].kind != "Import" {
                self.check_statement(ast.children[i])
            }
        }
        return not self.has_error
    }
}
