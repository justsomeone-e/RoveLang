#target cpp
#native include <string>
#native include <vector>

struct Token {
    type_name: string,
    value: string,
    line: int,
    col: int
}

struct FunctionParam {
    name: string,
    type_annot: string,
    default_val: string,
    default_expr: Array<ASTNode>
}

struct ASTNode {
    kind: string,
    name: string,
    value: string,
    op: string,
    type_name: string,
    is_const: bool,
    is_async: bool,
    is_safe: bool,
    is_varargs: bool,
    params: Array<FunctionParam>,
    generic_args: Array<string>,
    children: Array<ASTNode>,
    line: int,
    col: int
}

impl ASTNode {
    fn to_str(self) -> string {
        var res = "(" + self.kind
        if self.name != "" { res = res + " name='" + self.name + "'" }
        if self.value != "" { res = res + " val='" + self.value + "'" }
        if self.op != "" { res = res + " op='" + self.op + "'" }
        if self.type_name != "" { res = res + " type='" + self.type_name + "'" }
        if self.is_const { res = res + " const=true" }
        if self.is_async { res = res + " async=true" }
        
        if self.kind == "EnumDef" and len(self.generic_args) > 0 {
            res = res + " params=["
            for i in 0..len(self.generic_args)-1 {
                if i > 0 { res = res + ", " }
                res = res + self.generic_args[i]
            }
            res = res + "]"
        } elif self.kind == "EnumMember" and self.is_safe {
            res = res + " params=["
            for i in 0..len(self.params)-1 {
                if i > 0 { res = res + ", " }
                res = res + self.params[i].type_annot
            }
            res = res + "]"
        } elif len(self.params) > 0 {
            res = res + " params=["
            for i in 0..len(self.params)-1 {
                if i > 0 { res = res + ", " }
                res = res + self.params[i].name + ": " + self.params[i].type_annot
            }
            res = res + "]"
        }
        
        if len(self.children) > 0 {
            res = res + " body=["
            for i in 0..len(self.children)-1 {
                if i > 0 { res = res + " " }
                res = res + self.children[i].to_str()
            }
            res = res + "]"
        }
        res = res + ")"
        return res
    }
}

struct Parser {
    tokens: Array<Token>,
    pos: int,
    has_error: bool,
    error_msg: string,
    last_doc_comment: string
}

impl Parser {
    fn current(self) -> Token {
        if self.pos >= len(self.tokens) {
            return Token("EOF", "EOF", 0, 0)
        }
        return self.tokens[self.pos]
    }

    fn peek_ahead(self, offset: int) -> Token {
        var idx = self.pos + offset
        if idx >= len(self.tokens) {
            return Token("EOF", "EOF", 0, 0)
        }
        return self.tokens[idx]
    }

    fn advance(self) -> Token {
        var tok = self.current()
        if self.pos < len(self.tokens) {
            self.pos = self.pos + 1
        }
        return tok
    }

    fn match_type(self, tt: string) -> bool {
        if self.current().type_name == tt {
            self.advance()
            return true
        }
        return false
    }

    fn expect(self, tt: string) -> Token {
        var tok = self.current()
        if tok.type_name == tt {
            return self.advance()
        }
        self.has_error = true
        self.error_msg = "Expected token " + tt + " but found " + tok.type_name + " at line " + to_string(tok.line) + ":" + to_string(tok.col)
        return self.advance()
    }

    fn expect_type_gt(self) -> Token {
        var tok = self.current()
        if tok.type_name == "SHR" {
            self.tokens[self.pos] = Token("GT", ">", tok.line, tok.col + 1)
            return Token("GT", ">", tok.line, tok.col)
        }
        return self.expect("GT")
    }

    fn is_name_token(self, tok: Token) -> bool {
        if len(tok.value) == 0 { return false }
        var first = tok.value[0]
        if not ((first >= "a" and first <= "z") or (first >= "A" and first <= "Z") or first == "_") {
            return false
        }
        for i in 1..len(tok.value)-1 {
            var ch = tok.value[i]
            if not ((ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or
                (ch >= "0" and ch <= "9") or ch == "_") {
                return false
            }
        }
        return true
    }

    fn expect_name(self) -> Token {
        var tok = self.current()
        if self.is_name_token(tok) { return self.advance() }
        self.has_error = true
        self.error_msg = "Expected a member name but found " + tok.type_name +
            " at line " + to_string(tok.line) + ":" + to_string(tok.col)
        return self.advance()
    }

    fn parse_type(self) -> string {
        var is_ptr = false
        if self.match_type("MUL") { is_ptr = true }

        if self.match_type("FN") {
            self.expect("LPAREN")
            var rendered = "fn("
            var count = 0
            while self.current().type_name != "RPAREN" and self.current().type_name != "EOF" {
                if count > 0 { rendered = rendered + ", " }
                rendered = rendered + self.parse_type()
                count = count + 1
                if not self.match_type("COMMA") { break }
            }
            self.expect("RPAREN")
            var result_type = "void"
            if self.match_type("ARROW") { result_type = self.parse_type() }
            rendered = rendered + ") -> " + result_type
            if self.match_type("QUESTION") { rendered = rendered + "?" }
            return rendered
        }

        var name = self.expect("IDENT").value
        if self.match_type("LT") {
            var rendered_args = ""
            var count = 0
            while self.current().type_name != "GT" and self.current().type_name != "SHR" and self.current().type_name != "EOF" {
                if count > 0 { rendered_args = rendered_args + ", " }
                if self.current().type_name == "NUMBER" {
                    rendered_args = rendered_args + self.advance().value
                } else {
                    rendered_args = rendered_args + self.parse_type()
                }
                count = count + 1
                if not self.match_type("COMMA") { break }
            }
            self.expect_type_gt()
            name = name + "<" + rendered_args + ">"
        }
        if is_ptr { name = "*" + name }
        if self.match_type("QUESTION") { name = name + "?" }
        return name
    }

    fn parse_block(self) -> Array<ASTNode> {
        var body: Array<ASTNode> = []
        if self.match_type("LBRACE") {
            var closed = false
            while self.current().type_name != "EOF" {
                if self.match_type("RBRACE") { closed = true; break }
                while self.match_type("SEMICOLON") { }
                if self.current().type_name == "RBRACE" { continue }
                if self.current().type_name == "DOC_COMMENT" {
                    self.last_doc_comment = self.advance().value
                    continue
                }
                body.push(self.parse_statement())
                self.last_doc_comment = ""
            }
            if not closed {
                self.has_error = true
                self.error_msg = "Unclosed block: expected '}'"
            }
        } elif self.match_type("COLON") {
            body.push(self.parse_statement())
        }
        return body
    }

    fn parse_value_block(self, context: string) -> ASTNode {
        if not self.match_type("LBRACE") {
            self.has_error = true
            self.error_msg = "Expected '{' for " + context
            return ASTNode("Unknown", "", "", "", "", false, false, false,
                false, [], [], [], self.current().line, self.current().col)
        }
        var value = self.parse_expr(0)
        while self.match_type("SEMICOLON") { }
        if not self.match_type("RBRACE") {
            self.has_error = true
            self.error_msg = context + " accepts exactly one value expression"
        }
        return value
    }

    fn parse_conditional_expression(self) -> ASTNode {
        var tok = self.expect("IF")
        var condition = self.parse_expr(0)
        var then_expr = self.parse_value_block("if expression")
        var children: Array<ASTNode> = [condition, then_expr]
        while true {
            if self.match_type("ELIF") {
                var branch_condition = self.parse_expr(0)
                var branch_expr = self.parse_value_block("elif expression")
                children.push(ASTNode("ConditionalBranch", "", "", "", "", false,
                    false, false, false, [], [], [branch_condition, branch_expr],
                    branch_condition.line, branch_condition.col))
                continue
            }
            if self.match_type("ELSE") {
                if self.match_type("IF") {
                    var branch_condition = self.parse_expr(0)
                    var branch_expr = self.parse_value_block("else-if expression")
                    children.push(ASTNode("ConditionalBranch", "", "", "", "", false,
                        false, false, false, [], [], [branch_condition, branch_expr],
                        branch_condition.line, branch_condition.col))
                    continue
                }
                children.push(self.parse_value_block("else expression"))
                return ASTNode("ConditionalExpr", "", "", "", "", false, false,
                    false, false, [], [], children, tok.line, tok.col)
            }
            self.has_error = true
            self.error_msg = "Value-producing if expression requires an else branch"
            return ASTNode("ConditionalExpr", "", "", "", "", false, false,
                false, false, [], [], children, tok.line, tok.col)
        }
        return ASTNode("ConditionalExpr", "", "", "", "", false, false,
            false, false, [], [], children, tok.line, tok.col)
    }

    fn parse_match_expression(self) -> ASTNode {
        var tok = self.expect("MATCH")
        var subject = self.parse_expr(0)
        if not self.match_type("LBRACE") {
            self.has_error = true
            self.error_msg = "Expected '{' after match expression subject"
        }
        var children: Array<ASTNode> = [subject]
        var closed = false
        while self.current().type_name != "EOF" {
            if self.match_type("RBRACE") {
                closed = true
                break
            }
            var pattern = ASTNode("Unknown", "", "", "", "", false, false,
                false, false, [], [], [], self.current().line, self.current().col)
            if self.current().type_name == "IDENT" {
                var identifier = self.advance()
                pattern = ASTNode("Identifier", identifier.value, "", "", "", false, false,
                    false, false, [], [], [], identifier.line, identifier.col)
            } else {
                pattern = self.parse_expr(0)
            }
            self.expect("FAT_ARROW")
            var value = ASTNode("Unknown", "", "", "", "", false, false,
                false, false, [], [], [], pattern.line, pattern.col)
            if self.current().type_name == "LBRACE" {
                value = self.parse_value_block("match expression arm")
            } else {
                value = self.parse_expr(0)
            }
            children.push(ASTNode("MatchExprCase", "", "", "", "", false,
                false, false, false, [], [], [pattern, value], pattern.line, pattern.col))
            if self.match_type("COMMA") { continue }
            if self.current().type_name != "RBRACE" {
                self.has_error = true
                self.error_msg = "Match expression arms must be comma-separated"
                break
            }
        }
        if not closed and self.match_type("RBRACE") { closed = true }
        if not closed {
            self.has_error = true
            self.error_msg = "Unclosed match expression: expected '}'"
        }
        return ASTNode("MatchExpr", "", "", "", "", false, false,
            false, false, [], [], children, tok.line, tok.col)
    }

    fn parse_primary(self) -> ASTNode {
        var tok = self.current()

        if tok.type_name == "MATCH" { return self.parse_match_expression() }
        if tok.type_name == "IF" { return self.parse_conditional_expression() }

        if tok.type_name == "NUMBER" {
            self.advance()
            return ASTNode("Number", "", tok.value, "", "int", false, false, false, false, [], [], [], tok.line, tok.col)
        }

        if tok.type_name == "STRING" {
            self.advance()
            return ASTNode("String", "", tok.value, "", "string", false, false, false, false, [], [], [], tok.line, tok.col)
        }

        if tok.type_name == "BOOLEAN" {
            self.advance()
            return ASTNode("Boolean", "", tok.value, "", "bool", false, false, false, false, [], [], [], tok.line, tok.col)
        }

        if tok.type_name == "NULL" {
            self.advance()
            return ASTNode("Null", "", "null", "", "null", false, false, false, false, [], [], [], tok.line, tok.col)
        }

        if tok.type_name == "IDENT" {
            var name = self.advance().value
            if self.match_type("FAT_ARROW") {
                var body = self.parse_expr(0)
                return ASTNode("Lambda", "", "", "", "", false, false, false, false,
                    [FunctionParam(name, "", "", [])], [], [body], tok.line, tok.col)
            }
            return ASTNode("Identifier", name, "", "", "", false, false, false, false, [], [], [], tok.line, tok.col)
        }

        if tok.type_name == "PRINT" or tok.type_name == "INPUT" or tok.type_name == "ADDR" or
            tok.type_name == "PEEK" or tok.type_name == "MEMDUMP" or tok.type_name == "CHANNEL" {
            var callee = self.advance().value
            var generic_args: Array<string> = []
            if self.match_type("LT") {
                generic_args.push(self.parse_type())
                self.expect_type_gt()
            }
            self.expect("LPAREN")
            var args: Array<ASTNode> = []
            if not self.match_type("RPAREN") {
                while true {
                    args.push(self.parse_expr(0))
                    if self.match_type("COMMA") { continue }
                    self.expect("RPAREN")
                    break
                }
            }
            return ASTNode("FunctionCall", callee, "", "", "", false, false, false, false, [], generic_args, args, tok.line, tok.col)
        }

        if self.match_type("LPAREN") {
            if self.match_type("RPAREN") {
                if self.match_type("FAT_ARROW") {
                    var body = self.parse_expr(0)
                    return ASTNode("Lambda", "", "", "", "", false, false, false, false,
                        [], [], [body], tok.line, tok.col)
                }
                return ASTNode("Null", "", "null", "", "null", false, false, false, false,
                    [], [], [], tok.line, tok.col)
            }
            var expr = self.parse_expr(0)
            if self.current().type_name == "COMMA" {
                var lambda_params: Array<FunctionParam> = []
                if expr.kind != "Identifier" {
                    self.has_error = true
                    self.error_msg = "Lambda parameters must be identifiers"
                } else {
                    lambda_params.push(FunctionParam(expr.name, "", "", []))
                }
                while self.match_type("COMMA") {
                    lambda_params.push(FunctionParam(self.expect("IDENT").value, "", "", []))
                }
                self.expect("RPAREN")
                self.expect("FAT_ARROW")
                var body = self.parse_expr(0)
                return ASTNode("Lambda", "", "", "", "", false, false, false, false,
                    lambda_params, [], [body], tok.line, tok.col)
            }
            self.expect("RPAREN")
            if expr.kind == "Identifier" and self.match_type("FAT_ARROW") {
                var body = self.parse_expr(0)
                return ASTNode("Lambda", "", "", "", "", false, false, false, false,
                    [FunctionParam(expr.name, "", "", [])], [], [body], tok.line, tok.col)
            }
            return expr
        }

        if self.match_type("LBRACKET") {
            var elems: Array<ASTNode> = []
            if not self.match_type("RBRACKET") {
                while true {
                    elems.push(self.parse_expr(0))
                    if self.match_type("COMMA") { continue }
                    self.expect("RBRACKET")
                    break
                }
            }
            return ASTNode("Array", "", "", "", "", false, false, false, false, [], [], elems, tok.line, tok.col)
        }

        self.has_error = true
        self.error_msg = "Unexpected token in expression: " + tok.type_name + " ('" + tok.value + "') at line " + to_string(tok.line) + ":" + to_string(tok.col)
        self.advance()
        return ASTNode("Unknown", "", "", "", "", false, false, false, false, [], [], [], tok.line, tok.col)
    }

    fn parse_postfix(self) -> ASTNode {
        var node = self.parse_primary()

        while true {
            if self.match_type("SAFE_NAV") {
                var member_tok = self.expect_name()
                node = ASTNode("MemberAccess", member_tok.value, "", "", "", false, false, true, false,
                    [], [], [node], member_tok.line, member_tok.col)
            } elif self.match_type("DOT") {
                var member_tok = self.expect_name()
                var member = member_tok.value
                if self.match_type("LPAREN") {
                    var args: Array<ASTNode> = []
                    if not self.match_type("RPAREN") {
                        while true {
                            args.push(self.parse_expr(0))
                            if self.match_type("COMMA") { continue }
                            self.expect("RPAREN")
                            break
                        }
                    }
                    var call_node = ASTNode("MethodCall", member, "", "", "", false, false, false, false, [], [], args, member_tok.line, member_tok.col)
                    node = ASTNode("MemberAccess", member, "", "", "", false, false, false, false, [], [], [node, call_node], member_tok.line, member_tok.col)
                } else {
                    node = ASTNode("MemberAccess", member, "", "", "", false, false, false, false, [], [], [node], member_tok.line, member_tok.col)
                }
            } elif self.current().type_name == "LBRACKET" {
                var bracket_tok = self.advance()
                var idx = self.parse_expr(0)
                self.expect("RBRACKET")
                node = ASTNode("IndexAccess", "", "", "", "", false, false, false, false, [], [], [node, idx], bracket_tok.line, bracket_tok.col)
            } elif self.match_type("LPAREN") {
                var args: Array<ASTNode> = []
                if not self.match_type("RPAREN") {
                    while true {
                        args.push(self.parse_expr(0))
                        if self.match_type("COMMA") { continue }
                        self.expect("RPAREN")
                        break
                    }
                }
                node = ASTNode("FunctionCall", node.name, "", "", "", false, false, false, false, [], [], args, node.line, node.col)
            } elif self.current().type_name == "QUESTION" {
                var question = self.advance()
                node = ASTNode("ResultPropagate", "", "", "", "", false, false, false,
                    false, [], [], [node], question.line, question.col)
            } else {
                break
            }
        }
        return node
    }

    fn parse_unary(self) -> ASTNode {
        var tok = self.current()
        if tok.type_name == "AWAIT" {
            self.advance()
            var expr = self.parse_unary()
            return ASTNode("Await", "", "", "", "", false, false, false,
                false, [], [], [expr], tok.line, tok.col)
        }
        if tok.type_name == "PLUS" or tok.type_name == "MINUS" or tok.type_name == "NOT" or
            tok.type_name == "MUL" or tok.type_name == "BIT_NOT" {
            self.advance()
            var expr = self.parse_unary()
            if tok.type_name == "MINUS" and expr.kind == "Number" and
                expr.value == "9223372036854775808" {
                return ASTNode("Number", "", "-9223372036854775808", "", "int",
                    false, false, false, false, [], [], [], tok.line, tok.col)
            }
            return ASTNode("UnaryOp", "", "", tok.value, "", false, false, false, false, [], [], [expr], tok.line, tok.col)
        }
        return self.parse_postfix()
    }

    fn get_prec(self, op: string) -> int {
        if op == "PIPE" or op == "|>" { return 5 }
        if op == "NULL_COALESCE" or op == "??" { return 10 }
        if op == "OR" or op == "or" { return 20 }
        if op == "AND" or op == "and" { return 30 }
        if op == "BIT_OR" or op == "|" { return 40 }
        if op == "BIT_XOR" or op == "^" { return 50 }
        if op == "BIT_AND" or op == "&" { return 60 }
        if op == "EQ" or op == "NEQ" or op == "==" or op == "!=" { return 70 }
        if op == "LT" or op == "GT" or op == "LTE" or op == "GTE" or op == "<" or op == ">" or op == "<=" or op == ">=" { return 80 }
        if op == "SHL" or op == "SHR" or op == "<<" or op == ">>" { return 90 }
        if op == "PLUS" or op == "MINUS" or op == "+" or op == "-" { return 100 }
        if op == "MUL" or op == "DIV" or op == "MOD" or op == "*" or op == "/" or op == "%" { return 110 }
        return 0
    }

    fn parse_expr(self, min_prec: int) -> ASTNode {
        var left = self.parse_unary()

        while true {
            var tok = self.current()
            var prec = self.get_prec(tok.type_name)
            if prec <= min_prec {
                break
            }
            self.advance()

            if tok.type_name == "PIPE" {
                var callee_tok = self.current()
                if self.is_name_token(callee_tok) {
                    self.advance()
                    var callee_name = callee_tok.value
                    var receiver = ASTNode("Identifier", callee_name, "", "", "", false, false,
                        false, false, [], [], [], callee_tok.line, callee_tok.col)
                    var has_member = false
                    var member_tok = callee_tok
                    while self.match_type("DOT") {
                        member_tok = self.expect_name()
                        callee_name = member_tok.value
                        has_member = true
                        if self.current().type_name == "DOT" {
                            receiver = ASTNode("MemberAccess", callee_name, "", "", "", false,
                                false, false, false, [], [], [receiver], member_tok.line, member_tok.col)
                        }
                    }
                    var args: Array<ASTNode> = [left]
                    if self.match_type("LPAREN") {
                        if not self.match_type("RPAREN") {
                            while true {
                                args.push(self.parse_expr(0))
                                if self.match_type("COMMA") { continue }
                                self.expect("RPAREN")
                                break
                            }
                        }
                    }
                    if has_member {
                        var method = ASTNode("MethodCall", callee_name, "", "", "", false,
                            false, false, false, [], [], args, member_tok.line, member_tok.col)
                        left = ASTNode("MemberAccess", callee_name, "", "", "", false, false,
                            false, false, [], [], [receiver, method], member_tok.line, member_tok.col)
                    } else {
                        left = ASTNode("FunctionCall", callee_name, "", "", "", false, false,
                            false, false, [], [], args, callee_tok.line, callee_tok.col)
                    }
                    continue
                }
            }

            var right = self.parse_expr(prec)
            if tok.type_name == "NULL_COALESCE" {
                left = ASTNode("NullCoalesce", "", "", "??", "", false, false, false,
                    false, [], [], [left, right], tok.line, tok.col)
            } else {
                left = ASTNode("BinaryOp", "", "", tok.value, "", false, false, false,
                    false, [], [], [left, right], tok.line, tok.col)
            }
        }
        return left
    }

    fn parse_statement(self) -> ASTNode {
        var tok = self.current()

        // Directives
        if tok.type_name == "TARGET" {
            self.advance()
            self.match_type("SEMICOLON")
            return ASTNode("Directive", "target", tok.value, "", "", false, false, false, false, [], [], [], tok.line, tok.col)
        }
        if tok.type_name == "NATIVE_INCLUDE" {
            self.advance()
            self.match_type("SEMICOLON")
            return ASTNode("Directive", "native_include", tok.value, "", "", false, false, false, false, [], [], [], tok.line, tok.col)
        }
        if tok.type_name == "NATIVE_LINK" {
            self.advance()
            self.match_type("SEMICOLON")
            return ASTNode("Directive", "native_link", tok.value, "", "", false, false, false, false, [], [], [], tok.line, tok.col)
        }
        if tok.type_name == "NATIVE_USE" {
            self.advance()
            self.match_type("SEMICOLON")
            return ASTNode("Directive", "native_use", tok.value, "", "", false, false, false, false, [], [], [], tok.line, tok.col)
        }
        if tok.type_name == "NATIVE_RAW" {
            self.advance()
            self.match_type("SEMICOLON")
            return ASTNode("Directive", "native_raw", tok.value, "", "", false, false, false, false, [], [], [], tok.line, tok.col)
        }

        // Imports are retained in the self-host AST for the native module
        // graph driver. HIR lowering skips them after resolution.
        if tok.type_name == "IMPORT" or tok.type_name == "USE" {
            self.advance()
            var ecosystem = ""
            var import_source = ""
            if self.current().type_name == "IDENT" and
                (self.current().value == "cpp" or self.current().value == "js" or
                 self.current().value == "python" or self.current().value == "rust" or
                 self.current().value == "wasm") {
                ecosystem = self.advance().value
            }
            var symbols: Array<string> = []
            if self.match_type("LBRACE") {
                while self.current().type_name != "RBRACE" and self.current().type_name != "EOF" {
                    symbols.push(self.expect("IDENT").value)
                    if not self.match_type("COMMA") { break }
                }
                self.expect("RBRACE")
                self.expect("FROM")
            }
            var path_tok = self.expect("STRING")
            if ecosystem != "" and self.match_type("FROM") {
                import_source = self.expect("STRING").value
            }
            var alias = ""
            if self.match_type("AS") { alias = self.expect("IDENT").value }
            if ecosystem != "" and alias == "" {
                self.has_error = true
                self.error_msg = "Foreign imports require an explicit alias at line " +
                    to_string(tok.line) + ":" + to_string(tok.col)
            }
            self.match_type("SEMICOLON")
            return ASTNode("Import", alias, path_tok.value, ecosystem, import_source, false, false, false,
                false, [], symbols, [], tok.line, tok.col)
        }

        // Explicit reassignment: set target = value
        if tok.type_name == "SET" {
            self.advance()
            var target = self.parse_expr(0)
            self.expect("ASSIGN")
            var value = self.parse_expr(0)
            self.match_type("SEMICOLON")
            return ASTNode("Assign", "", "", "=", "", false, false, false,
                false, [], [], [target, value], tok.line, tok.col)
        }

        // Variable declaration. let and const are immutable bindings.
        if tok.type_name == "VAR" or tok.type_name == "LET" or tok.type_name == "CONST" {
            var is_const = (tok.type_name == "LET" or tok.type_name == "CONST")
            self.advance()

            if self.match_type("LBRACKET") {
                var bindings: Array<ASTNode> = []
                if self.current().type_name == "RBRACKET" {
                    self.has_error = true
                    self.error_msg = "Array destructuring requires at least one binding"
                }
                while self.current().type_name != "RBRACKET" and self.current().type_name != "EOF" {
                    var binding = self.expect("IDENT")
                    bindings.push(ASTNode("Identifier", binding.value, "", "", "", false,
                        false, false, false, [], [], [], binding.line, binding.col))
                    if not self.match_type("COMMA") { break }
                }
                self.expect("RBRACKET")
                self.expect("ASSIGN")
                var init_expr = self.parse_expr(0)
                bindings.push(init_expr)
                self.match_type("SEMICOLON")
                return ASTNode("DestructureDecl", "", "array", "", "", is_const,
                    false, false, false, [], [], bindings, tok.line, tok.col)
            }

            var name = self.expect("IDENT").value
            if self.match_type("LPAREN") {
                var bindings: Array<ASTNode> = []
                if self.current().type_name == "RPAREN" {
                    self.has_error = true
                    self.error_msg = "Struct destructuring requires at least one binding"
                }
                while self.current().type_name != "RPAREN" and self.current().type_name != "EOF" {
                    var binding = self.expect("IDENT")
                    bindings.push(ASTNode("Identifier", binding.value, "", "", "", false,
                        false, false, false, [], [], [], binding.line, binding.col))
                    if not self.match_type("COMMA") { break }
                }
                self.expect("RPAREN")
                self.expect("ASSIGN")
                var init_expr = self.parse_expr(0)
                bindings.push(init_expr)
                self.match_type("SEMICOLON")
                return ASTNode("DestructureDecl", name, "struct", "", "", is_const,
                    false, false, false, [], [], bindings, tok.line, tok.col)
            }

            var type_annot = ""
            if self.match_type("COLON") {
                type_annot = self.parse_type()
            }
            var init_expr = ASTNode("Null", "", "", "", "", false, false, false, false, [], [], [], tok.line, tok.col)
            if self.match_type("ASSIGN") {
                init_expr = self.parse_expr(0)
            } else {
                if self.current().type_name != "SEMICOLON" {
                    self.has_error = true
                    self.error_msg = "Expected '=' after variable name at line " + to_string(tok.line) + ":" + to_string(tok.col)
                }
            }
            self.match_type("SEMICOLON")
            return ASTNode("VarDecl", name, "", "", type_annot, is_const, false, false, false, [], [], [init_expr], tok.line, tok.col)
        }

        // Type alias
        if tok.type_name == "TYPE_ALIAS" {
            self.advance()
            var alias_name = self.expect("IDENT").value
            self.expect("ASSIGN")
            var actual_type = self.parse_type()
            self.match_type("SEMICOLON")
            return ASTNode("TypeAlias", alias_name, "", "", actual_type, false, false,
                false, false, [], [], [], tok.line, tok.col)
        }

        // Enum definition
        if tok.type_name == "ENUM" {
            self.advance()
            var enum_name = self.expect("IDENT").value
            var generic_params: Array<string> = []
            if self.match_type("LT") {
                while self.current().type_name != "GT" and self.current().type_name != "EOF" {
                    generic_params.push(self.expect("IDENT").value)
                    if not self.match_type("COMMA") { break }
                }
                self.expect("GT")
            }
            var members: Array<ASTNode> = []
            if self.match_type("LBRACE") {
                var closed = false
                while self.current().type_name != "EOF" {
                    if self.match_type("RBRACE") { closed = true; break }
                    while self.match_type("COMMA") { }
                    if self.current().type_name == "RBRACE" { continue }
                    var member_tok = self.expect("IDENT")
                    var member_values: Array<ASTNode> = []
                    var payload_types: Array<FunctionParam> = []
                    var is_variant = false
                    if self.match_type("LPAREN") {
                        is_variant = true
                        if not self.match_type("RPAREN") {
                            while true {
                                payload_types.push(FunctionParam("", self.parse_type(), "", []))
                                if self.match_type("RPAREN") { break }
                                self.expect("COMMA")
                            }
                        }
                    } elif self.match_type("ASSIGN") {
                        member_values.push(self.parse_expr(0))
                    }
                    members.push(ASTNode("EnumMember", member_tok.value, "", "", "", false,
                        false, is_variant, false, payload_types, [], member_values, member_tok.line, member_tok.col))
                    if not self.match_type("COMMA") and self.current().type_name != "RBRACE" {
                        self.has_error = true
                        self.error_msg = "Expected ',' between enum members at line " +
                            to_string(self.current().line) + ":" + to_string(self.current().col)
                    }
                }
                if not closed {
                    self.has_error = true
                    self.error_msg = "Unclosed enum definition block: expected '}'"
                }
            }
            return ASTNode("EnumDef", enum_name, "", "", "", false, false, false,
                false, [], generic_params, members, tok.line, tok.col)
        }

        // Function definition
        if tok.type_name == "FN" or tok.type_name == "ASYNC" {
            var doc_comment = self.last_doc_comment
            var is_async = false
            if tok.type_name == "ASYNC" {
                is_async = true
                self.advance()
                self.expect("FN")
            } else {
                self.advance()
            }
            var name = self.expect("IDENT").value
            var generic_params: Array<string> = []
            if self.match_type("LT") {
                while self.current().type_name != "GT" and self.current().type_name != "EOF" {
                    generic_params.push(self.expect("IDENT").value)
                    if not self.match_type("COMMA") { break }
                }
                self.expect("GT")
            }
            self.expect("LPAREN")
            var params: Array<FunctionParam> = []
            if not self.match_type("RPAREN") {
                while true {
                    var pname = self.expect("IDENT").value
                    var ptype = ""
                    if self.match_type("COLON") {
                        ptype = self.parse_type()
                    }
                    var default_val = ""
                    var default_expr: Array<ASTNode> = []
                    if self.match_type("ASSIGN") {
                        var expr = self.parse_expr(0)
                        default_val = "1"
                        default_expr = [expr]
                    }
                    params.push(FunctionParam(pname, ptype, default_val, default_expr))
                    if self.match_type("COMMA") { continue }
                    self.expect("RPAREN")
                    break
                }
            }
            var ret_type = "void"
            var has_explicit_return = false
            if self.match_type("ARROW") {
                has_explicit_return = true
                ret_type = self.parse_type()
            }
            var body: Array<ASTNode> = []
            if self.match_type("ASSIGN") {
                var expression = self.parse_expr(0)
                body.push(ASTNode("Return", "", "", "", "", false, false,
                    false, false, [], [], [expression], expression.line, expression.col))
                self.match_type("SEMICOLON")
            } else {
                body = self.parse_block()
            }
            // is_safe is otherwise unused for functions; retain whether the
            // source declared an arrow so HIR can distinguish implicit `any`
            // from an explicit `-> void` without changing AST snapshots.
            return ASTNode("FunctionDef", name, doc_comment, "", ret_type, false,
                is_async, has_explicit_return, false, params, generic_params, body, tok.line, tok.col)
        }

        // Struct definition
        if tok.type_name == "STRUCT" {
            self.advance()
            var name = self.expect("IDENT").value
            var generic_params: Array<string> = []
            if self.match_type("LT") {
                while self.current().type_name != "GT" and self.current().type_name != "EOF" {
                    generic_params.push(self.expect("IDENT").value)
                    if not self.match_type("COMMA") { break }
                }
                self.expect("GT")
            }
            var fields: Array<FunctionParam> = []
            if self.match_type("LBRACE") {
                var closed = false
                while self.current().type_name != "EOF" {
                    if self.match_type("RBRACE") {
                        closed = true
                        break
                    }
                    while self.match_type("COMMA") or self.match_type("SEMICOLON") { }
                    if self.current().type_name == "RBRACE" { continue }
                    var fname = self.expect_name().value
                    var ftype = ""
                    if self.match_type("COLON") { ftype = self.parse_type() }
                    fields.push(FunctionParam(fname, ftype, "", []))
                    while self.match_type("COMMA") or self.match_type("SEMICOLON") { }
                }
                if not closed {
                    self.has_error = true
                    self.error_msg = "Unclosed struct definition block: expected '}'"
                }
            } elif self.match_type("COLON") {
                if self.current().type_name != "EOF" and self.current().type_name != "SEMICOLON" {
                    var fname = self.expect_name().value
                    var ftype = ""
                    if self.match_type("COLON") { ftype = self.parse_type() }
                    fields.push(FunctionParam(fname, ftype, "", []))
                }
            }
            return ASTNode("StructDef", name, self.last_doc_comment, "", "", false, false,
                false, false, fields, generic_params, [], tok.line, tok.col)
        }

        // Impl block
        if tok.type_name == "IMPL" {
            self.advance()
            var first_name = self.expect("IDENT").value
            var trait_name = ""
            var target = first_name
            if self.match_type("FOR") {
                trait_name = first_name
                target = self.expect("IDENT").value
            }
            var methods = self.parse_block()
            return ASTNode("ImplBlock", target, trait_name, "", "", false, false,
                false, false, [], [], methods, tok.line, tok.col)
        }

        // Trait definition
        if tok.type_name == "TRAIT" {
            self.advance()
            var name = self.expect("IDENT").value
            var methods = self.parse_block()
            return ASTNode("TraitDef", name, "", "", "", false, false, false, false, [], [], methods, tok.line, tok.col)
        }

        // Extern C function declaration
        if tok.type_name == "EXTERN" {
            self.advance()
            var abi = self.expect("STRING").value
            self.expect("FN")
            var name = self.expect("IDENT").value
            self.expect("LPAREN")
            var params: Array<FunctionParam> = []
            var is_varargs = false
            if not self.match_type("RPAREN") {
                while true {
                    if self.match_type("DOTDOT") {
                        is_varargs = true
                        self.expect("RPAREN")
                        break
                    }
                    var pname = self.expect("IDENT").value
                    var ptype = ""
                    if self.match_type("COLON") { ptype = self.parse_type() }
                    params.push(FunctionParam(pname, ptype, "", []))
                    if self.match_type("COMMA") { continue }
                    self.expect("RPAREN")
                    break
                }
            }
            var ret_type = "void"
            if self.match_type("ARROW") {
                ret_type = self.parse_type()
            }
            self.match_type("SEMICOLON")
            return ASTNode("ExternFn", name, abi, "", ret_type, false, false, false,
                is_varargs, params, [], [], tok.line, tok.col)
        }

        // In-file test block
        if tok.type_name == "TEST" {
            self.advance()
            var description = self.expect("STRING").value
            var body = self.parse_block()
            return ASTNode("TestBlock", "", description, "", "", false, false,
                false, false, [], [], body, tok.line, tok.col)
        }

        // Assertion
        if tok.type_name == "ASSERT" {
            self.advance()
            self.expect("LPAREN")
            var condition = self.parse_expr(0)
            var message = ""
            if self.match_type("COMMA") { message = self.expect("STRING").value }
            self.expect("RPAREN")
            self.match_type("SEMICOLON")
            return ASTNode("Assert", "", message, "", "", false, false,
                false, false, [], [], [condition], tok.line, tok.col)
        }

        // Try-catch
        if tok.type_name == "TRY" {
            self.advance()
            var try_body = self.parse_block()
            self.expect("CATCH")
            var error_name = "e"
            if self.current().type_name == "IDENT" { error_name = self.advance().value }
            var catch_body = self.parse_block()
            var try_node = ASTNode("TryBlock", "", "", "", "", false, false,
                false, false, [], [], try_body, tok.line, tok.col)
            var catch_node = ASTNode("CatchBlock", error_name, "", "", "", false,
                false, false, false, [], [], catch_body, tok.line, tok.col)
            return ASTNode("TryCatch", error_name, "", "", "", false, false,
                false, false, [], [], [try_node, catch_node], tok.line, tok.col)
        }

        if tok.type_name == "DEFER" {
            self.advance()
            var expr = self.parse_expr(0)
            self.match_type("SEMICOLON")
            return ASTNode("Defer", "", "", "", "", false, false, false,
                false, [], [], [expr], tok.line, tok.col)
        }

        if tok.type_name == "GUARD" {
            self.advance()
            var condition = self.parse_expr(0)
            self.expect("ELSE")
            var else_body = self.parse_block()
            var children: Array<ASTNode> = [condition]
            for statement in else_body { children.push(statement) }
            return ASTNode("Guard", "", "", "", "", false, false, false,
                false, [], [], children, tok.line, tok.col)
        }

        // Standalone lexical block. A dedicated Block node will replace this
        // compatibility representation when the HIR module loader owns scopes.
        if tok.type_name == "LBRACE" {
            var body = self.parse_block()
            return ASTNode("UnsafeBlock", "", "", "", "", false, false,
                false, false, [], [], body, tok.line, tok.col)
        }

        // Return
        if tok.type_name == "RETURN" {
            self.advance()
            var children: Array<ASTNode> = []
            if self.current().type_name != "SEMICOLON" and self.current().type_name != "RBRACE" {
                children.push(self.parse_expr(0))
            }
            self.match_type("SEMICOLON")
            return ASTNode("Return", "", "", "", "", false, false, false,
                false, [], [], children, tok.line, tok.col)
        }

        if tok.type_name == "THROW" {
            self.advance()
            var value = self.parse_expr(0)
            self.match_type("SEMICOLON")
            return ASTNode("Throw", "", "", "", "", false, false, false,
                false, [], [], [value], tok.line, tok.col)
        }

        // Break & Continue
        if tok.type_name == "BREAK" {
            self.advance()
            self.match_type("SEMICOLON")
            return ASTNode("Break", "", "", "", "", false, false, false, false, [], [], [], tok.line, tok.col)
        }
        if tok.type_name == "CONTINUE" {
            self.advance()
            self.match_type("SEMICOLON")
            return ASTNode("Continue", "", "", "", "", false, false, false, false, [], [], [], tok.line, tok.col)
        }

        // If statement
        if tok.type_name == "IF" {
            self.advance()
            var cond = self.parse_expr(0)
            var then_body = self.parse_block()
            var children: Array<ASTNode> = [cond]
            for s in then_body { children.push(s) }

            while true {
                if self.current().type_name == "ELIF" {
                    var elif_tok = self.advance()
                    var elif_cond = self.parse_expr(0)
                    var elif_body = self.parse_block()
                    var elif_children: Array<ASTNode> = [elif_cond]
                    for s in elif_body { elif_children.push(s) }
                    children.push(ASTNode("ElifBlock", "", "", "", "", false, false,
                        false, false, [], [], elif_children, elif_tok.line, elif_tok.col))
                    continue
                }
                if self.match_type("ELSE") {
                    if self.current().type_name == "IF" {
                        var elif_tok = self.advance()
                        var elif_cond = self.parse_expr(0)
                        var elif_body = self.parse_block()
                        var elif_children: Array<ASTNode> = [elif_cond]
                        for s in elif_body { elif_children.push(s) }
                        children.push(ASTNode("ElifBlock", "", "", "", "", false, false,
                            false, false, [], [], elif_children, elif_tok.line, elif_tok.col))
                        continue
                    }
                    var else_body = self.parse_block()
                    var else_node = ASTNode("ElseBlock", "", "", "", "", false, false,
                        false, false, [], [], else_body, tok.line, tok.col)
                    children.push(else_node)
                }
                break
            }
            return ASTNode("If", "", "", "", "", false, false, false, false, [], [], children, tok.line, tok.col)
        }

        // While loop
        if tok.type_name == "WHILE" {
            self.advance()
            var cond = self.parse_expr(0)
            var body = self.parse_block()
            var children: Array<ASTNode> = [cond]
            for s in body { children.push(s) }
            return ASTNode("While", "", "", "", "", false, false, false, false, [], [], children, tok.line, tok.col)
        }

        // For loop
        if tok.type_name == "FOR" {
            self.advance()
            var var_name = self.expect("IDENT").value
            self.expect("IN")
            var range_start = self.parse_expr(0)
            var range_end = ASTNode("Null", "", "", "", "", false, false, false, false, [], [], [], tok.line, tok.col)
            if self.match_type("DOTDOT") {
                range_end = self.parse_expr(0)
            }
            var body = self.parse_block()
            var children: Array<ASTNode> = [range_start, range_end]
            for s in body { children.push(s) }
            return ASTNode("For", var_name, "", "", "", false, false, false, false, [], [], children, tok.line, tok.col)
        }

        // Loop infinite loop
        if tok.type_name == "LOOP" {
            self.advance()
            var body = self.parse_block()
            var condition = ASTNode("Boolean", "", "true", "", "bool", false, false,
                false, false, [], [], [], tok.line, tok.col)
            var children: Array<ASTNode> = [condition]
            for statement in body { children.push(statement) }
            return ASTNode("While", "", "", "", "", false, false, false,
                false, [], [], children, tok.line, tok.col)
        }

        // Unsafe block
        if tok.type_name == "UNSAFE" {
            self.advance()
            var body = self.parse_block()
            return ASTNode("UnsafeBlock", "", "", "", "", false, false, false, false, [], [], body, tok.line, tok.col)
        }

        // Spawn block
        if tok.type_name == "SPAWN" {
            self.advance()
            var body = self.parse_block()
            return ASTNode("Spawn", "", "", "", "", false, false, false, false, [], [], body, tok.line, tok.col)
        }

        // Match statement
        if tok.type_name == "MATCH" {
            self.advance()
            var target = self.parse_expr(0)
            var cases: Array<ASTNode> = []
            if self.match_type("LBRACE") {
                var closed = false
                while self.current().type_name != "EOF" {
                    if self.match_type("RBRACE") {
                        closed = true
                        break
                    }
                    var pattern = self.parse_expr(0)
                    self.expect("FAT_ARROW")
                    var case_body: Array<ASTNode> = []
                    if self.current().type_name == "LBRACE" or self.current().type_name == "COLON" {
                        case_body = self.parse_block()
                    } else {
                        case_body.push(self.parse_statement())
                    }
                    var case_node = ASTNode("MatchCase", "", "", "", "", false, false, false, false, [], [], case_body, pattern.line, pattern.col)
                    cases.push(pattern)
                    cases.push(case_node)
                    self.match_type("COMMA")
                }
                if not closed {
                    self.has_error = true
                    self.error_msg = "Unclosed match block: expected '}'"
                }
            }
            var children: Array<ASTNode> = [target]
            for c in cases { children.push(c) }
            return ASTNode("Match", "", "", "", "", false, false, false, false, [], [], children, tok.line, tok.col)
        }

        // General expression / assignment statement
        var expr = self.parse_expr(0)
        if self.match_type("ARROW") {
            var name = self.expect("IDENT").value
            self.match_type("SEMICOLON")
            return ASTNode("VarDecl", name, "", "", "", false, false, false,
                false, [], [], [expr], tok.line, tok.col)
        }
        if self.match_type("ASSIGN") {
            var val_expr = self.parse_expr(0)
            self.match_type("SEMICOLON")
            return ASTNode("Assign", "", "", "=", "", false, false, false, false, [], [], [expr, val_expr], tok.line, tok.col)
        }
        self.match_type("SEMICOLON")
        return expr
    }

    fn parse_program(self) -> ASTNode {
        var stmts: Array<ASTNode> = []
        while self.current().type_name != "EOF" {
            while self.match_type("SEMICOLON") { }
            if self.current().type_name == "EOF" { break }
            if self.current().type_name == "DOC_COMMENT" {
                self.last_doc_comment = self.advance().value
                continue
            }
            stmts.push(self.parse_statement())
            self.last_doc_comment = ""
        }
        return ASTNode("Program", "main", "", "", "", false, false, false, false, [], [], stmts, 1, 1)
    }
}
